<!doctype html>
<html lang="{{ request.locale.iso_code }}">

<head>

  {% render 'css-variables' %}

  {{ 'theme.css' | asset_url | stylesheet_tag }}



  {% unless settings.type_primary_font.system? %}

    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}

  {% endunless %}



  {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}



 <!-- TITLE -->

{% if template.name == 'index' %}

  <title>
    AGESSENTIAL
  </title>


{% elsif template.name == 'cart' %}

  <title>
    Cart | AGESSENTIALS
  </title>


{% else %}

  <title>
    {{ page_title }} | AGESSENTIALS
  </title>

{% endif %}


  <!-- DESCRIPTION -->

  {% if page_description %}

    <meta name="description" content="{{ page_description | escape }}">

  {% else %}

    <meta name="description" content="AGESSENTIALS offers quality toys, stationery, kids products, educational items and gifts.">

  {% endif %}



  <meta name="keywords" content="AGESSENTIASL, toys, stationery, kids toys, baby products, school supplies, gifts">



  <meta name="viewport" content="width=device-width,initial-scale=1">



  <!-- LOGO AS FAVICON -->

  <link rel="icon" type="image/png" href="{{ 'mylogo.png' | asset_url }}">



  <!-- CANONICAL -->

  <link rel="canonical" href="{{ canonical_url }}">



  <!-- SOCIAL META -->

  <meta property="og:site_name" content="AGESSENTIAL">


  {% if template.name == 'index' %}

    <meta property="og:title" content="AGESSENTIALS">

  {% else %}

    <meta property="og:title" content="{{ page_title }} | AGESSENTIALS">

  {% endif %}



  <meta property="og:description" content="Shop quality toys, stationery, baby products and gifts at AGESSENTIALS.">



  <meta property="og:image" content="{{ 'mylogo.png' | asset_url }}">



  <meta property="og:type" content="website">


  <meta property="og:url" content="{{ canonical_url }}">



  <!-- SHOPIFY DEFAULT META -->

  {% render 'meta-tags' %}



  {{ content_for_header }}


</head>



<body>


  {% sections 'header-group' %}



  <main id="MainContent">

    {{ content_for_layout }}

  </main>



  {% sections 'footer-group' %}



</body>


</html>