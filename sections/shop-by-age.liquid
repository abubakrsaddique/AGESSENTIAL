<section class="shop-age-section">

  <div class="shop-age-container">

    <div class="shop-age-heading">
<!--
      <span class="shop-age-eyebrow">
        FIND THEIR FAVORITES
      </span>
-->
      <h2 class="shop-age-title">
        Shop For Every Little One
      </h2>

      <p class="shop-age-subtitle">
        Discover toys made for curious minds, creative hearts and big little adventures.
      </p>

    </div>


    <div class="shop-age-grid">


      <!-- BABIES -->

      <a href="/pages/babies" class="age-card age-card--baby">

        <div class="age-image-wrapper">

          <img
            src="{{ 'baby.png' | asset_url }}"
            alt="Baby toys"
            loading="lazy"
          >

          <div class="age-image-overlay"></div>

          <span class="age-small-label">
            0–2 YEARS
          </span>

        </div>


        <div class="age-content">

          <div class="age-text">

            <h3>
              Babies
            </h3>

            <p>
              Toys for little explorers
            </p>

          </div>


          <span class="arrow">

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M5 12h13M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

          </span>

        </div>

      </a>



      <!-- BOYS -->

      <a href="/pages/boys" class="age-card age-card--boy">

        <div class="age-image-wrapper">

          <img
            src="{{ 'boy.png' | asset_url }}"
            alt="Boys toys"
            loading="lazy"
          >

          <div class="age-image-overlay"></div>

          <span class="age-small-label">
            3–8 YEARS
          </span>

        </div>


        <div class="age-content">

          <div class="age-text">

            <h3>
              Boys
            </h3>

            <p>
              Toys for every adventure
            </p>

          </div>


          <span class="arrow">

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M5 12h13M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

          </span>

        </div>

      </a>



      <!-- GIRLS -->

      <a href="/pages/girls" class="age-card age-card--girl">

        <div class="age-image-wrapper">

          <img
            src="{{ 'girl.png' | asset_url }}"
            alt="Girls toys"
            loading="lazy"
          >

          <div class="age-image-overlay"></div>

          <span class="age-small-label">
            3–8 YEARS
          </span>

        </div>


        <div class="age-content">

          <div class="age-text">

            <h3>
              Girls
            </h3>

            <p>
              Toys for bright little dreams
            </p>

          </div>


          <span class="arrow">

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M5 12h13M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

          </span>

        </div>

      </a>


    </div>

<!--
    <div class="shop-age-bottom">

      <span>
        ✦ Carefully selected for little moments of joy
      </span>

    </div>

  </div>
-->
</section>


{% stylesheet %}

  /* ========================================
     MAIN SECTION
  ======================================== */

  .shop-age-section {

    width: 99.4vw;

    position: relative;

    left: 50%;
    right: 50%;

    margin-left: -50vw;
    margin-right: -50vw;

    background: #fbf8f3;

    overflow: hidden;

  }


  .shop-age-container {

    width: 100%;

    max-width: 1380px;

    margin: 0 auto;

    padding: 90px 40px 85px;

    box-sizing: border-box;

  }


  /* ========================================
     HEADING
  ======================================== */

  .shop-age-heading {

    max-width: 720px;

    margin: 0 auto 48px;

    text-align: center;

  }


  .shop-age-eyebrow {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 8px 15px;

    margin-bottom: 17px;

    border-radius: 50px;

    background: #ffffff;

    border: 1px solid #ebe5dc;

    color: #8a765f;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1.8px;

  }


  .shop-age-title {

    margin: 0;

    color: #222222;

    font-size: clamp(38px, 4vw, 58px);

    line-height: 1.05;

    letter-spacing: -2px;

    font-weight: 800;

  }


  .shop-age-subtitle {

    max-width: 600px;

    margin: 18px auto 0;

    color: #6f6369;

    font-size: 17px;

    line-height: 1.7;

  }


  /* ========================================
     GRID
  ======================================== */

  .shop-age-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 24px;

  }


  /* ========================================
     CARD
  ======================================== */

  .age-card {

    position: relative;

    display: block;

    min-width: 0;

    text-decoration: none;

    border-radius: 28px;

    overflow: hidden;

    background: #ffffff;

    box-shadow:
      0 8px 30px rgba(43, 35, 25, .07);

    transition:
      transform .35s ease,
      box-shadow .35s ease;

  }


  .age-card:hover {

    transform: translateY(-7px);

    box-shadow:
      0 20px 45px rgba(43, 35, 25, .14);

  }


  /* ========================================
     IMAGE
  ======================================== */

  .age-image-wrapper {

    position: relative;

    width: 100%;

    height: 430px;

    overflow: hidden;

    background: #eee;

  }


  .age-image-wrapper img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    transition:
      transform .65s cubic-bezier(.2,.7,.2,1);

  }


  .age-card:hover .age-image-wrapper img {

    transform: scale(1.055);

  }


  /* ========================================
     IMAGE GRADIENT
  ======================================== */

  .age-image-overlay {

    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        to bottom,
        rgba(0,0,0,0) 45%,
        rgba(0,0,0,.08) 70%,
        rgba(0,0,0,.42) 100%
      );

    pointer-events: none;

  }


  /* ========================================
     AGE LABEL
  ======================================== */

  .age-small-label {

    position: absolute;

    top: 18px;

    left: 18px;

    padding: 8px 12px;

    border-radius: 50px;

    background: rgba(224, 27, 188, 0.9);

    backdrop-filter: blur(10px);

    color: #f6f4f4;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1px;

  }


  /* ========================================
     CONTENT CARD
  ======================================== */

  .age-content {

    position: absolute;

    left: 16px;
    right: 16px;
    bottom: 16px;

    min-height: 82px;

    padding: 15px 16px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    border-radius: 20px;

    background: rgba(255,255,255,.94);

    backdrop-filter: blur(15px);

    -webkit-backdrop-filter: blur(15px);

    box-shadow:
      0 8px 25px rgba(0,0,0,.12);

    box-sizing: border-box;

  }


  .age-text {

    min-width: 0;

  }


  .age-content h3 {

    margin: 0;

    font-size: 25px;

    line-height: 1.1;

    font-weight: 800;

    letter-spacing: -.5px;

  }


  .age-content p {

    margin: 6px 0 0;

    color: #6c6c6c;

    font-size: 13px;

    line-height: 1.3;

  }


  /* ========================================
     CARD COLORS
  ======================================== */

  .age-card--baby .age-content h3 {

    color: #168f68;

  }


  .age-card--boy .age-content h3 {

    color: #2678d9;

  }


  .age-card--girl .age-content h3 {

    color: #e75b8d;

  }


  /* ========================================
     ARROW
  ======================================== */

  .arrow {

    flex: 0 0 auto;

    width: 44px;

    height: 44px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    color: #ffffff;

    transition:
      transform .3s ease;

  }


  .age-card--baby .arrow {

    background: #168f68;

  }


  .age-card--boy .arrow {

    background: #2678d9;

  }


  .age-card--girl .arrow {

    background: #e75b8d;

  }


  .arrow svg {

    width: 19px;

    height: 19px;

    transition:
      transform .3s ease;

  }


  .age-card:hover .arrow {

    transform: scale(1.08);

  }


  .age-card:hover .arrow svg {

    transform: translateX(2px);

  }


  /* ========================================
     BOTTOM TEXT
  ======================================== */

  .shop-age-bottom {

    margin-top: 30px;

    text-align: center;

    color: #9a9186;

    font-size: 12px;

    letter-spacing: .4px;

  }


  /* ========================================
     TABLET
  ======================================== */

  @media screen and (max-width: 990px) {

    .shop-age-container {

      padding: 70px 25px;

    }


    .shop-age-grid {

      grid-template-columns: repeat(2, 1fr);

    }


    .age-card:last-child {

      grid-column: span 2;

      max-width: calc(50% - 12px);

      width: 100%;

      margin: 0 auto;

    }


    .age-image-wrapper {

      height: 380px;

    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media screen and (max-width: 700px) {

    .shop-age-container {

      padding: 58px 16px 60px;

    }


    .shop-age-heading {

      margin-bottom: 30px;

    }


    .shop-age-eyebrow {

      font-size: 9px;

      letter-spacing: 1.4px;

      padding: 7px 12px;

    }


    .shop-age-title {

      font-size: 34px;

      line-height: 1.08;

      letter-spacing: -1.2px;

    }


    .shop-age-subtitle {

      margin-top: 13px;

      font-size: 14px;

      line-height: 1.6;

    }


    /* Horizontal mobile carousel */

    .shop-age-grid {

      display: flex;

      overflow-x: auto;

      gap: 15px;

      padding: 5px 2px 18px;

      margin-right: -16px;

      padding-right: 16px;

      scrollbar-width: none;

      scroll-snap-type: x mandatory;

    }


    .shop-age-grid::-webkit-scrollbar {

      display: none;

    }


    .age-card {

      flex: 0 0 84%;

      max-width: none;

      scroll-snap-align: start;

      border-radius: 23px;

    }


    .age-card:last-child {

      grid-column: auto;

      width: auto;

      margin: 0;

    }


    .age-image-wrapper {

      height: 350px;

    }


    .age-content {

      left: 12px;

      right: 12px;

      bottom: 12px;

      min-height: 72px;

      padding: 12px 13px;

      border-radius: 17px;

    }


    .age-content h3 {

      font-size: 22px;

    }


    .age-content p {

      font-size: 12px;

      margin-top: 4px;

    }


    .age-small-label {

      top: 13px;

      left: 13px;

      padding: 7px 10px;

      font-size: 9px;

    }


    .arrow {

      width: 40px;

      height: 40px;

    }


    .arrow svg {

      width: 17px;

      height: 17px;

    }


    .shop-age-bottom {

      font-size: 11px;

      margin-top: 17px;

    }

  }


  /* ========================================
     SMALL MOBILE
  ======================================== */

  @media screen and (max-width: 420px) {

    .shop-age-title {

      font-size: 31px;

    }


    .age-card {

      flex-basis: 88%;

    }


    .age-image-wrapper {

      height: 315px;

    }

  }

{% endstylesheet %}


