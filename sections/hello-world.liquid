<div class="hero-slider">

  <div class="slide active">
    <img 
      src="{{ 'banner-2.png' | asset_url }}"
      alt="Banner 2"
    >
  </div>


  <div class="slide">
    <img 
      src="{{ 'banner-1.png' | asset_url }}"
      alt="Banner 1"
    >
  </div>


  <button class="slider-btn prev" onclick="changeSlide(-1)">
    ❮
  </button>


  <button class="slider-btn next" onclick="changeSlide(1)">
    ❯
  </button>


</div>



<script>

let currentSlide = 0;


function changeSlide(direction){

  const slides = document.querySelectorAll(".slide");


  // Current image hide
  slides[currentSlide].classList.remove("active");


  // Next / Previous
  currentSlide = currentSlide + direction;


  // Last ke baad first
  if(currentSlide >= slides.length){

    currentSlide = 0;

  }


  // First se pehle last
  if(currentSlide < 0){

    currentSlide = slides.length - 1;

  }


  // New image show
  slides[currentSlide].classList.add("active");

}


</script>




{% stylesheet %}


.hero-slider {
width: 99.4vw; 
left: 50%;
right: 50%; 
margin-left: -50vw; 
margin-right: -50vw;


overflow:hidden;

position:relative;

}



.slide {

display:none;

}



.slide.active {

display:block;

}



.slide img {

width:100%;

height:auto;

display:block;

object-fit:cover;

}





.slider-btn {

position:absolute;

top:50%;

transform:translateY(-50%);

background:rgba(0,0,0,.4);

color:white;

border:none;

font-size:30px;

width:45px;

height:45px;

border-radius:50%;

cursor:pointer;

}



.prev {

left:20px;

}



.next {

right:20px;

}





@media(max-width:768px){

.slide img{

width:100%;
height:auto;
object-fit:contain;

}

.slider-btn{

width:35px;
height:35px;
font-size:20px;

}

}

@media(max-width:480px){

.slide img{

width:100%;
height:auto;
object-fit:contain;

}

}



{% endstylesheet %}





