<style>
  .newsletter-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 70px 20px 90px;
  }

  .newsletter-page__card {
    max-width: 680px;
    margin: 0 auto;
    padding: 55px 45px;
    text-align: center;
    border: 1px solid #e8e8e8;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
  }

  .newsletter-page__icon {
    width: 58px;
    height: 58px;
    margin: 0 auto 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #f5f5f5;
    color: #222;
  }

  .newsletter-page__icon svg {
    width: 27px;
    height: 27px;
    stroke: currentColor;
  }

  .newsletter-page__eyebrow {
    display: block;
    margin-bottom: 12px;
    color: #777;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  .newsletter-page__title {
    margin: 0 0 15px;
    color: #222;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.8px;
    font-weight: 700;
  }

  .newsletter-page__description {
    max-width: 560px;
    margin: 0 auto 30px;
    color: #666;
    font-size: 15px;
    line-height: 1.8;
  }

  .newsletter-page__benefits {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }

  .newsletter-page__benefit {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-radius: 50px;
    background: #f6f6f6;
    color: #555;
    font-size: 13px;
  }

  .newsletter-page__benefit svg {
    width: 15px;
    height: 15px;
    stroke: currentColor;
  }

  .newsletter-page__form {
    max-width: 540px;
    margin: 0 auto;
  }

  .newsletter-page__field {
    display: flex;
    gap: 10px;
  }

  .newsletter-page__input {
    flex: 1;
    min-width: 0;
    height: 52px;
    padding: 0 17px;
    border: 1px solid #dcdcdc;
    border-radius: 8px;
    outline: none;
    background: #fff;
    color: #222;
    font-family: inherit;
    font-size: 14px;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .newsletter-page__input:focus {
    border-color: #222;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
  }

  .newsletter-page__button {
    height: 52px;
    padding: 0 25px;
    border: 0;
    border-radius: 8px;
    background: #222;
    color: #fff;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: opacity .2s ease, transform .2s ease;
  }

  .newsletter-page__button:hover {
    opacity: .88;
    transform: translateY(-1px);
  }

  .newsletter-page__privacy {
    margin: 15px 0 0;
    color: #888;
    font-size: 12px;
    line-height: 1.6;
  }

  .newsletter-page__privacy a {
    color: #555;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .newsletter-page__message {
    margin: 18px 0 0;
    padding: 12px 15px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.5;
  }

  .newsletter-page__message--success {
    background: #f1f8f3;
    color: #28613b;
  }

  .newsletter-page__message--error {
    background: #fff2f2;
    color: #a33a3a;
  }

  @media screen and (max-width: 749px) {
    .newsletter-page {
      padding: 40px 16px 60px;
    }

    .newsletter-page__card {
      padding: 40px 20px;
      border-radius: 14px;
    }

    .newsletter-page__field {
      flex-direction: column;
    }

    .newsletter-page__input,
    .newsletter-page__button {
      width: 100%;
    }

    .newsletter-page__benefits {
      flex-direction: column;
      align-items: center;
    }
  }
</style>


<div class="newsletter-page">

  <div class="newsletter-page__card">

    <!-- Icon -->
    <div class="newsletter-page__icon">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="M3 7l9 6 9-6"></path>
      </svg>
    </div>


    <span class="newsletter-page__eyebrow">
      AGESSENTAILS
    </span>


    <h1 class="newsletter-page__title">
      Stay in the Loop
    </h1>


    <p class="newsletter-page__description">
      Subscribe to our newsletter and be the first to know about
      new arrivals, special offers, exclusive deals, and the latest
      updates from AGESSENTAILS.
    </p>


    <!-- Benefits -->
    <div class="newsletter-page__benefits">

      <span class="newsletter-page__benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        New Arrivals
      </span>

      <span class="newsletter-page__benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        Exclusive Offers
      </span>

      <span class="newsletter-page__benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        Latest Updates
      </span>

    </div>


    <!-- Newsletter Form -->
    {% form 'customer', class: 'newsletter-page__form' %}

      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter"
      >

      <div class="newsletter-page__field">

        <input
          type="email"
          name="contact[email]"
          class="newsletter-page__input"
          value="{{ form.email }}"
          placeholder="Enter your email address"
          aria-label="Email address"
          autocomplete="email"
          required
        >

        <button
          type="submit"
          class="newsletter-page__button"
        >
          Subscribe
        </button>

      </div>


      {% if form.posted_successfully? %}

        <div class="newsletter-page__message newsletter-page__message--success">
          Thank you for subscribing! You are now part of the AGESSENTAILS community.
        </div>

      {% endif %}


      {% if form.errors %}

        <div class="newsletter-page__message newsletter-page__message--error">
          {{ form.errors | default_errors }}
        </div>

      {% endif %}


      <p class="newsletter-page__privacy">
        By subscribing, you agree to receive marketing emails from
        AGESSENTAILS. You can unsubscribe at any time.
        See our
        <a href="/pages/privacy-policy">
          Privacy Policy
        </a>
        for more information.
      </p>

    {% endform %}

  </div>

</div>
