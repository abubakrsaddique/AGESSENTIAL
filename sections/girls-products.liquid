<section class="girls-products">

<div class="page-width">


<a href="/" class="back-btn">
&#8592;
</a>


<h1 class="girls-heading">
{{ page.title }}
</h1>



<div class="product-grid">


{% assign girls_collection = collections['girls'] %}



{% for product in girls_collection.products %}


<div class="product-card">


<div class="product-image">


<img 
src="{{ product.featured_image | image_url: width:500 }}"
alt="{{ product.title }}"
loading="lazy">


</div>



<div class="product-info">


<h3>
{{ product.title }}
</h3>



<div class="price">

{{ product.price | money }}

</div>




<a href="{{ product.url }}" class="details-btn">
More Details
</a>




<form method="post" action="/cart/add">


<input 
type="hidden"
name="id"
value="{{ product.selected_or_first_available_variant.id }}">


<button class="cart-btn">

Add To Cart

</button>


</form>



</div>


</div>



{% endfor %}



</div>



</div>


</section>





<style>


*{
box-sizing:border-box;
}




.girls-products{

width:99.4vw;
position:relative;
left:50%;
right:50%;
margin-left:-50vw;
margin-right:-50vw;

padding:40px 0;

background:#fff5fb;

overflow:hidden;

}





.page-width{

max-width:1200px;
margin:auto;
padding:0 20px;

}

.back-btn{
    display: flex; align-items: center; justify-content: center; padding: 10px 15px 24px 15px; width: 60px; height: 30px; font-size: 50px; background: #1256a0; color: #fff; text-decoration: none; border-radius: 50px; font-weight: 900; transition: .3s; margin-bottom: 10px;

}



.back-btn:hover{
background:#0b3c72;
}

.girls-heading{

text-align:center;

font-size:42px;

font-weight:700;

color:#d63384;

margin-bottom:40px;

}




.product-grid{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:25px;

}





.product-card{


background:white;

border-radius:16px;

overflow:hidden;

box-shadow:0 5px 18px rgba(0,0,0,.12);

transition:.3s;

text-align:center;

}





.product-card:hover{

transform:translateY(-6px);

}





.product-image{


height:260px;

padding:20px;

display:flex;

align-items:center;

justify-content:center;


}





.product-image img{


width:100%;

height:100%;

object-fit:contain;

}





.product-info{

padding:20px;

}





.product-info h3{


font-size:20px;

font-weight:600;

color:#222;

margin-bottom:12px;

}





.price{


font-size:24px;

font-weight:700;

color:red;

margin-bottom:20px;


}





.details-btn{


display:block;

background:#d63384;

color:white;

padding:12px;

border-radius:8px;

text-decoration:none;

font-weight:600;

margin-bottom:12px;


}



.details-btn:hover{

background:#b4236b;

}





.cart-btn{


width:100%;

background:#28a745;

color:white;

border:none;

padding:12px;

border-radius:8px;

font-size:16px;

font-weight:600;

cursor:pointer;

}



.cart-btn:hover{

background:#218838;

}







/* Laptop */


@media(max-width:1200px){


.product-grid{

grid-template-columns:repeat(3,1fr);

}


}






/* Tablet */


@media(max-width:900px){


.girls-heading{

font-size:34px;

}



.product-grid{

grid-template-columns:repeat(2,1fr);

gap:20px;

}



.product-image{

height:230px;

}


}








/* Mobile */


@media(max-width:600px){


.girls-products{

padding:25px 0;

}



.page-width{

padding:0 15px;

}



.back-btn{

width:50px;

height:40px;

font-size:32px;

}



.girls-heading{

font-size:28px;

margin-bottom:25px;

}



.product-grid{

grid-template-columns:1fr;

gap:18px;

}



.product-image{

height:240px;

}



.product-info{

padding:18px;

}



.product-info h3{

font-size:18px;

}



.price{

font-size:21px;

}



}




</style>





{% schema %}
{
"name":"Girls Products",
"settings":[],
"presets":[
{
"name":"Girls Products"
}
]
}
{% endschema %}