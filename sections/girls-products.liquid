<section class="girls-products">

  <div class="page-width">

  <a href="/" class="back-btn">
  &#8592;
</a>

    <h1 class="girls-heading">
      {{ page.title }}
    </h1>


    <div class="product-grid">


      {% assign names = "Barbie Doll|Princess Dress|Cute Doll|Girls Bag|Hair Accessories|Toy Kitchen Set|Baby Doll|Jewelry Set|Pink Teddy|Makeup Toy Set" | split:"|" %}

      {% assign prices = "2500 PKR|1800 PKR|1200 PKR|900 PKR|500 PKR|3000 PKR|2000 PKR|700 PKR|1500 PKR|1000 PKR" | split:"|" %}



      {% for i in (1..10) %}


        <div class="product-card">


          <div class="product-image">

            <img 
            src="{{ 'girls-' | append:i | append:'.jpg' | asset_url }}"
            alt="{{ names[forloop.index0] }}"
            loading="lazy">

          </div>



          <div class="product-info">


            <h3>
              {{ names[forloop.index0] }}
            </h3>


            <div class="price">
              {{ prices[forloop.index0] }}
            </div>


            <a href="#" class="details-btn">
              More Details
            </a>


          </div>


        </div>


      {% endfor %}


    </div>


  </div>

</section>



<style>


*{
box-sizing:border-box;
}



.girls-products{

 width: 99.4vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;
padding:40px 0;
background:#fff5fb;
overflow:hidden;

}

.back-btn{
padding: 10px 15px 24px 15px;
    width: 60px;
    height: 30px;
    font-size: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
   
    
    background: #1256a0;
    color: #fff;
    text-decoration: none;
    border-radius: 50px;
    
    font-weight: 900;
    transition: .3s;
    margin-bottom: 10px;
}

.back-btn:hover{
background:#0b3c72;
}

.girls-products .page-width{

max-width:1200px;
margin:0 auto;
padding:0 20px;

}



.girls-heading{

text-align:center;
font-size:42px;
font-weight:700;
color:#d63384;
margin:0 0 40px;

}




/* GRID */

.product-grid{

display:grid;
grid-template-columns:repeat(4,1fr);
gap:25px;

}




/* CARD */


.product-card{

background:#ffffff;
border-radius:16px;
overflow:hidden;
box-shadow:0 5px 18px rgba(0,0,0,0.12);
transition:.3s ease;
text-align:center;

}



.product-card:hover{

transform:translateY(-6px);

}




/* IMAGE */


.product-image{

width:100%;
height:260px;
display:flex;
align-items:center;
justify-content:center;
padding:20px;
background:#fff;

}



.product-image img{

width:100%;
height:100%;
max-width:220px;
object-fit:contain;

}




/* INFO */


.product-info{

padding:20px;

}



.product-info h3{

font-size:20px;
color:#222;
margin:0 0 12px;
font-weight:600;

}




.price{

font-size:24px;
font-weight:700;
color:red;
margin-bottom:20px;

}




.details-btn{

display:inline-block;
background:#d63384;
color:white;
padding:12px 30px;
border-radius:8px;
text-decoration:none;
font-weight:600;
transition:.3s;

}



.details-btn:hover{

background:#b4236b;

}





/* LARGE LAPTOP */


@media(max-width:1200px){


.product-grid{

grid-template-columns:repeat(3,1fr);

}


}




/* TABLET */


@media(max-width:900px){


.girls-heading{

font-size:34px;

}



.product-grid{

grid-template-columns:repeat(2,1fr);
gap:20px;

}



.product-image{

height:230px;

}


}





/* MOBILE */


@media(max-width:600px){


.girls-products{

padding:25px 0;

}



.girls-products .page-width{

padding:0 15px;

}



.girls-heading{

font-size:28px;
margin-bottom:25px;

}



.product-grid{

grid-template-columns:1fr;
gap:18px;

}



.product-image{

height:240px;

}



.product-info h3{

font-size:18px;

}



.price{

font-size:21px;

}



.details-btn{

padding:10px 25px;

}


}



</style>




{% schema %}
{
"name":"Girls Products",
"settings":[],
"presets":[
{
"name":"Girls Products"
}
]
}
{% endschema %}