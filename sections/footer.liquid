<footer class="ag-premium-footer">

  <div class="ag-footer-inner">

    <!-- TOP FOOTER -->

    <div class="ag-footer-top">

      <!-- BRAND -->

      <div class="ag-footer-brand">

       <div class="ag-footer-logo">
    <a href="{{ routes.root_url }}">
      <img
        src="{{ 'logo.png' | asset_url }}"
        alt="{{ shop.name }}"
      >
    </a>
  </div>

        <p class="ag-footer-description">
          Making little moments more playful, joyful and magical. 
          Discover toys your little ones will love. ✨
        </p>

        <div class="ag-footer-trust">
          <span>✓</span>
          Loved by little ones
        </div>

        <div class="ag-footer-trust">
          <span>✓</span>
          Carefully selected toys
        </div>

      </div>


      <!-- CATEGORIES -->

      <div class="ag-footer-column">

        <h3>
          Categories
        </h3>

        <ul>

          <li>
            <a href="/collections">
              All Toys
            </a>
          </li>

          <li>
            <a href="/collections/babies">
              Baby Toys
            </a>
          </li>

          <li>
            <a href="/collections/boys">
              Boys
            </a>
          </li>

          <li>
            <a href="/collections/girls">
              Girls
            </a>
          </li>

          <li>
            <a href="/collections/vehicles">
              Vehicles
            </a>
          </li>

          <li>
            <a href="/collections/learning-toys">
              Learning Toys
            </a>
          </li>

        </ul>

      </div>


      <!-- INFORMATION -->

      <div class="ag-footer-column">

        <h3>
          Information
        </h3>

        <ul>

          <li>
            <a href="/pages/about-us">
              About Us
            </a>
          </li>

          <li>
            <a href="/pages/contact-us">
              Contact Us
            </a>
          </li>

          <li>
            <a href="/pages/delivery-information">
              Delivery Information
            </a>
          </li>

          <li>
            <a href="/pages/faq">
              FAQs
            </a>
          </li>

          <li>
            <a href="/pages/privacy-policy">
              Privacy Policy
            </a>
          </li>

          <li>
            <a href="/pages/terms-of-use">
              Terms of Use
            </a>
          </li>

        </ul>

      </div>


      <!-- ACCOUNT / SOCIAL -->

      <div class="ag-footer-column">

        <h3>
          My Account
        </h3>

        <ul>

          <li>
            <a href="/account">
              Account Information
            </a>
          </li>

          <li>
            <a href="/account/orders">
              My Orders
            </a>
          </li>

          <li>
            <a href="/pages/newsletter-subscription">
              Newsletter
            </a>
          </li>

        </ul>


        <div class="ag-footer-social-title">
          Follow Us
        </div>

        <div class="ag-footer-social">

          <a
            href="https://www.facebook.com/profile.php?id=61593316686781"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <img
              src="{{ 'Facebook-Logo.png' | asset_url }}"
              alt="Facebook"
              width="35"
              height="35"
            >
          </a>


          <a
            href="https://www.instagram.com/agessentials9/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <img
              src="{{ 'Instagram-Logo.png' | asset_url }}"
              alt="Instagram"
              width="35"
              height="35"
            >
          </a>


          <a
            href="https://www.tiktok.com/@agessential9?lang=en"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
          >
            <img
              src="{{ 'TIKTOK-social-1.png' | asset_url }}"
              alt="TikTok"
              width="35"
              height="35"
            >
          </a>

        </div>

      </div>

    </div>


    <!-- NEWSLETTER STRIP -->

    <div class="ag-footer-newsletter">

      <div class="ag-newsletter-text">

        <div class="ag-newsletter-icon">
          🎁
        </div>

        <div>

          <h3>
            Stay in the loop
          </h3>

          <p>
            Get toy inspiration, new arrivals & special offers.
          </p>

        </div>

      </div>


      {% form 'customer', class: 'ag-newsletter-form' %}

        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >

        <input
          type="email"
          name="contact[email]"
          placeholder="Your email address"
          aria-label="Your email address"
          required
        >

        <button type="submit">
          Subscribe
          <span>→</span>
        </button>

      {% endform %}

    </div>


    <!-- BOTTOM -->

    <div class="ag-footer-bottom">

      <div class="ag-footer-copyright">

        © {{ 'now' | date: '%Y' }} AG Essential.
        All rights reserved.

      </div>


      {% if section.settings.show_payment_icons %}

        <div class="ag-payment-icons">

          {% for type in shop.enabled_payment_types %}

            <span class="ag-payment-icon">

              {{ type | payment_type_svg_tag }}

            </span>

          {% endfor %}

        </div>

      {% endif %}

    </div>

  </div>

</footer>


{% stylesheet %}

/* =====================================================
   AG ESSENTIAL PREMIUM FOOTER
===================================================== */

.ag-premium-footer {

  width: 99.4vw;

  position: relative;

  left: 50%;

  margin-left: -50vw;

  background: #FFF9F1;

  color: #222;

  overflow: hidden;

}

.ag-footer-logo a {
  display: inline-block;
}

.ag-footer-logo img {
  display: block;
  max-width: 240px;
  height: auto;
}

.ag-footer-inner {

  max-width: 1380px;

  margin: 0 auto;

  padding: 70px 45px 25px;

}


/* =====================================================
   FOOTER TOP
===================================================== */

.ag-footer-top {

  display: grid;

  grid-template-columns:
    1.5fr
    1fr
    1fr
    1fr;

  gap: 65px;

  padding-bottom: 55px;

}


/* =====================================================
   BRAND
===================================================== */

.ag-footer-logo {

  font-size: 31px;

  font-weight: 900;

  letter-spacing: -1.5px;

  color: #13205C;

  margin-bottom: 17px;

}


.ag-footer-logo span {

  color: #FF5B8D;

}


.ag-footer-description {

  max-width: 330px;

  margin: 0 0 22px;

  color: #777;

  font-size: 14px;

  line-height: 1.75;

}


.ag-footer-trust {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-top: 9px;

  color: #555;

  font-size: 12px;

  font-weight: 600;

}


.ag-footer-trust span {

  width: 20px;

  height: 20px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #DDF7E7;

  color: #159447;

  font-size: 11px;

  font-weight: 900;

}


/* =====================================================
   COLUMNS
===================================================== */

.ag-footer-column h3 {

  position: relative;

  margin: 0 0 22px;

  padding-bottom: 11px;

  color: #13205C;

  font-size: 16px;

  font-weight: 800;

}


.ag-footer-column h3::after {

  content: "";

  position: absolute;

  left: 0;

  bottom: 0;

  width: 30px;

  height: 3px;

  border-radius: 10px;

  background: #FF5B8D;

}


.ag-footer-column:nth-child(2) h3::after {

  background: #42A5F5;

}


.ag-footer-column:nth-child(3) h3::after {

  background: #FFC83D;

}


.ag-footer-column:nth-child(4) h3::after {

  background: #63C75B;

}


.ag-footer-column ul {

  list-style: none;

  margin: 0;

  padding: 0;

}


.ag-footer-column li {

  margin-bottom: 12px;

}


.ag-footer-column li a {

  position: relative;

  color: #626262;

  text-decoration: none;

  font-size: 13px;

  font-weight: 500;

  transition: .25s ease;

}


.ag-footer-column li a:hover {

  color: #13205C;

  padding-left: 7px;

}


/* =====================================================
   SOCIAL
===================================================== */

.ag-footer-social-title {

  margin-top: 28px;

  margin-bottom: 12px;

  color: #13205C;

  font-size: 13px;

  font-weight: 800;

}


.ag-footer-social {

  display: flex;

  gap: 9px;

}


.ag-footer-social a {

  width: 40px;

  height: 40px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #ffffff;

  border: 1px solid #eee4d8;

  box-shadow: 0 5px 15px rgba(0,0,0,.05);

  transition: .3s ease;

}


.ag-footer-social a:hover {

  transform: translateY(-5px);

  box-shadow: 0 10px 22px rgba(0,0,0,.12);

  background: #fff;

}


.ag-footer-social img {

  width: 22px;

  height: 22px;

  object-fit: contain;

}


/* =====================================================
   NEWSLETTER
===================================================== */

.ag-footer-newsletter {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 30px;

  padding: 25px 28px;

  border-radius: 22px;

  background: #ffffff;

  border: 1px solid #eee5da;

  box-shadow: 0 10px 30px rgba(36,29,20,.05);

}


.ag-newsletter-text {

  display: flex;

  align-items: center;

  gap: 15px;

}


.ag-newsletter-icon {

  width: 52px;

  height: 52px;

  flex: 0 0 52px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16px;

  background: linear-gradient(
    135deg,
    #FFE2EC,
    #FFF0B8
  );

  font-size: 25px;

}


.ag-newsletter-text h3 {

  margin: 0 0 4px;

  color: #13205C;

  font-size: 18px;

  font-weight: 800;

}


.ag-newsletter-text p {

  margin: 0;

  color: #777;

  font-size: 12px;

}


.ag-newsletter-form {

  display: flex;

  min-width: 390px;

  padding: 5px;

  border-radius: 13px;

  background: #F8F5F0;

  border: 1px solid #e8dfd4;

}


.ag-newsletter-form input {

  min-width: 0;

  flex: 1;

  border: 0;

  outline: 0;

  background: transparent;

  padding: 11px 13px;

  color: #222;

  font-family: inherit;

  font-size: 12px;

}


.ag-newsletter-form input::placeholder {

  color: #999;

}


.ag-newsletter-form button {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  border: 0;

  border-radius: 9px;

  padding: 11px 16px;

  background: #13205C;

  color: #fff;

  cursor: pointer;

  font-family: inherit;

  font-size: 11px;

  font-weight: 800;

  transition: .25s ease;

}


.ag-newsletter-form button:hover {

  background: #FF5B8D;

}


.ag-newsletter-form button span {

  font-size: 15px;

  line-height: 1;

}


/* =====================================================
   BOTTOM
===================================================== */

.ag-footer-bottom {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 20px;

  margin-top: 30px;

  padding-top: 22px;

  border-top: 1px solid #e9e0d5;

}


.ag-footer-copyright {

  color: #999;

  font-size: 11px;

}


.ag-payment-icons {

  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 7px;

  flex-wrap: wrap;

}


.ag-payment-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  min-width: 40px;

  height: 25px;

  padding: 3px 5px;

  border-radius: 5px;

  background: #fff;

  border: 1px solid #eee6dc;

}


.ag-payment-icon svg {

  width: 32px;

  max-height: 20px;

}


/* =====================================================
   TABLET
===================================================== */

@media screen and (max-width: 1050px) {

  .ag-footer-inner {

    padding: 60px 30px 22px;

  }


  .ag-footer-top {

    grid-template-columns: 1.4fr 1fr 1fr;

    gap: 45px;

  }


  .ag-footer-brand {

    grid-column: span 3;

  }


  .ag-footer-description {

    max-width: 500px;

  }


  .ag-footer-newsletter {

    align-items: flex-start;

    flex-direction: column;

  }


  .ag-newsletter-form {

    width: 100%;

    min-width: 0;

    max-width: 550px;

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  .ag-footer-inner {

    padding: 50px 18px 20px;

  }


  .ag-footer-top {

    grid-template-columns: repeat(2, 1fr);

    gap: 35px 25px;

    padding-bottom: 35px;

  }


  .ag-footer-brand {

    grid-column: span 2;

  }


  .ag-footer-logo {

    font-size: 28px;

  }


  .ag-footer-description {

    font-size: 13px;

    line-height: 1.7;

  }


  .ag-footer-column h3 {

    font-size: 15px;

    margin-bottom: 17px;

  }


  .ag-footer-column li {

    margin-bottom: 10px;

  }


  .ag-footer-column li a {

    font-size: 12px;

  }


  .ag-footer-newsletter {

    padding: 20px;

    border-radius: 18px;

    gap: 20px;

  }


  .ag-newsletter-text {

    align-items: flex-start;

  }


  .ag-newsletter-icon {

    width: 45px;

    height: 45px;

    flex-basis: 45px;

    border-radius: 13px;

    font-size: 21px;

  }


  .ag-newsletter-text h3 {

    font-size: 16px;

  }


  .ag-newsletter-text p {

    font-size: 11px;

    line-height: 1.5;

  }


  .ag-newsletter-form {

    display: flex;

    width: 100%;

    padding: 4px;

  }


  .ag-newsletter-form input {

    width: 100%;

    padding: 10px;

  }


  .ag-newsletter-form button {

    padding: 10px 13px;

  }


  .ag-footer-bottom {

    flex-direction: column;

    justify-content: center;

    text-align: center;

    margin-top: 25px;

    padding-top: 20px;

  }


  .ag-payment-icons {

    justify-content: center;

  }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media screen and (max-width: 420px) {

  .ag-footer-top {

    gap: 30px 18px;

  }


  .ag-footer-social a {

    width: 36px;

    height: 36px;

  }


  .ag-footer-social img {

    width: 20px;

    height: 20px;

  }


  .ag-newsletter-form {

    flex-direction: column;

    background: transparent;

    border: 0;

    padding: 0;

    gap: 8px;

  }


  .ag-newsletter-form input {

    box-sizing: border-box;

    width: 100%;

    height: 42px;

    border-radius: 9px;

    background: #F8F5F0;

    border: 1px solid #e8dfd4;

  }


  .ag-newsletter-form button {

    width: 100%;

    height: 42px;

    justify-content: center;

  }

}

{% endstylesheet %}


{% schema %}

{
  "name": "Premium Footer",

  "tag": "section",

  "class": "section",

  "settings": [

    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }

  ],

  "presets": [
    {
      "name": "Premium Footer"
    }
  ]

}

{% endschema %}
