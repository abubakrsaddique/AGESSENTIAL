{% stylesheet %}


/* =====================================================
   TOP PICKS
===================================================== */

.top-picks-section {

  width: 99.4vw;

  position: relative;

  left: 50%;

  margin-left: -50vw;

  background: #FFF9F1;

  overflow: hidden;

}


.top-picks-container {

  width: 100%;

  max-width: 1380px;

  margin: 0 auto;

  padding: 0px 40px 90px;

  box-sizing: border-box;

}


/* =====================================================
   HEADER
===================================================== */

.top-picks-header {

  text-align: center;

  max-width: 700px;

  margin: 0 auto 45px;

}


.top-picks-eyebrow {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 7px 14px;

  margin-bottom: 14px;

  border-radius: 50px;

  background: #ffffff;

  border: 1px solid #eee4d8;

  color: #8a7560;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.6px;

}


.top-picks-dot {

  width: 7px;

  height: 7px;

  border-radius: 50%;

  background: #ff6b35;

  box-shadow:
    0 0 0 4px rgba(255,107,53,.12);

}


.top-picks-heading {

  margin: 0;

  color: #222222;

  font-size: clamp(38px, 4vw, 54px);

  line-height: 1.05;

  letter-spacing: -1.8px;

  font-weight: 800;

}


.top-picks-subheading {

  max-width: 520px;

  margin: 13px auto 0;

  color: #6f6a63;

  font-size: 16px;

  line-height: 1.65;

}


/* =====================================================
   GRID
===================================================== */

.top-picks-grid {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 22px;

}


/* =====================================================
   CARD
===================================================== */

.top-pick-card {

  position: relative;

  display: block;

  min-width: 0;

  overflow: hidden;

  border-radius: 25px;

  background: #ffffff;

  text-decoration: none;

  box-shadow:
    0 8px 28px rgba(36, 29, 20, .07);

  transition:
    transform .35s ease,
    box-shadow .35s ease;

}


.top-pick-card:hover {

  transform: translateY(-7px);

  box-shadow:
    0 20px 45px rgba(36, 29, 20, .14);

}


/* =====================================================
   IMAGE
===================================================== */

.top-pick-image {

  position: relative;

  width: 100%;

  height: 315px;

  overflow: hidden;

  background: #f6f1e9;

}


.top-pick-image img {

  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  transition:
    transform .65s cubic-bezier(.2,.7,.2,1);

}


.top-pick-card:hover
.top-pick-image img {

  transform: scale(1.07);

}


/* =====================================================
   COLORFUL HOVER BUBBLE
===================================================== */

.top-pick-hover-icon {

  position: absolute;

  top: 15px;

  left: 15px;

  z-index: 5;

  width: 58px;

  height: 58px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  font-size: 26px;

  opacity: 0;

  transform:
    scale(.35)
    rotate(-25deg);

  box-shadow:
    0 10px 28px rgba(0,0,0,.18);

  transition:
    opacity .25s ease,
    transform .45s cubic-bezier(.2,.8,.2,1);

}


/* Bubble colors */

.top-pick-card:nth-child(1)
.top-pick-hover-icon {

  background:
    linear-gradient(
      135deg,
      #ff4f91,
      #ff719c,
      #ffb347
    );

}


.top-pick-card:nth-child(2)
.top-pick-hover-icon {

  background:
    linear-gradient(
      135deg,
      #1684ff,
      #36cfc9,
      #7c5cff
    );

}


.top-pick-card:nth-child(3)
.top-pick-hover-icon {

  background:
    linear-gradient(
      135deg,
      #7c5cff,
      #ff4f91,
      #ff9f43
    );

}


.top-pick-card:nth-child(4)
.top-pick-hover-icon {

  background:
    linear-gradient(
      135deg,
      #20c997,
      #36cfc9,
      #1684ff
    );

}


/* Shine */

.top-pick-hover-icon::before {

  content: "";

  position: absolute;

  top: 8px;

  left: 10px;

  width: 12px;

  height: 12px;

  border-radius: 50%;

  background:
    rgba(255,255,255,.9);

}


.top-pick-hover-icon::after {

  content: "";

  position: absolute;

  right: 9px;

  bottom: 10px;

  width: 6px;

  height: 6px;

  border-radius: 50%;

  background:
    rgba(255,255,255,.7);

}


/* Show bubble */

.top-pick-card:hover
.top-pick-hover-icon {

  opacity: 1;

  transform:
    scale(1)
    rotate(0deg);

}


/* =====================================================
   ARROW
===================================================== */

.top-pick-arrow {

  position: absolute;

  right: 15px;

  top: 15px;

  z-index: 5;

  width: 42px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background:
    rgba(255,255,255,.92);

  color: #222222;

  font-size: 20px;

  opacity: 0;

  transform:
    translateY(6px);

  transition:
    opacity .25s ease,
    transform .3s ease;

  box-shadow:
    0 7px 20px rgba(0,0,0,.10);

}


.top-pick-card:hover
.top-pick-arrow {

  opacity: 1;

  transform:
    translateY(0);

}


/* =====================================================
   CONTENT
===================================================== */

.top-pick-content {

  position: relative;

  padding: 20px 20px 22px;

}


.top-pick-small {

  display: block;

  margin-bottom: 6px;

  color: #a09487;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 1.2px;

}


.top-pick-content h3 {

  margin: 0;

  color: #222222;

  font-size: 23px;

  line-height: 1.2;

  font-weight: 800;

}


.top-pick-content p {

  margin: 7px 0 0;

  color: #77716a;

  font-size: 13px;

  line-height: 1.5;

}


/* =====================================================
   CARD ACCENTS
===================================================== */

.top-pick-card:nth-child(1)
.top-pick-content h3 {

  color: #e94f82;

}


.top-pick-card:nth-child(2)
.top-pick-content h3 {

  color: #1684ff;

}


.top-pick-card:nth-child(3)
.top-pick-content h3 {

  color: #7657e8;

}


.top-pick-card:nth-child(4)
.top-pick-content h3 {

  color: #13a978;

}


/* =====================================================
   TABLET
===================================================== */

@media screen and (max-width: 1050px) {

  .top-picks-container {

    padding:
      70px
      25px
      75px;

  }


  .top-picks-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 20px;

  }


  .top-pick-image {

    height: 300px;

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  .top-picks-container {

    padding:
      58px
      16px
      65px;

  }


  .top-picks-header {

    margin-bottom: 30px;

  }


  .top-picks-eyebrow {

    font-size: 9px;

  }


  .top-picks-heading {

    font-size: 34px;

    letter-spacing: -1.1px;

  }


  .top-picks-subheading {

    font-size: 14px;

    padding: 0 10px;

  }


  .top-picks-grid {

    grid-template-columns: 1fr;

    gap: 16px;

  }


  .top-pick-card {

    border-radius: 21px;

  }


  .top-pick-image {

    height: 250px;

  }


  .top-pick-content {

    padding:
      16px
      17px
      19px;

  }


  .top-pick-content h3 {

    font-size: 21px;

  }


  .top-pick-content p {

    font-size: 13px;

  }


  .top-pick-hover-icon {

    width: 50px;

    height: 50px;

    top: 12px;

    left: 12px;

    font-size: 22px;

  }


  .top-pick-arrow {

    width: 38px;

    height: 38px;

    top: 12px;

    right: 12px;

  }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media screen and (max-width: 420px) {

  .top-picks-heading {

    font-size: 31px;

  }


  .top-pick-image {

    height: 225px;

  }

}

{% endstylesheet %}


{% schema %}

{
  "name": "Top Picks",

  "tag": "section",

  "class": "section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Picks"
    }

  ],

  "presets": [

    {
      "name": "Top Picks"
    }

  ]

}

{% endschema %}
