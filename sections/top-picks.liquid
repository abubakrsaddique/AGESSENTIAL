<section class="top-picks-section">

  <div class="page-width">

    <h2 class="top-picks-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="top-picks-grid">

      <!-- Doll Collection -->
      <a href="/collections/dolls" class="top-pick-card">

        <div class="top-pick-image">
          <img src="{{ 'pick-1.png' | asset_url }}" alt="Doll">
        </div>

        <div class="top-pick-title">
          Doll
        </div>

      </a>


      <!-- Toy Cars Collection -->
      <a href="/collections/vehicles" class="top-pick-card">

        <div class="top-pick-image">
          <img src="{{ 'pick-2.jpg' | asset_url }}" alt="Toy Cars">
        </div>

        <div class="top-pick-title">
          Toy Cars
        </div>

      </a>


      <!-- Makeup Sets Collection -->
      <a href="/collections/toy-guns" class="top-pick-card">

        <div class="top-pick-image">
          <img src="{{ 'pick-3.png' | asset_url }}" alt="Toy Guns">
        </div>

        <div class="top-pick-title">
          Toy Guns
        </div>

      </a>


      <!-- Outdoor Toys Collection -->
   <a href="/collections/boylearning-toyss" class="top-pick-card">

        <div class="top-pick-image">
          <img src="{{ 'learning.png' | asset_url }}" alt="Learning Toys">
        </div>

        <div class="top-pick-title">
          Learning Toys
        </div>

      </a>


    </div>

  </div>

</section>


<style>

.top-picks-section{
    width:99.4vw;
    position:relative;
    left:50%;
    right:50%;
    margin-left:-50vw;
    margin-right:-50vw;
    padding:40px 0;
    background:linear-gradient(180deg,#eafcff,#eafcff);
}


.top-picks-heading{
    text-align:center;
    font-size:48px;
    font-weight:700;
    color:#13205c;
    margin-bottom:45px;
}


.top-picks-grid{
    padding:20px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:30px;
}


.top-pick-card{

    text-decoration:none;
    border-radius:20px;
    overflow:hidden;
    background:#fff;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
    transition:.35s ease;
    display:block;

}


.top-pick-card:hover{

    transform:translateY(-8px);
    box-shadow:0 18px 35px rgba(0,0,0,.15);

}


.top-pick-image{

    width:100%;
    overflow:hidden;
}


.top-pick-image img{

    width:100%;
    height:300px;
    object-fit:cover;
    display:block;
    transition:.4s;

}


.top-pick-card:hover img{

    transform:scale(1.08);

}


.top-pick-title{

    background:#1773b0;
    color:white;
    text-align:center;
    padding:18px;
    font-size:22px;
    font-weight:600;

}



/* Tablet */

@media(max-width:990px){

    .top-picks-heading{
        font-size:38px;
    }


    .top-picks-grid{

        grid-template-columns:repeat(2,1fr);
        gap:20px;

    }


}



/* Mobile */

@media(max-width:767px){

    .top-picks-section{

        padding:30px 0;

    }


    .top-picks-heading{

        font-size:30px;
        margin-bottom:30px;

    }


    .top-picks-grid{

        grid-template-columns:1fr;
        gap:18px;

    }


    .top-pick-image img{

        height:230px;

    }


    .top-pick-title{

        font-size:18px;
        padding:15px;

    }

}

</style>


{% schema %}
{
  "name": "Top Picks",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Picks"
    }
  ],
  "presets": [
    {
      "name": "Top Picks"
    }
  ]
}
{% endschema %}