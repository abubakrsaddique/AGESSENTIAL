      </a>



      <!-- =========================
           TOY GUNS
      ========================== -->

      <a
        href="/collections/toy-guns"
        class="top-pick-card"
      >

        <div class="top-pick-image">

          <img
            src="{{ 'pick-3.png' | asset_url }}"
            alt="Toy Guns"
            loading="lazy"
          >

          <span class="top-pick-hover-icon">
            ⭐
          </span>

          <span class="top-pick-arrow">
            →
          </span>

        </div>


        <div class="top-pick-content">

          <div>

            <span class="top-pick-small">
              FUN PICK
            </span>

            <h3>
              Toy Guns
            </h3>

            <p>
              Imaginative and action-packed playtime.
            </p>

          </div>

