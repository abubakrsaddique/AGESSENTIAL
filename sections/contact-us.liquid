<section class="contact-us-section">
{% if template.name == 'page' and page.handle == 'contact-us' %}

<a href="/" class="back-btn">
  &#8592;
</a>

{% endif %}

  <!-- Heading Banner -->
  <div class="contact-banner">

    <div class="page-width">
   

      <div class="contact-banner-content">

        <h1>
          Contact Us
        </h1>

      </div>

    </div>

  </div>


  <!-- Contact Form -->

  <div class="page-width page-w">

    <div class="contact-form-wrapper">


      {% form 'contact', id: 'ContactForm' %}


        {% if form.posted_successfully? %}

          <div class="contact-success">
            Thank you! Your message has been sent successfully.
          </div>

        {% endif %}


        {{ form.errors | default_errors }}



        <div class="contact-grid">


          <div class="field">

            <label for="ContactFormName">
              Full Name
            </label>

            <input
              id="ContactFormName"
              type="text"
              name="contact[name]"
              placeholder="Enter your full name">

          </div>



          <div class="field">

            <label for="ContactFormEmail">
              Email Address
            </label>

            <input
              id="ContactFormEmail"
              type="email"
              name="contact[email]"
              placeholder="Enter your email"
              required>

          </div>



          <div class="field">

            <label for="ContactFormPhone">
              Mobile Number
            </label>

            <input
              id="ContactFormPhone"
              type="tel"
              name="contact[phone]"
              placeholder="Enter your phone number">

          </div>



          <div class="field">

            <label for="ContactFormSubject">
              Subject
            </label>

            <input
              id="ContactFormSubject"
              type="text"
              name="contact[subject]"
              placeholder="Subject">

          </div>



          <div class="field field-full">

            <label for="ContactFormMessage">
              Message
            </label>

            <textarea
              id="ContactFormMessage"
              rows="7"
              name="contact[body]"
              placeholder="Write your message here..."></textarea>

          </div>



          <div class="field-full contact-button">

            <button type="submit">
              Send Message
            </button>

          </div>


        </div>


      {% endform %}


    </div>

  </div>


</section>



<style>


.contact-us-section{
    width: 99.4vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;
    background:linear-gradient(180deg,#eafcff,#eafcff); padding: 20px 50px 20px 50px;

}



/* Heading */

.contact-banner{

    height:145px;

    display:flex;

    align-items:center;

    justify-content:center;

}
.page-w{
  padding: 0px 160px 0px 160px;
}

.back-btn{
    padding: 10px 15px 24px 15px;
    width: 60px;
    height: 30px;
    font-size: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1256a0;
    color: #fff;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 900;
    transition: .3s;
    margin-bottom: 10px;
}

.back-btn:hover{
background:#0b3c72;
}


.contact-banner-content{

    text-align:center;

}



.contact-banner-content h1{

    font-size:54px;

    font-weight:700;

    color:#13205c;

    margin:0;

}




/* Form Box */


.contact-form-wrapper{

    background:#fff;

    padding:50px;

    border-radius:24px;

    margin-top:-40px;

    position:relative;

    z-index:2;

    box-shadow:0 15px 40px rgba(0,0,0,.08);

}



.contact-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:25px;

}



.field{

    display:flex;

    flex-direction:column;

}



.field-full{

    grid-column:1/-1;

}



.field label{

    font-weight:600;

    margin-bottom:8px;

    color:#13205c;

}



.field input,
.field textarea{

    width:100%;

    padding:15px;

    border:1px solid #d7d7d7;

    border-radius:10px;

    font-size:16px;

}



.field input:focus,
.field textarea:focus{

    outline:none;

    border-color:#1773b0;

}



.contact-button{

    text-align:center;

}



.contact-button button{

    background:#1773b0;

    color:#fff;

    padding:16px 45px;

    border:none;

    border-radius:10px;

    font-size:18px;

    font-weight:600;

    cursor:pointer;

}



.contact-button button:hover{

    background:#125b8b;

}



.contact-success{

    background:#daf5d6;

    padding:15px;

    border-radius:8px;

    margin-bottom:25px;

}




/* Responsive */


@media(max-width:767px){

    .contact-us-section{
            width: 99.4vw;
        left:auto;
        right:auto;
               margin-left: -20px;
        margin-right:0;
    }


    .page-w{
        padding:0 20px;
    }


    .contact-banner{
        height:140px;
        padding:20px;
    }


    .contact-banner-content h1{
        font-size:32px;
        line-height:1.2;
    }


    .contact-form-wrapper{

        padding:22px;
        border-radius:16px;
        margin-top:-20px;

    }


    .contact-grid{

        display:grid;
        grid-template-columns:1fr;
        gap:18px;

    }


    .field{

        width:100%;

    }


    .field label{

        font-size:14px;
        margin-bottom:6px;

    }


    .field input,
    .field textarea{

        width:100%;
        padding:13px;
        font-size:14px;
        border-radius:8px;
        box-sizing:border-box;

    }


    .field textarea{

        min-height:130px;

    }


    .contact-button button{

        width:100%;
        padding:14px;
        font-size:16px;

    }

}


/* Small Mobile */

@media(max-width:480px){

    .page-w{

        padding:0 15px;

    }


    .contact-banner{

        height:120px;

    }


    .contact-banner-content h1{

        font-size:28px;

    }


    .contact-form-wrapper{

        padding:18px;
        border-radius:14px;

    }


    .contact-grid{

        gap:15px;

    }


    .field input,
    .field textarea{

        font-size:13px;

    }

}


</style>



{% schema %}
{
  "name": "Contact Us",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Contact Us"
    }
  ]
}
{% endschema %}