<section class="boys-products">

<div class="page-width">


<a href="/" class="back-btn">
&#8592;
</a>


<h1 class="boys-heading">
{{ page.title }}
</h1>



<div class="product-grid">


{% assign boys_collection = collections['boys'] %}



{% for product in boys_collection.products %}


<div class="product-card">


<div class="product-image">


<img 
src="{{ product.featured_image | image_url: width:500 }}"
alt="{{ product.title }}"
loading="lazy">


</div>




<div class="product-info">


<h3>
{{ product.title }}
</h3>

{% if product.selected_or_first_available_variant.sku != blank %}
  <div class="product-sku">
    Item Code: {{ product.selected_or_first_available_variant.sku }}
  </div>
{% endif %}

<div class="price">

{{ product.price | money }}

</div>




<a href="{{ product.url }}" class="details-btn">
More Details
</a>





<form method="post" action="/cart/add">


<input 
type="hidden"
name="id"
value="{{ product.selected_or_first_available_variant.id }}">



<button class="cart-btn">

Add To Cart

</button>


</form>



</div>


</div>



{% endfor %}



</div>


</div>


</section>





<style>


*{
box-sizing:border-box;
}



.boys-products{

width:99.4vw;
position:relative;
left:50%;
right:50%;
margin-left:-50vw;
margin-right:-50vw;

padding:40px 0;

background:#eef7ff;

overflow:hidden;

}




.page-width{

max-width:1200px;
margin:auto;
padding:0 20px;

}



.back-btn{
    display: flex; align-items: center; justify-content: center; padding: 10px 15px 24px 15px; width: 60px; height: 30px; font-size: 50px; background: #1256a0; color: #fff; text-decoration: none; border-radius: 50px; font-weight: 900; transition: .3s; margin-bottom: 10px;

}



.back-btn:hover{
background:#0b3c72;
}



.boys-heading{

text-align:center;

font-size:42px;

font-weight:700;

color:#1256a0;

margin-bottom:40px;

}




.product-grid{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:25px;

}




.product-card{

background:#fff;

border-radius:16px;

overflow:hidden;

box-shadow:0 5px 18px rgba(0,0,0,.12);

text-align:center;

transition:.3s;

}




.product-card:hover{

transform:translateY(-5px);

}





.product-image{

height:260px;

display:flex;

align-items:center;

justify-content:center;

padding:20px;

}





.product-image img{

width:100%;

height:100%;

object-fit:contain;

}





.product-info{

padding:20px;

}





.product-info h3{

font-size:20px;

margin:0 0 12px;

color:#222;

}





.price{

font-size:24px;

font-weight:700;

color:red;

margin-bottom:20px;

}





.details-btn{

display:block;

background:#1256a0;

color:white;

padding:12px;

border-radius:8px;

text-decoration:none;

font-weight:600;

margin-bottom:12px;

}



.details-btn:hover{

background:#0b3c72;

}


.product-sku {
  font-size: 15px;
  color: #666;
  margin: 8px 0 15px;
  font-weight: 500;
}

.product-sku strong {
  color: #222;
}


.cart-btn{

width:100%;

background:#28a745;

color:white;

padding:12px;

border:none;

border-radius:8px;

font-size:16px;

font-weight:600;

cursor:pointer;

}



.cart-btn:hover{

background:#218838;

}





/* Laptop */


@media(max-width:1200px){


.product-grid{

grid-template-columns:repeat(3,1fr);

}


}





/* Tablet */


@media(max-width:900px){


.boys-heading{

font-size:34px;

}



.product-grid{

grid-template-columns:repeat(2,1fr);

gap:20px;

}



.product-image{

height:230px;

}


}





/* Mobile */


@media(max-width:600px){


.boys-products{

padding:25px 0;

}



.page-width{

padding:0 15px;

}



.back-btn{

width:50px;

height:40px;

font-size:32px;

}



.boys-heading{

font-size:28px;

margin-bottom:25px;

}



.product-grid{

grid-template-columns:1fr;

gap:18px;

}



.product-image{

height:240px;

}



.product-info{

padding:18px;

}



.product-info h3{

font-size:18px;

}



.price{

font-size:20px;

}


}



</style>





{% schema %}
{
"name":"Boys Products",
"settings":[],
"presets":[
{
"name":"Boys Products"
}
]
}
{% endschema %}