<section class="luxury-babies-products"> <div class="luxury-babies-container">
<!-- BACK -->
<a href="/" class="luxury-back-btn" aria-label="Back to home">
  <span class="back-arrow">←</span>
  <span>Back</span>
</a>


<!-- HEADER -->
<header class="luxury-babies-header">

  <div class="luxury-babies-badge">
    <span></span>
    LITTLE LUXURIES
    <span></span>
  </div>

  <h1 class="luxury-babies-title">
    {{ page.title }}
  </h1>

  <p class="luxury-babies-description">
    Thoughtfully chosen essentials made for beautiful little moments.
  </p>

  <div class="luxury-babies-divider">
    <i></i>
    <span>✦</span>
    <i></i>
  </div>

</header>


{% assign babies_collection = collections['babies'] %}


<!-- PRODUCTS -->
<div class="luxury-babies-grid">

  {% for product in babies_collection.products %}

    <article class="luxury-baby-card">

      <!-- IMAGE -->
      <a
        href="{{ product.url }}"
        class="luxury-baby-image-link"
      >

        <div class="luxury-baby-image">

          <div class="image-shine"></div>

          {% if product.featured_image %}

            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >

          {% else %}

            <div class="luxury-image-placeholder">
              <span>♡</span>
            </div>

          {% endif %}


          <div class="luxury-view-pill">
            <span>VIEW COLLECTION</span>
            <b>→</b>
          </div>

        </div>

      </a>


      <!-- INFO -->
      <div class="luxury-baby-info">

        {% if product.selected_or_first_available_variant.sku != blank %}

          <div class="luxury-sku">
            <span>ITEM</span>
            {{ product.selected_or_first_available_variant.sku }}
          </div>

        {% endif %}


        <h3 class="luxury-product-title">
          <a href="{{ product.url }}">
            {{ product.title }}
          </a>
        </h3>


        <div class="luxury-product-meta">

          <div class="luxury-price">
            {{ product.price | money }}
          </div>

          {% if product.selected_or_first_available_variant.available %}

            <div class="luxury-stock">
              <span class="stock-dot"></span>
              In Stock
            </div>

          {% endif %}

        </div>


        <div class="luxury-actions">

          <!-- DETAILS -->
          <a
            href="{{ product.url }}"
            class="luxury-details-btn"
          >
            <span>Explore Product</span>
            <b>↗</b>
          </a>


          <!-- CART -->
          <form
            method="post"
            action="/cart/add"
            class="luxury-cart-form"
          >

            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
            >


            <button
              type="submit"
              class="luxury-cart-btn"
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >

              {% if product.selected_or_first_available_variant.available %}

                <span class="cart-plus">+</span>
                <span>Add To Cart</span>

              {% else %}

                <span>Sold Out</span>

              {% endif %}

            </button>

          </form>

        </div>

      </div>

    </article>


  {% else %}


    <!-- EMPTY -->
    <div class="luxury-empty-products">

      <div class="empty-heart">♡</div>

      <div class="luxury-babies-badge">
        <span></span>
        COMING SOON
        <span></span>
      </div>

      <h2>
        Something Beautiful Is Coming
      </h2>

      <p>
        Our new collection for little ones is being prepared with love.
      </p>

      <a href="/" class="empty-home-btn">ac
        Return Home
      </a>

    </div>


  {% endfor %}

</div>

</div> </section> <style> /* ===================================================== LUXURY BABIES COLLECTION ===================================================== */ .luxury-babies-products { width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; padding: 55px 0 100px; overflow: hidden; background: radial-gradient( circle at 5% 5%, rgba(205, 164, 116, .13), transparent 28% ), radial-gradient( circle at 95% 35%, rgba(23, 59, 95, .07), transparent 30% ), linear-gradient( 135deg, #fcfaf7 0%, #f7f2eb 48%, #fbf9f6 100% ); color: #173b5f; } .luxury-babies-products *, .luxury-babies-products *::before, .luxury-babies-products *::after { box-sizing: border-box; } /* ===================================================== CONTAINER ===================================================== */ .luxury-babies-container { width: 100%; max-width: 1380px; margin: 0 auto; padding: 0 35px; } /* ===================================================== BACK BUTTON ===================================================== */ .luxury-back-btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; height: 44px; padding: 0 17px; border: 1px solid #ded5ca; border-radius: 40px; background: rgba(255,255,255,.65); color: #173b5f; text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: .5px; backdrop-filter: blur(12px); box-shadow: 0 5px 20px rgba(40,30,20,.04); transition: .35s ease; margin-bottom: 48px; } .luxury-back-btn .back-arrow { font-size: 20px; line-height: 1; transition: transform .35s ease; } .luxury-back-btn:hover { background: #173b5f; border-color: #173b5f; color: #fff; transform: translateX(-3px); box-shadow: 0 10px 25px rgba(23,59,95,.18); } .luxury-back-btn:hover .back-arrow { transform: translateX(-3px); } /* ===================================================== HEADER ===================================================== */ .luxury-babies-header { max-width: 780px; margin: 0 auto 65px; text-align: cente