nter; padding: 20px; overflow: hidden; background: linear-gradient( 145deg, #faf7f2 0%, #f1ebe2 100% ); } .luxury-baby-image img { display: block; width: 100%; height: 100%; object-fit: contain; position: relative; z-index: 2; transition: transform .7s cubic-bezier(.2,.7,.2,1); } .luxury-baby-card:hover .luxury-baby-image img { transform: scale(1.065); } /* ===================================================== IMAGE SHINE ===================================================== */ .image-shine { position: absolute; z-index: 3; top: -120%; left: -80%; width: 50%; height: 300%; transform: rotate(25deg); background: linear-gradient( 90deg, transparent, rgba(255,255,255,.38), transparent ); transition: left .8s ease; pointer-events: none; } .luxury-baby-card:hover .image-shine { left: 130%; } /* ===================================================== VIEW PILL ===================================================== */ .luxury-view-pill { position: absolute; z-index: 5; left: 50%; bottom: 17px; transform: translate(-50%, 16px); display: flex; align-items: center; gap: 12px; padding: 10px 15px; white-space: nowrap; background: rgba(255,255,255,.94); border: 1px solid rgba(255,255,255,.8); border-radius: 50px; color: #173b5f; font-size: 8px; font-weight: 800; letter-spacing: 1.8px; box-shadow: 0 8px 25px rgba(0,0,0,.09); opacity: 0; backdrop-filter: blur(10px); transition: .4s ease; } .luxury-view-pill b { font-size: 14px; line-height: 1; transition: transform .3s ease; } .luxury-baby-card:hover .luxury-view-pill { opacity: 1; transform: translate(-50%, 0); } .luxury-baby-card:hover .luxury-view-pill b { transform: translateX(3px); } /* ===================================================== INFO ===================================================== */ .luxury-baby-info { padding: 21px 20px 22px; } /* ===================================================== SKU ===================================================== */ .luxury-sku { margin-bottom: 9px; color: #aaa096; font-size: 8px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; } .luxury-sku span { color: #c09369; margin-right: 4px; } /* ===================================================== TITLE ===================================================== */ .luxury-product-title { margin: 0; min-height: 47px; font-size: 17px; line-height: 1.4; font-weight: 600; color: #202b36; } .luxury-product-title a { color: inherit; text-decoration: none; transition: color .3s ease; } .luxury-product-title a:hover { color: #b0784d; } /* ===================================================== META ===================================================== */ .luxury-product-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 12px 0 17px; } /* price */ .luxury-price { color: #a9683d; font-size: 20px; font-weight: 800; letter-spacing: .2px; } /* stock */ .luxury-stock { display: flex; align-items: center; gap: 5px; color: #719073; font-size: 8px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; } .stock-dot { width: 6px; height: 6px; border-radius: 50%; background: #7baa7b; box-shadow: 0 0 0 3px rgba(123,170,123,.12); } /* ===================================================== ACTIONS ===================================================== */ .luxury-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; } .luxury-details-btn, .luxury-cart-btn { min-height: 45px; border-radius: 9px; font-family: inherit; font-size: 10px; font-weight: 800; letter-spacing: .4px; transition: all .3s ease; } /* details */ .luxury-details-btn { display: flex; align-items: center; justify-content: center; gap: 7px; background: #173b5f; color: #fff; text-decoration: none; } .luxury-details-btn b { font-size: 14px; font-weight: 400; transition: transform .3s ease; } .luxury-details-btn:hover { background: #0e2d49; box-shadow: 0 7px 18px rgba(23,59,95,.18); } .luxury-details-btn:hover b { transform: translate(2px,-2px); } /* cart */ .luxury-cart-form { margin: 0; } .luxury-cart-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; background: #fff; color: #9a6946; border: 1px solid #d9c4af; cursor: pointer; } .luxury-cart-btn:hover { background: #f8efe6; border-color: #cba987; color: #815437; } .cart-plus { width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid currentColor; border-radius: 50%; font-size: 13px; font-weight: 400; } .luxury-cart-btn:disabled { background: #f2efeb; color: #aaa49d; border-color: #e3ddd6; cursor: not-allowed; } /* ===================================================== PLACEHOLDER ===================================================== */ .luxury-image-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #eee8df; } .luxury