{% stylesheet %}

.announcement-bar {

  width: 99.4vw;

  position: relative;

  left: 50%;
  right: 50%;

  margin-left: -50vw;
  margin-right: -50vw;

  height: 38px;

  display: flex;
  align-items: center;

  overflow: hidden;

  white-space: nowrap;

  color: #ffffff;

  background:
    linear-gradient(
      90deg,
      #111111,
      #1b1b1b,
      #111111
    );

  border-bottom: 1px solid rgba(255,255,255,0.08);

}


/* GOLD TOP LINE */

.announcement-bar::before {

  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 1px;

  background: #d8b56a;

}


/* MARQUEE */

.announcement-bar__track {

  display: flex;

  width: max-content;

  align-items: center;

  /* Same smooth movement style as your original */

  animation: marquee 20s linear infinite;

}


/* CONTENT */

.announcement-bar__content {

  display: flex;

  align-items: center;

  flex-shrink: 0;

}


/* TEXT */

.announcement-item {

  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding-right: 80px;

  font-size: 12px;

  font-weight: 500;

  letter-spacing: 0.5px;

  color: #eeeeee;

}


/* GOLD TEXT */

.announcement-item strong {

  color: #e4c477;

  font-weight: 700;

}


/* ICON */

.announcement-icon {

  color: #e4c477;

  font-size: 11px;

}


/* DIVIDER */

.announcement-divider {

  color: #777777;

  font-size: 9px;

  margin-right: 80px;

}


/* ARROW */

.announcement-arrow {

  color: #e4c477;

  font-size: 14px;

  margin-left: 3px;

}


/* =========================================
   ORIGINAL MARQUEE MOVEMENT
========================================= */

@keyframes marquee {

  from {

    transform: translateX(0);

  }

  to {

    transform: translateX(-50%);

  }

}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 768px) {

  .announcement-bar {

    height: 36px;

  }

  .announcement-bar__track {

    animation-duration: 15s;

  }

  .announcement-item {

    font-size: 11px;

    padding-right: 50px;

  }

  .announcement-divider {

    margin-right: 50px;

  }

}


/* =========================================
   SMALL MOBILE
========================================= */

@media screen and (max-width: 480px) {

  .announcement-bar {

    height: 34px;

  }

  .announcement-item {

    font-size: 10px;

    font-weight: 500;

  }

}

{% endstylesheet %}


