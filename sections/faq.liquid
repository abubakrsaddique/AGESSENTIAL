<style>
  .faq-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 20px 80px;
    color: #222;
    font-family: inherit;
  }

  .faq-page__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .faq-page__eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #777;
  }

  .faq-page__title {
    margin: 0 0 15px;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -1px;
  }

  .faq-page__intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
    color: #666;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid #e8e8e8;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
    transition: box-shadow .2s ease, border-color .2s ease;
  }

  .faq-item:hover {
    border-color: #dcdcdc;
    box-shadow: 0 5px 20px rgba(0, 0, 0, .04);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 21px 22px;
    border: 0;
    background: transparent;
    color: #222;
    text-align: left;
    cursor: pointer;
    font: inherit;
  }

  .faq-question__icon {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #f5f5f5;
  }

  .faq-question__icon svg {
    width: 19px;
    height: 19px;
    stroke: currentColor;
  }

  .faq-question__text {
    flex: 1;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 600;
  }

  .faq-question__arrow {
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform .25s ease;
  }

  .faq-question__arrow svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
  }

  .faq-item.is-open .faq-question__arrow {
    transform: rotate(180deg);
  }

  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .3s ease;
  }

  .faq-answer__inner {
    overflow: hidden;
  }

  .faq-answer__content {
    padding: 0 22px 22px 76px;
    color: #666;
    font-size: 15px;
    line-height: 1.8;
  }

  .faq-answer__content p {
    margin: 0;
  }

  .faq-item.is-open .faq-answer {
    grid-template-rows: 1fr;
  }

  .faq-contact {
    margin-top: 45px;
    padding: 32px;
    text-align: center;
    border-radius: 15px;
    background: #f7f7f7;
  }

  .faq-contact__icon {
    width: 46px;
    height: 46px;
    margin: 0 auto 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
  }

  .faq-contact__icon svg {
    width: 22px;
    height: 22px;
  }

  .faq-contact h2 {
    margin: 0 0 8px;
    font-size: 21px;
  }

  .faq-contact p {
    margin: 0 0 18px;
    color: #666;
    font-size: 15px;
    line-height: 1.7;
  }

  .faq-contact a {
    color: #222;
    font-weight: 600;
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .faq-page {
      padding: 40px 16px 55px;
    }

    .faq-page__header {
      margin-bottom: 32px;
    }

    .faq-question {
      padding: 17px;
      gap: 12px;
    }

    .faq-question__icon {
      flex: 0 0 34px;
      width: 34px;
      height: 34px;
    }

    .faq-question__text {
      font-size: 15px;
    }

    .faq-answer__content {
      padding: 0 17px 19px 63px;
      font-size: 14px;
    }

    .faq-contact {
      padding: 26px 20px;
    }
  }
</style>

<div class="faq-page">

  <!-- Header -->
  <header class="faq-page__header">
    <span class="faq-page__eyebrow">AGESSENTAILS</span>

    <h1 class="faq-page__title">
      Frequently Asked Questions
    </h1>

    <p class="faq-page__intro">
      Find answers to the most common questions about our products,
      orders, delivery, payments, returns, and more.
    </p>
  </header>


  <!-- FAQ List -->
  <div class="faq-list">

    <!-- FAQ 1 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <path d="M6 3h12v18H6z"></path>
            <path d="M9 7h6M9 11h6M9 15h4"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          How can I place an order?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              You can place an order directly through our website.
              Browse the products you want, add them to your cart,
              proceed to checkout, and provide your delivery details.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 2 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 10h18"></path>
            <path d="M7 15h4"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          What payment methods do you accept?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              We offer Cash on Delivery (COD) where available.
              Payment options may vary depending on your location
              and the available courier service.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 3 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <path d="M3 6h11v11H3z"></path>
            <path d="M14 9h4l3 3v5h-7z"></path>
            <circle cx="7" cy="19" r="2"></circle>
            <circle cx="18" cy="19" r="2"></circle>
          </svg>
        </span>

        <span class="faq-question__text">
          Do you offer delivery across Pakistan?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              Yes. We currently offer delivery within Pakistan.
              Delivery availability and delivery time may vary depending
              on your location and courier service.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 4 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          How long does delivery take?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              Delivery times may vary depending on your location,
              courier availability, weather conditions, public holidays,
              and other circumstances. Estimated delivery information
              will be communicated with your order.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 5 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <path d="M20 6L9 17l-5-5"></path>
            <circle cx="12" cy="12" r="9"></circle>
          </svg>
        </span>

        <span class="faq-question__text">
          Will I receive an order confirmation?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              Yes. After placing an order, AGESSENTAILS may contact you
              to confirm your order and delivery details.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 6 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <path d="M4 4h16v12H8l-4 4V4z"></path>
            <path d="M8 9h8M8 12h5"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          Can I change my delivery information after ordering?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              Please contact us as soon as possible if you need to update
              your delivery information. Once an order has been shipped,
              changes may no longer be possible.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 7 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"></path>
            <path d="M3 7l9 4 9-4M12 11v10"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          What should I do if my package arrives damaged?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              Please inspect your package when you receive it. If the package
              appears damaged or you receive an incorrect or defective item,
              contact us as soon as possible with your order number and
              clear photos or videos of the issue.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 8 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <path d="M12 3L2.5 20h19L12 3z"></path>
            <path d="M12 9v5"></path>
            <path d="M12 17h.01"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          What happens if I provide an incorrect address?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              Customers are responsible for providing accurate delivery
              information. If an order cannot be delivered because of an
              incorrect or incomplete address, additional delivery charges
              may apply if the order needs to be re-shipped.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 9 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <path d="M4 4h16v16H4z"></path>
            <path d="M8 9h8M8 13h8M8 17h5"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          How can I return an item?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              For information about returning an item, please visit our
              Return &amp; Refund Policy page for the applicable return
              requirements and process.
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- FAQ 10 -->
    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">

        <span class="faq-question__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
        </span>

        <span class="faq-question__text">
          How can I contact AGESSENTAILS?
        </span>

        <span class="faq-question__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>

      </button>

      <div class="faq-answer">
        <div class="faq-answer__inner">
          <div class="faq-answer__content">
            <p>
              You can contact us by email at
              <a href="mailto:agessentials.pk@gmail.com">
                agessentials.pk@gmail.com
              </a>
              for questions about your order, delivery, returns, or other
              inquiries.
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>


  <!-- Contact Box -->
  <div class="faq-contact">

    <div class="faq-contact__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 4h16v12H8l-4 4V4z"></path>
        <path d="M8 9h8M8 12h5"></path>
      </svg>
    </div>

    <h2>Still Have Questions?</h2>

    <p>
      If you cannot find the answer you are looking for, feel free to
      contact our support team.
    </p>

    <a href="mailto:agessentials.pk@gmail.com">
      agessentials.pk@gmail.com
    </a>

  </div>

</div>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(function (item) {
      const button = item.querySelector('.faq-question');

      button.addEventListener('click', function () {
        const isOpen = item.classList.contains('is-open');

        faqItems.forEach(function (otherItem) {
          otherItem.classList.remove('is-open');

          const otherButton = otherItem.querySelector('.faq-question');

          if (otherButton) {
            otherButton.setAttribute('aria-expanded', 'false');
          }
        });

        if (!isOpen) {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

