<div
  class="custom-section custom-section--{{ section.id }} full-width"
  style="
    --custom-bg: {{ section.settings.background_color }};
    --custom-overlay: {{ section.settings.overlay_color }};
    --custom-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --custom-content-width: {{ section.settings.content_width }}px;
    --custom-padding-top: {{ section.settings.padding_top }}px;
    --custom-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  {% if section.settings.background_image %}
    <div class="custom-section__background">

      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          class: 'custom-section__background-image'
      }}

    </div>
  {% endif %}

  <div class="custom-section__overlay"></div>

  <div class="custom-section__inner">

    <div class="custom-section__content">
      {% content_for 'blocks' %}
    </div>

  </div>

</div>


{% stylesheet %}

  .custom-section {
    position: relative;
    width: 100%;
    overflow: hidden;

    background: var(--custom-bg);

    padding-top: var(--custom-padding-top);
    padding-bottom: var(--custom-padding-bottom);

    isolation: isolate;
  }


  /* =========================
     BACKGROUND
  ========================= */

  .custom-section__background {
    position: absolute;
    inset: 0;
    z-index: -2;

    overflow: hidden;
  }

  .custom-section__background-image {
    position: absolute;

    width: 100%;
    height: 100%;

    inset: 0;

    display: block;

    object-fit: cover;
    object-position: center center;
  }


  /* =========================
     OVERLAY
  ========================= */

  .custom-section__overlay {
    position: absolute;
    inset: 0;

    z-index: -1;

    background: var(--custom-overlay);

    opacity: var(--custom-overlay-opacity);

    pointer-events: none;
  }


  /* =========================
     INNER CONTAINER
  ========================= */

  .custom-section__inner {
    width: 100%;
    max-width: var(--custom-content-width);

    margin: 0 auto;

    padding-left: 24px;
    padding-right: 24px;

    box-sizing: border-box;
  }


  /* =========================
     CONTENT
  ========================= */

  .custom-section__content {
    width: 100%;

    display: grid;
    grid-template-columns: var(--content-grid);

    position: relative;
    z-index: 2;
  }

  .custom-section__content > * {
    grid-column: 2;
  }


  /* =========================
     PREMIUM BLOCK SPACING
  ========================= */

  .custom-section__content > * {
    margin-top: 0;
  }


  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 749px) {

    .custom-section {
      padding-top: max(45px, calc(var(--custom-padding-top) * .7));
      padding-bottom: max(45px, calc(var(--custom-padding-bottom) * .7));
    }

    .custom-section__inner {
      padding-left: 18px;
      padding-right: 18px;
    }

    .custom-section__content {
      grid-template-columns: 1fr;
    }

    .custom-section__content > * {
      grid-column: 1;
    }

    .custom-section__background-image {
      object-position: center center;
    }

  }


  /* =========================
     LARGE SCREENS
  ========================= */

  @media screen and (min-width: 1400px) {

    .custom-section__inner {
      padding-left: 40px;
      padding-right: 40px;
    }

  }


{% endstylesheet %}


{% schema %}
{
  "name": "Premium Custom Section",

  "blocks": [
    {
      "type": "@theme"
    }
  ],

  "settings": [

    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFF9F1"
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image Overlay Color",
      "default": "#FFFFFF"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image Overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 10
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content Maximum Width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1400
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    }

  ],

  "presets": [
    {
      "name": "Premium Custom Section"
    }
  ]
}
{% endschema %}
