{% comment %}
  AGESSENTIAL — Premium AJAX Cart
{% endcomment %}

<section class="ag-premium-cart">

  <div class="ag-cart-container">

    <!-- Header -->
    <div class="ag-cart-header">

      <div>
        <span class="ag-cart-eyebrow">
          YOUR SHOPPING BAG
        </span>

        <h1>
          Your Cart
        </h1>

        {% unless cart.empty? %}
          <p>
            {{ cart.item_count }} 
            {% if cart.item_count == 1 %}item{% else %}items{% endif %}
            ready for checkout
          </p>
        {% endunless %}
      </div>

      {% unless cart.empty? %}
        <a href="/" class="ag-continue-top">
          <span>←</span>
          Continue Shopping
        </a>
      {% endunless %}

    </div>


    {% if cart.empty? %}

      <!-- Empty Cart -->

      <div class="ag-empty-cart">

        <div class="ag-empty-icon">
          🛍️
        </div>

        <span class="ag-empty-small">
          SHOPPING BAG
        </span>

        <h2>
          Your cart is waiting
        </h2>

        <p>
          Looks like you haven't added anything yet.
          Discover something special and start shopping.
        </p>

        <a href="/" class="ag-primary-btn">
          Explore Products
          <span>→</span>
        </a>

      </div>


    {% else %}

      <div class="ag-cart-layout">


        <!-- Cart Items -->

        <div class="ag-cart-products">

          <div class="ag-items-top">

            <h2>
              Shopping Bag
            </h2>

            <span>
              {{ cart.item_count }}
              {% if cart.item_count == 1 %}Product{% else %}Products{% endif %}
            </span>

          </div>


          {% for item in cart.items %}

            <div
              class="ag-cart-item"
              data-cart-item="{{ item.key }}"
            >

              <!-- Product Image -->

              <div class="ag-product-image">

                <a href="{{ item.url }}">

                  {% if item.image %}

                    <img
                      src="{{ item.image | image_url: width: 500 }}"
                      alt="{{ item.product.title | escape }}"
                      loading="lazy"
                    >

                  {% else %}

                    <div class="ag-no-image">
                      No Image
                    </div>

                  {% endif %}

                </a>

              </div>


              <!-- Product Information -->

              <div class="ag-product-info">

                <div class="ag-product-top">

                  <div>

                    <span class="ag-product-label">
                      AGESSENTIAL
                    </span>

                    <h3>
                      <a href="{{ item.url }}">
                        {{ item.product.title }}
                      </a>
                    </h3>

                  </div>

                  <button
                    type="button"
                    class="ag-remove"
                    data-remove-key="{{ item.key }}"
                    aria-label="Remove {{ item.product.title | escape }}"
                  >
                    ×
                  </button>

                </div>


                {% unless item.product.has_only_default_variant %}

                  <div class="ag-variant">
                    {{ item.variant.title }}
                  </div>

                {% endunless %}


                <div class="ag-product-bottom">

                  <div class="ag-item-price">

                    {{ item.final_price | money }}

                    {% if item.original_price > item.final_price %}

                      <del>
                        {{ item.original_price | money }}
                      </del>

                    {% endif %}

                  </div>


                  <!-- Quantity -->

                  <div class="ag-quantity-wrap">

                    <span>
                      Quantity
                    </span>

                    <div class="ag-quantity-box">

                      <button
                        type="button"
                        class="ag-qty-btn ag-qty-minus"
                        aria-label="Decrease quantity"
                      >
                        −
                      </button>

                      <input
                        type="number"
                        class="ag-quantity"
                        value="{{ item.quantity }}"
                        min="0"
                        data-key="{{ item.key }}"
                        aria-label="Quantity"
                      >

                      <button
                        type="button"
                        class="ag-qty-btn ag-qty-plus"
                        aria-label="Increase quantity"
                      >
                        +
                      </button>

                    </div>

                  </div>


                  <div class="ag-line-total">

                    {{ item.final_line_price | money }}

                  </div>

                </div>

              </div>

            </div>

          {% endfor %}


          <!-- Secure Note -->

          <div class="ag-secure-note">

            <div class="ag-secure-icon">
              ✓
            </div>

            <div>
              <strong>
                Shop with confidence
              </strong>

              <p>
                Your cart is secure and your information is protected.
              </p>
            </div>

          </div>

        </div>


        <!-- Summary -->

        <aside class="ag-summary">

          <div class="ag-summary-inner">

            <div class="ag-summary-title">

              <div>
                <span>
                  ORDER
                </span>

                <h2>
                  Summary
                </h2>
              </div>

              <div class="ag-summary-bag">
                🛒
              </div>

            </div>


            <!-- Summary Rows -->

            <div class="ag-summary-row">

              <span>
                Subtotal
              </span>

              <strong id="ag-cart-total">
                {{ cart.total_price | money }}
              </strong>

            </div>


            <div class="ag-summary-row ag-shipping-row">

              <span>
                Shipping
              </span>

              <strong>
                Calculated at checkout
              </strong>

            </div>


            <div class="ag-summary-divider"></div>


            <div class="ag-total-row">

              <div>

                <span>
                  Total
                </span>

                <small>
                  Taxes & shipping calculated at checkout
                </small>

              </div>

              <strong id="ag-final-total">
                {{ cart.total_price | money }}
              </strong>

            </div>


            <!-- Checkout -->

            <a
              href="/checkout"
              class="ag-checkout-btn"
              id="ag-checkout"
            >

              <span>
                Secure Checkout
              </span>

              <b>
                →
              </b>

            </a>


            <a
              href="/"
              class="ag-shopping-btn"
            >
              Continue Shopping
            </a>


            <!-- Trust -->

            <div class="ag-trust">

              <div>
                <span>🔒</span>
                <small>Secure</small>
              </div>

              <div>
                <span>✓</span>
                <small>Trusted</small>
              </div>

              <div>
                <span>★</span>
                <small>Quality</small>
              </div>

            </div>

          </div>

        </aside>

      </div>

    {% endif %}

  </div>

</section>


<style>

/* =========================================
   AGESSENTIAL PREMIUM CART
========================================= */

.ag-premium-cart {
  width: 100%;

  padding: 70px 0 90px;

  background:
    radial-gradient(
      circle at 5% 10%,
      rgba(255, 107, 0, .08),
      transparent 25%
    ),
    radial-gradient(
      circle at 95% 20%,
      rgba(18, 86, 160, .08),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      #fffaf3 0%,
      #ffffff 48%,
      #f5f9ff 100%
    );

  min-height: 600px;
}


.ag-cart-container {
  width: 100%;
  max-width: 1240px;

  margin: auto;

  padding: 0 25px;
}


/* =========================================
   HEADER
========================================= */

.ag-cart-header {
  display: flex;

  justify-content: space-between;
  align-items: flex-end;

  gap: 25px;

  margin-bottom: 45px;
}


.ag-cart-eyebrow {
  display: block;

  color: #ff6b00;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: 2px;

  margin-bottom: 9px;
}


.ag-cart-header h1 {
  margin: 0;

  color: #171717;

  font-size: clamp(40px, 5vw, 58px);

  line-height: 1;

  font-weight: 900;

  letter-spacing: -2px;
}


.ag-cart-header p {
  margin: 12px 0 0;

  color: #777;

  font-size: 14px;
}


.ag-continue-top {
  display: inline-flex;

  align-items: center;

  gap: 9px;

  padding: 11px 17px;

  border-radius: 50px;

  color: #1256a0;

  background: rgba(18, 86, 160, .07);

  border: 1px solid rgba(18, 86, 160, .12);

  text-decoration: none;

  font-size: 13px;
  font-weight: 700;

  transition: .3s ease;
}


.ag-continue-top span {
  font-size: 18px;

  transition: transform .3s ease;
}


.ag-continue-top:hover {
  color: white;
  background: #1256a0;

  transform: translateY(-2px);
}


.ag-continue-top:hover span {
  transform: translateX(-4px);
}


/* =========================================
   CART LAYOUT
========================================= */

.ag-cart-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1.65fr)
    minmax(330px, .75fr);

  gap: 35px;

  align-items: start;
}


/* =========================================
   PRODUCTS
========================================= */

.ag-cart-products {
  min-width: 0;
}


.ag-items-top {
  display: flex;

  justify-content: space-between;
  align-items: center;

  margin-bottom: 16px;

  padding: 0 5px;
}


.ag-items-top h2 {
  margin: 0;

  font-size: 21px;

  color: #222;

  font-weight: 800;
}


.ag-items-top span {
  padding: 6px 12px;

  background: #fff;

  border: 1px solid #eee;

  border-radius: 50px;

  color: #777;

  font-size: 11px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .5px;
}


/* =========================================
   CART CARD
========================================= */

.ag-cart-item {
  position: relative;

  display: flex;

  align-items: center;

  gap: 24px;

  padding: 20px;

  margin-bottom: 15px;

  background: rgba(255,255,255,.86);

  border: 1px solid rgba(0,0,0,.06);

  border-radius: 22px;

  box-shadow:
    0 8px 30px rgba(0,0,0,.045);

  transition:
    transform .3s ease,
    box-shadow .3s ease,
    border-color .3s ease;
}


.ag-cart-item:hover {
  transform: translateY(-3px);

  border-color: rgba(18,86,160,.13);

  box-shadow:
    0 15px 40px rgba(0,0,0,.08);
}


/* Product Image */

.ag-product-image {
  width: 145px;
  height: 145px;

  flex: 0 0 145px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 10px;

  background:
    linear-gradient(
      145deg,
      #fff,
      #f5f8fc
    );

  border-radius: 17px;

  overflow: hidden;
}


.ag-product-image a {
  width: 100%;
  height: 100%;

  display: flex;

  align-items: center;
  justify-content: center;
}


.ag-product-image img {
  width: 100%;
  height: 100%;

  object-fit: contain;

  transition: transform .4s ease;
}


.ag-cart-item:hover .ag-product-image img {
  transform: scale(1.06);
}


.ag-no-image {
  color: #aaa;

  font-size: 12px;
}


/* =========================================
   PRODUCT INFO
========================================= */

.ag-product-info {
  flex: 1;

  min-width: 0;
}


.ag-product-top {
  display: flex;

  justify-content: space-between;

  gap: 15px;
}


.ag-product-label {
  display: block;

  color: #ff6b00;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 1.5px;

  margin-bottom: 5px;
}


.ag-product-info h3 {
  margin: 0;

  font-size: 19px;

  line-height: 1.35;

  font-weight: 750;

  color: #202020;
}


.ag-product-info h3 a {
  color: inherit;

  text-decoration: none;

  transition: color .25s ease;
}


.ag-product-info h3 a:hover {
  color: #1256a0;
}


.ag-variant {
  margin-top: 7px;

  color: #888;

  font-size: 12px;
}


/* Remove */

.ag-remove {
  width: 34px;
  height: 34px;

  flex: 0 0 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 0;

  background: #f7f7f7;

  color: #888;

  border-radius: 50%;

  cursor: pointer;

  font-size: 22px;

  line-height: 1;

  transition: .25s ease;
}


.ag-remove:hover {
  background: #fff0ee;

  color: #df2e20;

  transform: rotate(90deg);
}


/* =========================================
   PRODUCT BOTTOM
========================================= */

.ag-product-bottom {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 20px;

  margin-top: 25px;
}


.ag-item-price {
  color: #e05000;

  font-size: 19px;

  font-weight: 850;
}


.ag-item-price del {
  display: block;

  color: #aaa;

  font-size: 11px;

  font-weight: 500;

  margin-top: 3px;
}


/* Quantity */

.ag-quantity-wrap {
  display: flex;

  flex-direction: column;

  gap: 6px;
}


.ag-quantity-wrap > span {
  color: #999;

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: .7px;
}


.ag-quantity-box {
  display: flex;

  align-items: center;

  height: 39px;

  background: #f6f8fb;

  border: 1px solid #e8ebef;

  border-radius: 10px;

  overflow: hidden;
}


.ag-qty-btn {
  width: 38px;
  height: 38px;

  border: 0;

  background: transparent;

  color: #1256a0;

  font-size: 20px;

  font-weight: 700;

  cursor: pointer;

  transition: .2s ease;
}


.ag-qty-btn:hover {
  background: #1256a0;

  color: white;
}


.ag-quantity {
  width: 40px;

  height: 38px;

  padding: 0;

  border: 0;

  outline: none;

  background: transparent;

  text-align: center;

  color: #222;

  font-size: 14px;

  font-weight: 700;

  -moz-appearance: textfield;
}


.ag-quantity::-webkit-outer-spin-button,
.ag-quantity::-webkit-inner-spin-button {
  -webkit-appearance: none;

  margin: 0;
}


.ag-line-total {
  color: #222;

  font-size: 17px;

  font-weight: 800;

  min-width: 80px;

  text-align: right;
}


/* =========================================
   SECURE NOTE
========================================= */

.ag-secure-note {
  display: flex;

  align-items: center;

  gap: 13px;

  margin-top: 20px;

  padding: 17px 20px;

  background: rgba(18,86,160,.055);

  border: 1px solid rgba(18,86,160,.08);

  border-radius: 15px;
}


.ag-secure-icon {
  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex: 0 0 34px;

  background: #1256a0;

  color: white;

  border-radius: 50%;

  font-weight: 800;
}


.ag-secure-note strong {
  display: block;

  color: #222;

  font-size: 13px;
}


.ag-secure-note p {
  margin: 3px 0 0;

  color: #777;

  font-size: 11px;
}


/* =========================================
   SUMMARY
========================================= */

.ag-summary {
  position: sticky;

  top: 25px;
}


.ag-summary-inner {
  padding: 28px;

  background: rgba(255,255,255,.9);

  border: 1px solid rgba(255,255,255,.9);

  border-radius: 24px;

  box-shadow:
    0 20px 60px rgba(18,50,80,.10);

  backdrop-filter: blur(15px);
}


.ag-summary-title {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 28px;
}


.ag-summary-title > div:first-child > span {
  color: #ff6b00;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.5px;
}


.ag-summary-title h2 {
  margin: 4px 0 0;

  color: #1c1c1c;

  font-size: 25px;

  font-weight: 850;
}


.ag-summary-bag {
  width: 48px;
  height: 48px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background: #edf4fc;

  font-size: 20px;
}


/* Summary Rows */

.ag-summary-row {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 15px;

  color: #666;

  font-size: 14px;
}


.ag-summary-row strong {
  color: #222;

  font-size: 15px;
}


.ag-shipping-row strong {
  max-width: 150px;

  color: #888;

  font-size: 11px;

  font-weight: 500;

  text-align: right;
}


.ag-summary-divider {
  height: 1px;

  margin: 22px 0;

  background: #eee;
}


/* Total */

.ag-total-row {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  margin-bottom: 25px;
}


.ag-total-row span {
  display: block;

  color: #222;

  font-size: 16px;

  font-weight: 800;
}


.ag-total-row small {
  display: block;

  max-width: 160px;

  margin-top: 4px;

  color: #999;

  font-size: 9px;

  line-height: 1.4;
}


.ag-total-row strong {
  color: #e05000;

  font-size: 25px;

  font-weight: 900;

  white-space: nowrap;
}


/* =========================================
   BUTTONS
========================================= */

.ag-checkout-btn {
  position: relative;

  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  min-height: 55px;

  padding: 0 18px 0 22px;

  background:
    linear-gradient(
      135deg,
      #1256a0,
      #0c407d
    );

  color: white;

  text-decoration: none;

  border-radius: 13px;

  overflow: hidden;

  box-shadow:
    0 10px 25px rgba(18,86,160,.22);

  font-size: 15px;

  font-weight: 800;

  transition:
    transform .3s ease,
    box-shadow .3s ease;
}


.ag-checkout-btn::before {
  content: "";

  position: absolute;

  width: 100px;
  height: 100%;

  left: -130px;
  top: 0;

  background: rgba(255,255,255,.12);

  transform: skewX(-20deg);

  transition: left .5s ease;
}


.ag-checkout-btn:hover {
  transform: translateY(-3px);

  box-shadow:
    0 15px 35px rgba(18,86,160,.30);
}


.ag-checkout-btn:hover::before {
  left: 120%;
}


.ag-checkout-btn b {
  width: 30px;
  height: 30px;

  display: flex;

  align-items: center;
  justify-content: center;

  background: rgba(255,255,255,.15);

  border-radius: 50%;

  font-size: 18px;

  transition: transform .3s ease;
}


.ag-checkout-btn:hover b {
  transform: translateX(4px);
}


.ag-shopping-btn {
  display: block;

  width: 100%;

  margin-top: 11px;

  padding: 13px;

  color: #555;

  background: #f5f5f5;

  border-radius: 11px;

  text-align: center;

  text-decoration: none;

  font-size: 12px;

  font-weight: 700;

  transition: .25s ease;
}


.ag-shopping-btn:hover {
  color: #1256a0;

  background: #edf4fc;
}


/* =========================================
   TRUST
========================================= */

.ag-trust {
  display: grid;

  grid-template-columns: repeat(3,1fr);

  gap: 8px;

  margin-top: 22px;

  padding-top: 18px;

  border-top: 1px solid #eee;
}


.ag-trust div {
  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 5px;
}


.ag-trust span {
  color: #1256a0;

  font-size: 15px;
}


.ag-trust small {
  color: #888;

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .6px;
}


/* =========================================
   EMPTY CART
========================================= */

.ag-empty-cart {
  max-width: 650px;

  margin: 30px auto 0;

  padding: 70px 35px;

  text-align: center;

  background: rgba(255,255,255,.85);

  border: 1px solid rgba(0,0,0,.05);

  border-radius: 28px;

  box-shadow:
    0 20px 60px rgba(0,0,0,.07);
}


.ag-empty-icon {
  width: 80px;
  height: 80px;

  display: flex;

  align-items: center;
  justify-content: center;

  margin: 0 auto 20px;

  background: #fff2e7;

  border-radius: 25px;

  font-size: 35px;
}


.ag-empty-small {
  color: #ff6b00;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 2px;
}


.ag-empty-cart h2 {
  margin: 9px 0 10px;

  color: #202020;

  font-size: 29px;

  font-weight: 850;
}


.ag-empty-cart p {
  max-width: 430px;

  margin: 0 auto;

  color: #777;

  font-size: 14px;

  line-height: 1.7;
}


/* Primary */

.ag-primary-btn {
  display: inline-flex;

  align-items: center;

  gap: 15px;

  margin-top: 25px;

  padding: 14px 20px 14px 24px;

  background: #1256a0;

  color: white;

  border-radius: 50px;

  text-decoration: none;

  font-size: 13px;

  font-weight: 800;

  box-shadow: 0 10px 25px rgba(18,86,160,.20);

  transition: .3s ease;
}


.ag-primary-btn span {
  font-size: 18px;

  transition: transform .3s ease;
}


.ag-primary-btn:hover {
  background: #0b3c72;

  transform: translateY(-3px);
}


.ag-primary-btn:hover span {
  transform: translateX(4px);
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 1000px) {

  .ag-cart-layout {
    grid-template-columns: 1fr;
  }

  .ag-summary {
    position: static;

    order: -1;
  }

  .ag-summary-inner {
    max-width: 650px;

    margin: auto;
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 650px) {

  .ag-premium-cart {
    padding: 40px 0 60px;
  }

  .ag-cart-container {
    padding: 0 15px;
  }

  .ag-cart-header {
    align-items: flex-start;

    flex-direction: column;

    margin-bottom: 30px;
  }

  .ag-cart-header h1 {
    font-size: 39px;
  }

  .ag-continue-top {
    font-size: 12px;
  }

  .ag-cart-item {
    align-items: stretch;

    gap: 15px;

    padding: 14px;

    border-radius: 18px;
  }

  .ag-product-image {
    width: 100%;
    height: 190px;

    flex: none;

    border-radius: 14px;
  }

  .ag-product-top {
    gap: 8px;
  }

  .ag-product-info h3 {
    font-size: 16px;
  }

  .ag-product-bottom {
    flex-wrap: wrap;

    align-items: center;

    gap: 15px;

    margin-top: 18px;
  }

  .ag-item-price {
    font-size: 17px;
  }

  .ag-quantity-wrap {
    order: 3;
  }

  .ag-line-total {
    margin-left: auto;

    font-size: 15px;
  }

  .ag-summary-inner {
    padding: 21px;

    border-radius: 20px;
  }

  .ag-summary-title h2 {
    font-size: 22px;
  }

  .ag-total-row strong {
    font-size: 21px;
  }

  .ag-secure-note {
