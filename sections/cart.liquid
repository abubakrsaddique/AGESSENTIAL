  .ag-cart-header h1 {
    font-size: 34px;
  }

  .ag-product-image {
    height: 165px;
  }

  .ag-product-bottom {
    display: grid;

    grid-template-columns: 1fr 1fr;
  }

  .ag-quantity-wrap {
    order: initial;
  }

  .ag-line-total {
    margin-left: 0;

    text-align: right;
  }

}

</style>


<script>

(function () {

  const cartSection = document.querySelector('.ag-premium-cart');

  if (!cartSection) return;


  let updateTimer;


  function updateCart(inputElement) {

    clearTimeout(updateTimer);


    const value = Math.max(
      0,
      parseInt(inputElement.value) || 0
    );


    inputElement.value = value;


    updateTimer = setTimeout(function () {

      const key = inputElement.dataset.key;

      const itemCard = inputElement.closest('.ag-cart-item');


      if (itemCard) {
        itemCard.classList.add('ag-cart-loading');
      }


      const updates = {};

      document
        .querySelectorAll('.ag-premium-cart .ag-quantity')
        .forEach(function (input) {

          updates[input.dataset.key] =
            Math.max(0, parseInt(input.value) || 0);

        });


      fetch('/cart/update.js', {

        method: 'POST',

        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },

        body: JSON.stringify({
          updates: updates
        })

      })

      .then(function (response) {

        if (!response.ok) {
          throw new Error('Cart update failed');
        }

        return response.json();

      })

      .then(function (cart) {

        /*
          Reload the section so:
          - item count updates
          - removed items disappear
          - line totals update
          - subtotal updates
          - empty cart state works
        */

        window.location.reload();

      })

      .catch(function (error) {

        console.error('Cart error:', error);

        if (itemCard) {
          itemCard.classList.remove('ag-cart-loading');
        }

      });

    }, 250);

  }


  /* Quantity Buttons */

  cartSection.addEventListener('click', function (event) {

    const plus = event.target.closest('.ag-qty-plus');

    const minus = event.target.closest('.ag-qty-minus');

    const remove = event.target.closest('.ag-remove');


    if (plus) {

      const input =
        plus.closest('.ag-quantity-box')
            .querySelector('.ag-quantity');

      input.value =
        (parseInt(input.value) || 0) + 1;

      updateCart(input);

      return;
    }


    if (minus) {

      const input =
        minus.closest('.ag-quantity-box')
            .querySelector('.ag-quantity');

      const current =
        parseInt(input.value) || 0;


      if (current > 1) {

        input.value = current - 1;

        updateCart(input);

      }

      return;
    }


    /* Remove Item */

    if (remove) {

      const key =
        remove.dataset.removeKey;

      const input =
        cartSection.querySelector(
          '.ag-quantity[data-key="' + CSS.escape(key) + '"]'
        );


      if (input) {

        input.value = 0;

        updateCart(input);

      }

    }

  });


  /* Manual Quantity Input */

  cartSection.addEventListener('change', function (event) {

    if (
      event.target.classList.contains('ag-quantity')
    ) {

      updateCart(event.target);

    }

  });


  /* Enter Key */

  cartSection.addEventListener('keydown', function (event) {

    if (
      event.target.classList.contains('ag-quantity') &&
      event.key === 'Enter'
    ) {

      event.preventDefault();

      updateCart(event.target);

      event.target.blur();

    }

  });


})();

</script>


<style>

/* AJAX loading state */

.ag-cart-item {
  transition:
    opacity .25s ease,
    transform .3s ease,
    box-shadow .3s ease;
}

.ag-cart-item.ag-cart-loading {
  opacity: .55;

  pointer-events: none;
}

</style>


