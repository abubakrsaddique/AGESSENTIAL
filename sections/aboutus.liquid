<style>


*{
box-sizing:border-box;
}



.about-section{

width: 99.4vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;
padding:60px 0;
background:linear-gradient(
180deg,
#fff8e8,
#ffffff
);

overflow:hidden;

}

.back-btn{
    padding: 10px 15px 24px 15px;
    width: 60px;
    height: 30px;
    font-size: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1256a0;
    color: #fff;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 900;
    transition: .3s;
    margin-bottom: 20px;
    margin-top: -30px;
}

.back-btn:hover{
background:#0b3c72;
}


.about-section .page-width{

max-width:1200px;
margin:auto;
padding:0 20px;

}



.about-wrapper{

display:grid;
grid-template-columns:1fr 1fr;
gap:50px;
align-items:center;

}




.about-content h1{

font-size:48px;
color:#ff6b00;
margin-bottom:20px;

}



.about-content h2{

font-size:32px;
color:#222;
margin-bottom:20px;

}



.about-content p{

font-size:18px;
line-height:1.7;
color:#555;
margin-bottom:15px;

}




.about-boxes{

display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
margin-top:35px;

}




.box{

background:white;
padding:20px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.1);

}



.box h3{

font-size:20px;
color:#ff6b00;
margin-bottom:10px;

}



.box p{

font-size:15px;
margin:0;

}




.about-image img{

width:100%;
max-width:500px;
border-radius:25px;
object-fit:cover;

}




/* Tablet */

@media(max-width:900px){


.about-wrapper{

grid-template-columns:1fr;
text-align:center;

}



.about-content h1{

font-size:38px;

}



.about-content h2{

font-size:26px;

}



.about-boxes{

grid-template-columns:1fr 1fr;

}



.about-image{

order:-1;

}


}




/* Mobile */

@media(max-width:600px){


.about-section{

padding:40px 0;

}



.about-section .page-width{

padding:0 15px;

}



.about-content h1{

font-size:32px;

}



.about-content h2{

font-size:22px;

}



.about-content p{

font-size:16px;

}



.about-boxes{

grid-template-columns:1fr;

}



.about-image img{

border-radius:15px;

}


}


</style>




