{% comment %}
  AGESSENTIAL — Premium Product Page
{% endcomment %}

<section class="ag-premium-product">

  <div class="ag-product-container">

    <a
      href="#"
      class="ag-back-btn"
      onclick="history.back(); return false;"
      aria-label="Go back"
    >
      <span>←</span>
      <strong>Back</strong>
    </a>

    <div class="ag-product-layout">

      <!-- PRODUCT GALLERY -->

      <div
        class="ag-product-gallery"
        id="AGProductGallery-{{ section.id }}"
      >

        <div class="ag-gallery-main">

          {% if product.available %}

            <div class="ag-image-badge">
              <span>✓</span>
              In Stock
            </div>

          {% else %}

            <div class="ag-image-badge ag-sold-badge">
              Sold Out
            </div>

          {% endif %}


          {% if product.images.size > 1 %}

            <div class="ag-image-counter">
              <span class="ag-current-slide">01</span>
              <i>/</i>
              <span>
                {{ product.images.size | prepend: '0' }}
              </span>
            </div>

          {% endif %}


          {% for image in product.images %}

            <div
              class="ag-product-slide {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
            >

              <img
                src="{{ image | image_url: width: 1000 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                {% if forloop.first %}
                  loading="eager"
                {% else %}
                  loading="lazy"
                {% endif %}
              >

            </div>

          {% endfor %}


          {% if product.images.size == 0 %}

            <div class="ag-no-product-image">
              <span>AG</span>
              <p>No image available</p>
            </div>

          {% endif %}


          {% if product.images.size > 1 %}

            <button
              type="button"
              class="ag-slider-btn ag-prev"
              aria-label="Previous image"
            >
              ←
            </button>

            <button
              type="button"
              class="ag-slider-btn ag-next"
              aria-label="Next image"
            >
              →
            </button>

          {% endif %}

        </div>


        <!-- THUMBNAILS -->

        {% if product.images.size > 1 %}

          <div class="ag-thumbnails">

            {% for image in product.images %}

              <button
                type="button"
                class="ag-thumbnail {% if forloop.first %}active{% endif %}"
                data-index="{{ forloop.index0 }}"
                aria-label="View product image {{ forloop.index }}"
              >

                <img
                  src="{{ image | image_url: width: 250 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  loading="lazy"
                >

              </button>

            {% endfor %}

          </div>

        {% endif %}


        <!-- GALLERY TRUST -->

        <div class="ag-gallery-trust">

          <div>
            <span>✓</span>
            <p>Quality Checked</p>
          </div>

          <div>
            <span>🔒</span>
            <p>Secure Shopping</p>
          </div>

          <div>
            <span>★</span>
            <p>Customer First</p>
          </div>

        </div>

      </div>


      <!-- PRODUCT DETAILS -->

      <div class="ag-product-details">

        <div class="ag-product-brand">
          AGESSENTIAL
          <span></span>
          PREMIUM COLLECTION
        </div>


        <h1 class="ag-product-title">
          {{ product.title }}
        </h1>


        {% assign current_variant =
          product.selected_or_first_available_variant
        %}


        {% if current_variant.sku != blank %}

          <div class="ag-product-sku">

            <span>ITEM CODE</span>

            {{ current_variant.sku }}

          </div>

        {% endif %}


        <!-- PRICE -->

        <div class="ag-price-area">

          <div class="ag-product-price">
            {{ current_variant.price | money }}
          </div>


          {% if current_variant.compare_at_price > current_variant.price %}

            <div class="ag-old-price">
              {{ current_variant.compare_at_price | money }}
            </div>


            {% assign savings =
              current_variant.compare_at_price
              | minus: current_variant.price
            %}


            {% assign savings_percentage =
              savings
              | times: 100
              | divided_by: current_variant.compare_at_price
            %}


            <div class="ag-save-badge">
              SAVE {{ savings_percentage }}%
            </div>

          {% endif %}

        </div>


        <!-- STOCK -->

        {% if product.available %}

          <div class="ag-stock-status">

            <span class="ag-pulse"></span>

            <strong>In Stock</strong>

            <em>Ready to ship</em>

          </div>

        {% else %}

          <div class="ag-stock-status ag-stock-out">

            <span></span>

            <strong>Out of Stock</strong>

          </div>

        {% endif %}


        <!-- DESCRIPTION -->

        {% if product.description != blank %}

          <div class="ag-product-description">
            {{ product.description }}
          </div>

        {% endif %}


        <!-- PRODUCT FORM -->

        {% assign product_form_id =
          'AGProductForm-' | append: section.id
        %}


        {% form 'product', product, id: product_form_id %}

          {% assign current_variant =
            product.selected_or_first_available_variant
          %}


          <!-- VARIANTS -->

          {% unless product.has_only_default_variant %}

            <div class="ag-option-group">

              <div class="ag-option-header">

                <label for="AGVariant-{{ section.id }}">
                  Select Option
                </label>

                <span>
                  Required
                </span>

              </div>


              <select
                id="AGVariant-{{ section.id }}"
                name="id"
                class="ag-variant-select"
              >

                {% for variant in product.variants %}

                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_variant %}
                      selected
                    {% endif %}
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >

                    {{ variant.title }}
                    —
                    {{ variant.price | money }}

                    {% unless variant.available %}
                      — Sold Out
                    {% endunless %}

                  </option>

                {% endfor %}

              </select>

            </div>

          {% else %}

            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
            >

          {% endunless %}


          <!-- QUANTITY -->

          <div class="ag-quantity-area">

            <div class="ag-option-header">

              <label>
                Quantity
              </label>

              <span>
                Choose your quantity
              </span>

            </div>


            <div class="ag-quantity-box">

              <button
                type="button"
                class="ag-qty ag-qty-minus"
                aria-label="Decrease quantity"
              >
                −
              </button>


              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="ag-qty-input"
                aria-label="Quantity"
              >


              <button
                type="button"
                class="ag-qty ag-qty-plus"
                aria-label="Increase quantity"
              >
                +
              </button>

            </div>

          </div>


          <!-- ADD TO CART -->

          <button
            type="submit"
            class="ag-add-cart"
            {% unless product.available %}
              disabled
            {% endunless %}
          >

            <span class="ag-cart-icon">
              🛒
            </span>

            <span class="ag-add-text">

              {% if product.available %}
                Add To Cart
              {% else %}
                Sold Out
              {% endif %}

            </span>

            <span class="ag-add-arrow">
              →
            </span>

          </button>


          <!-- BUY NOW -->

          {{ form | payment_button }}

        {% endform %}


        <!-- GUARANTEES -->

        <div class="ag-guarantees">

          <div class="ag-guarantee">

            <div class="ag-guarantee-icon">
              ✓
            </div>

            <div>

              <strong>
                Quality Products
              </strong>

              <small>
                Carefully selected
              </small>

            </div>

          </div>


          <div class="ag-guarantee">

            <div class="ag-guarantee-icon blue">
              🔒
            </div>

            <div>

              <strong>
                Secure Checkout
              </strong>

              <small>
                Safe & protected
              </small>

            </div>

          </div>


          <div class="ag-guarantee">

            <div class="ag-guarantee-icon yellow">
              ★
            </div>

            <div>

              <strong>
                Customer First
              </strong>

              <small>
                We care about you
              </small>

            </div>

          </div>

        </div>


        <div class="ag-product-note">

          <span>✦</span>

          <p>
            Made for little moments of happiness,
            creativity & discovery.
          </p>

        </div>


      </div>

    </div>

  </div>

</section>


<style>

/* =========================================
   AGESSENTIAL PREMIUM PRODUCT
========================================= */

.ag-premium-product {
  width: 100%;

  padding: 65px 0 90px;

  background:
    radial-gradient(
      circle at 5% 5%,
      rgba(255,107,0,.09),
      transparent 27%
    ),
    radial-gradient(
      circle at 95% 15%,
      rgba(18,86,160,.09),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      #fffaf3 0%,
      #ffffff 48%,
      #f5f9ff 100%
    );

  overflow: hidden;
}


.ag-product-container {
  width: 100%;
  max-width: 1240px;

  margin: auto;

  padding: 0 25px;
}


/* BACK BUTTON */

.ag-back-btn {
  display: inline-flex;

  align-items: center;

  gap: 10px;

  padding: 7px 17px 7px 8px;

  margin-bottom: 35px;

  border-radius: 50px;

  background: rgba(18,86,160,.07);

  border: 1px solid rgba(18,86,160,.12);

  color: #1256a0;

  text-decoration: none;

  font-size: 13px;

  font-weight: 750;

  transition: .3s ease;
}


.ag-back-btn span {
  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  background: #1256a0;

  color: white;

  border-radius: 50%;

  font-size: 18px;

  transition: transform .3s ease;
}


.ag-back-btn:hover {
  background: #1256a0;
  color: white;

  transform: translateY(-2px);
}


.ag-back-btn:hover span {
  transform: translateX(-4px);
}


/* PRODUCT GRID */

.ag-product-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1.08fr)
    minmax(400px, .92fr);

  gap: 70px;

  align-items: start;
}


/* GALLERY */

.ag-product-gallery {
  min-width: 0;
}


.ag-gallery-main {
  position: relative;

  width: 100%;
  height: 620px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 45px;

  border-radius: 30px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.98),
      rgba(247,250,253,.94)
    );

  border: 1px solid rgba(0,0,0,.045);

  box-shadow:
    0 25px 70px rgba(18,50,80,.10),
    0 5px 20px rgba(0,0,0,.035);

  overflow: hidden;
}


.ag-gallery-main::before {
  content: "";

  position: absolute;

  width: 420px;
  height: 420px;

  border-radius: 50%;

  background: #ff6b00;

  opacity: .035;

  top: 50%;
  left: 50%;

  transform: translate(-50%,-50%);
}


/* SLIDES */

.ag-product-slide {
  position: absolute;

  inset: 35px;

  display: none;

  align-items: center;
  justify-content: center;

  z-index: 2;
}


.ag-product-slide.active {
  display: flex;

  animation: agImageIn .45s ease;
}


@keyframes agImageIn {

  from {
    opacity: 0;
    transform: scale(.97);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }

}


.ag-product-slide img {
  width: 100%;
  height: 100%;

  object-fit: contain;

  max-width: 580px;

  transition: transform .5s ease;
}


.ag-gallery-main:hover
.ag-product-slide.active img {
  transform: scale(1.025);
}


/* BADGE */

.ag-image-badge {
  position: absolute;

  top: 22px;
  left: 22px;

  z-index: 5;

  display: flex;

  align-items: center;

  gap: 7px;

  padding: 8px 13px;

  background: rgba(255,255,255,.9);

  backdrop-filter: blur(10px);

  border: 1px solid rgba(255,255,255,.9);

  border-radius: 50px;

  color: #15803d;

  font-size: 11px;

  font-weight: 800;

  box-shadow:
    0 8px 25px rgba(0,0,0,.07);
}


.ag-image-badge span {
  width: 19px;
  height: 19px;

  display: flex;

  align-items: center;
  justify-content: center;

  background: #dcfce7;

  border-radius: 50%;

  font-size: 10px;
}


.ag-sold-badge {
  color: #dc2626;
}


/* COUNTER */

.ag-image-counter {
  position: absolute;

  top: 25px;
  right: 25px;

  z-index: 5;

  padding: 7px 12px;

  background: rgba(255,255,255,.85);

  backdrop-filter: blur(8px);

  border: 1px solid rgba(0,0,0,.05);

  border-radius: 50px;

  color: #777;

  font-size: 11px;

  font-weight: 700;
}


.ag-image-counter .ag-current-slide {
  color: #1256a0;
}


.ag-image-counter i {
  margin: 0 3px;

  color: #ccc;

  font-style: normal;
}


/* ARROWS */

.ag-slider-btn {
  position: absolute;

  top: 50%;

  z-index: 6;

  width: 48px;
  height: 48px;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 1px solid rgba(0,0,0,.07);

  border-radius: 50%;

  background: rgba(255,255,255,.92);

  color: #1256a0;

  font-size: 19px;

  cursor: pointer;

  box-shadow:
    0 8px 25px rgba(0,0,0,.08);

  transform: translateY(-50%);

  transition: .3s ease;
}


.ag-slider-btn:hover {
  background: #1256a0;

  color: white;

  transform:
    translateY(-50%)
    scale(1.08);
}


.ag-prev {
  left: 20px;
}


.ag-next {
  right: 20px;
}


/* THUMBNAILS */

.ag-thumbnails {
  display: flex;

  gap: 12px;

  margin-top: 17px;

  overflow-x: auto;

  padding: 3px 3px 10px;

  scrollbar-width: thin;
}


.ag-thumbnail {
  width: 82px;
  height: 82px;

  flex: 0 0 82px;

  padding: 7px;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 2px solid transparent;

  border-radius: 14px;

  background: white;

  cursor: pointer;

  box-shadow:
    0 5px 18px rgba(0,0,0,.055);

  transition: .3s ease;
}


.ag-thumbnail:hover {
  transform: translateY(-3px);

  border-color:
    rgba(18,86,160,.3);
}


.ag-thumbnail.active {
  border-color: #1256a0;

  box-shadow:
    0 7px 20px rgba(18,86,160,.15);
}


.ag-thumbnail img {
  width: 100%;
  height: 100%;

  object-fit: contain;
}


/* GALLERY TRUST */

.ag-gallery-trust {
  display: grid;

  grid-template-columns: repeat(3,1fr);

  gap: 10px;

  margin-top: 18px;
}


.ag-gallery-trust div {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  padding: 10px 5px;

  color: #777;

  background: rgba(255,255,255,.65);

  border: 1px solid rgba(0,0,0,.045);

  border-radius: 10px;
}


.ag-gallery-trust span {
  color: #1256a0;

  font-size: 13px;
}


.ag-gallery-trust p {
  margin: 0;

  font-size: 9px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .3px;
}


/* DETAILS */

.ag-product-details {
  padding: 8px 0;
}


.ag-product-brand {
  display: flex;

  align-items: center;

  gap: 9px;

  color: #ff6b00;

  font-size: 10px;

  font-weight: 850;

  letter-spacing: 1.8px;

  margin-bottom: 15px;
}


.ag-product-brand span {
  width: 25px;
  height: 2px;

  background: #ff6b00;

  border-radius: 10px;
}


.ag-product-title {
  margin: 0;

  color: #172052;

  font-size: clamp(36px, 4vw, 54px);

  line-height: 1.08;

  font-weight: 900;

  letter-spacing: -1.8px;
}


/* SKU */

.ag-product-sku {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  margin-top: 14px;

  color: #777;

  font-size: 11px;
}


.ag-product-sku span {
  color: #aaa;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 1px;
}


/* PRICE */

.ag-price-area {
  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 12px;

  margin-top: 24px;
}


.ag-product-price {
  color: #e05000;

  font-size: 32px;

  font-weight: 900;

  letter-spacing: -.5px;
}


.ag-old-price {
  color: #aaa;

  font-size: 16px;

  text-decoration: line-through;
}


.ag-save-badge {
  padding: 5px 9px;

  border-radius: 6px;

  background: #fff0e7;

  color: #e05000;

  font-size: 9px;

  font-weight: 850;

  letter-spacing: .5px;
}


/* STOCK */

.ag-stock-status {
  display: flex;

  align-items: center;

  gap: 8px;

  width: fit-content;

  margin-top: 15px;

  padding: 7px 12px;

  background: #ecfdf3;

  border: 1px solid #d2f5df;

  border-radius: 50px;

  color: #15803d;

  font-size: 11px;
}


.ag-stock-status strong {
  font-weight: 800;
}


.ag-stock-status em {
  color: #5b9a71;

  font-size: 10px;

  font-style: normal;
}


.ag-pulse {
  width: 7px;
  height: 7px;

  background: #22c55e;

  border-radius: 50%;

  box-shadow:
    0 0 0 4px rgba(34,197,94,.12);

  animation: agPulse 1.8s infinite;
}


@keyframes agPulse {

  0%,100% {
    box-shadow:
      0 0 0 3px rgba(34,197,94,.12);
  }

  50% {
    box-shadow:
      0 0 0 6px rgba(34,197,94,.04);
  }

}


.ag-stock-out {
  color: #dc2626;

  background: #fff1f1;

  border-color: #ffe0e0;
}


/* DESCRIPTION */

.ag-product-description {
  margin-top: 25px;

  padding-bottom: 25px;

  border-bottom: 1px solid #eee;

  color: #626262;

  font-size: 15px;

  line-height: 1.85;
}


.ag-product-description p {
  margin: 0 0 10px;
}


.ag-product-description p:last-child {
  margin-bottom: 0;
}


.ag-product-description ul,
.ag-product-description ol {
  padding-left: 20px;
}


/* OPTIONS */

.ag-option-group,
.ag-quantity-area {
  margin-top: 25px;
}


.ag-option-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;

  margin-bottom: 9px;
}


.ag-option-header label {
  color: #202020;

  font-size: 13px;

  font-weight: 800;
}


.ag-option-header span {
  color: #999;

  font-size: 9px;

  letter-spacing: .3px;
}


.ag-variant-select {
  width: 100%;

  height: 53px;

  padding: 0 15px;

  border: 1px solid #ddd;

  border-radius: 12px;

  background: #fff;

  color: #333;

  font-size: 14px;

  font-weight: 600;

  outline: none;

  cursor: pointer;

  transition: .25s ease;
}


.ag-variant-select:focus {
  border-color: #1256a0;

  box-shadow:
    0 0 0 4px rgba(18,86,160,.08);
}


/* QUANTITY */

.ag-quantity-box {
  display: flex;

  align-items: center;

  width: fit-content;

  height: 49px;

  overflow: hidden;

  border: 1px solid #ddd;

  border-radius: 12px;

  background: white;
}


.ag-qty {
  width: 47px;
  height: 49px;

  border: 0;

  background: transparent;

  color: #1256a0;

  font-size: 21px;

  font-weight: 700;

  cursor: pointer;

  transition: .2s ease;
}


.ag-qty:hover {
  background: #1256a0;

  color: white;
}


.ag-qty-input {
  width: 55px;
  height: 49px;

  padding: 0;

  border: 0;

  outline: none;

  background: transparent;

  text-align: center;

  color: #222;

  font-size: 15px;

  font-weight: 800;

  -moz-appearance: textfield;
}


.ag-qty-input::-webkit-inner-spin-button,
.ag-qty-input::-webkit-outer-spin-button {
  -webkit-appearance: none;

  margin: 0;
}


/* ADD CART */

.ag-add-cart {
  position: relative;

  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  min-height: 61px;

  margin-top: 28px;

  padding: 0 13px 0 19px;

  border: 0;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #1256a0,
      #0b3c72
    );

  color: white;

  cursor: pointer;

  overflow: hidden;

  box-shadow:
    0 12px 28px rgba(18,86,160,.22);

  font-size: 16px;

  font-weight: 850;

  transition:
    transform .3s ease,
    box-shadow .3s ease;
}


.ag-add-cart::before {
  content: "";

  position: absolute;

  width: 110px;
  height: 150%;

  top: -25%;
  left: -150px;

  background: rgba(255,255,255,.12);

  transform: skewX(-20deg);

  transition: left .6s ease;
}


.ag-add-cart:hover {
  transform: translateY(-3px);

  box-shadow:
    0 18px 38px rgba(18,86,160,.28);
}


.ag-add-cart:hover::before {
  left: 115%;
}


.ag-cart-icon {
  width: 36px;
  height: 36px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: rgba(255,255,255,.14);

  font-size: 16px;
}


.ag-add-text {
  flex: 1;

  text-align: center;
}


.ag-add-arrow {
  width: 36px;
  height: 36px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.14);

  font-size: 19px;

  transition: transform .3s ease;
}


.ag-add-cart:hover .ag-add-arrow {
  transform: translateX(4px);
}


.ag-add-cart:disabled {
  opacity: .5;

  cursor: not-allowed;

  box-shadow: none;
}


.ag-add-cart:disabled:hover {
  transform: none;
}


/* SHOPIFY PAYMENT */

.ag-product-details
.shopify-payment-button {
  margin-top: 12px;
}


.ag-product-details
.shopify-payment-button button {
  min-height: 57px !important;

  border-radius: 13px !important;

  font-size: 15px !important;
}


/* GUARANTEES */

.ag-guarantees {
  display: grid;

  grid-template-columns: repeat(3,1fr);

  gap: 9px;

  margin-top: 25px;

  padding: 17px 0;

  border-top: 1px solid #eee;

  border-bottom: 1px solid #eee;
}


.ag-guarantee {
  display: flex;

  align-items: center;

  gap: 8px;
}


.ag-guarantee-icon {
  width: 31px;
  height: 31px;

  flex: 0 0 31px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: #fff0e5;

  color: #ff6b00;

  font-size: 12px;
}


.ag-guarantee-icon.blue {
  background: #eaf3ff;

  color: #1256a0;
}


.ag-guarantee-icon.yellow {
  background: #fff7d8;

  color: #d49b00;
}


.ag-guarantee strong {
  display: block;

  color: #333;

  font-size: 10px;

  font-weight: 800;
}


.ag-guarantee small {
  display: block;

  margin-top: 2px;

  color: #999;

  font-size: 8px;
}


/* PRODUCT NOTE */

.ag-product-note {
  display: flex;

  align-items: center;

  gap: 9px;

  margin-top: 20px;
}


.ag-product-note > span {
  color: #ff6b00;

  font-size: 17px;
}


.ag-product-note p {
  margin: 0;

  color: #888;

  font-size: 11px;

  line-height: 1.5;
}


/* NO IMAGE */

.ag-no-product-image {
  position: relative;

  z-index: 3;

  text-align: center;

  color: #aaa;
}


.ag-no-product-image span {
  display: block;

  color: #1256a0;

  font-size: 60px;

  font-weight: 900;
}


.ag-no-product-image p {
  margin: 5px 0;

  font-size: 12px;
}


/* TABLET */

@media (max-width: 1000px) {

  .ag-product-layout {
    grid-template-columns: 1fr;

    gap: 45px;
  }


  .ag-gallery-main {
    height: 570px;
  }


  .ag-product-details {
    max-width: 750px;

    width: 100%;

    margin: auto;
  }

}


/* MOBILE */

@media (max-width: 600px) {

  .ag-premium-product {
    padding: 35px 0 60px;
  }


  .ag-product-container {
    padding: 0 15px;
  }


  .ag-back-btn {
    margin-bottom: 22px;
  }


  .ag-product-layout {
    gap: 28px;
  }


  .ag-gallery-main {
    height: 390px;

    padding: 25px;

    border-radius: 20px;
  }


  .ag-product-slide {
    inset: 20px;
  }


  .ag-gallery-main::before {
    width: 260px;
    height: 260px;
  }


  .ag-image-badge {
    top: 13px;
    left: 13px;

    padding: 6px 10px;

    font-size: 9px;
  }


  .ag-image-counter {
    top: 14px;
    right: 14px;

    font-size: 9px;
  }


  .ag-slider-btn {
    width: 39px;
    height: 39px;

    font-size: 16px;
  }


  .ag-prev {
    left: 9px;
  }


  .ag-next {
    right: 9px;
  }


  .ag-thumbnails {
    gap: 8px;

    margin-top: 11px;
  }


  .ag-thumbnail {
    width: 65px;
    height: 65px;

    flex-basis: 65px;

    padding: 5px;

    border-radius: 11px;
  }


  .ag-gallery-trust {
    gap: 5px;
  }


  .ag-gallery-trust div {
    padding: 8px 3px;

    gap: 4px;

    flex-direction: column;
  }


  .ag-gallery-trust p {
    font-size: 7px;

    text-align: center;
  }


  .ag-product-brand {
    font-size: 8px;

    letter-spacing: 1.3px;
  }


  .ag-product-title {
    font-size: 31px;

    letter-spacing: -1px;
  }


  .ag-product-price {
    font-size: 27px;
  }


  .ag-product-description {
    font-size: 14px;

    line-height: 1.75;
  }


  .ag-option-group,
  .ag-quantity-area {
    margin-top: 21px;
  }


  .ag-option-header span {
    max-width: 170px;

    text-align: right;
  }


  .ag-variant-select {
    height: 50px;

    font-size: 13px;
  }


  .ag-add-cart {
    min-height: 56px;

    margin-top: 23px;

    border-radius: 12px;

    font-size: 15px;
  }


  .ag-guarantees {
    gap: 5px;
  }


  .ag-guarantee {
    gap: 5px;

    flex-direction: column;

    text-align: center;
  }


  .ag-guarantee-icon {
    width: 29px;
    height: 29px;

    flex-basis: 29px;
  }


  .ag-guarantee strong {
    font-size: 8px;
  }


  .ag-guarantee small {
    font-size: 7px;
  }


  .ag-product-note {
    justify-content: center;

    text-align: center;
  }

}


/* EXTRA SMALL */

@media (max-width: 380px) {

  .ag-gallery-main {
    height: 350px;
  }


  .ag-product-title {
    font-size: 28px;
  }


  .ag-gallery-trust p {
    font-size: 6px;
  }

}

</style>


<script>

(function () {

  function initAGProductGallery() {

    var gallery =
      document.getElementById(
        'AGProductGallery-{{ section.id }}'
      );


    if (!gallery) {
      return;
    }


    var slides =
      gallery.querySelectorAll(
        '.ag-product-slide'
      );


    var thumbnails =
      gallery.querySelectorAll(
        '.ag-thumbnail'
      );


    var next =
      gallery.querySelector(
        '.ag-next'
      );


    var prev =
      gallery.querySelector(
        '.ag-prev'
      );


    var counter =
      gallery.querySelector(
        '.ag-current-slide'
      );


    if (!slides.length) {
      return;
    }


    var current = 0;


    function showSlide(index) {

      if (index >= slides.length) {
        index = 0;
      }


      if (index < 0) {
        index = slides.length - 1;
      }


      slides.forEach(function (slide) {

        slide.classList.remove('active');

      });


      thumbnails.forEach(function (thumb) {

        thumb.classList.remove('active');

      });


      slides[index].classList.add('active');


      if (thumbnails[index]) {

        thumbnails[index].classList.add('active');

      }


      if (counter) {

        counter.textContent =
          String(index + 1).padStart(2, '0');

      }


      current = index;

    }


    if (next) {

      next.addEventListener(
        'click',
        function (event) {

          event.preventDefault();

          event.stopPropagation();

          showSlide(current + 1);

        }
      );

    }


    if (prev) {

      prev.addEventListener(
        'click',
        function (event) {

          event.preventDefault();

          event.stopPropagation();

          showSlide(current - 1);

        }
      );

    }


    thumbnails.forEach(
      function (thumbnail) {

        thumbnail.addEventListener(
          'click',
          function (event) {

            event.preventDefault();

            event.stopPropagation();


            var index =
              parseInt(
                this.getAttribute('data-index'),
                10
              );


            showSlide(index);

          }
        );

      }
    );


    /* TOUCH SWIPE */

    var touchStartX = 0;


    gallery
      .querySelector('.ag-gallery-main')
      .addEventListener(
        'touchstart',
        function (event) {

          touchStartX =
            event.changedTouches[0].screenX;

        },
        { passive: true }
      );


    gallery
      .querySelector('.ag-gallery-main')
      .addEventListener(
        'touchend',
        function (event) {

          var touchEndX =
            event.changedTouches[0].screenX;


          var distance =
            touchEndX - touchStartX;


          if (Math.abs(distance) < 45) {
            return;
          }


          if (distance < 0) {

            showSlide(current + 1);

          } else {

            showSlide(current - 1);

          }

        },
        { passive: true }
      );


    showSlide(0);

  }


  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initAGProductGallery
    );

  } else {

    initAGProductGallery();

  }


  document.addEventListener(
    'shopify:section:load',
    function () {

      initAGProductGallery();

    }
  );


  /* =========================================
     QUANTITY
  ========================================== */

  document.addEventListener(
    'click',
    function (event) {

      var plus =
        event.target.closest(
          '.ag-qty-plus'
        );


      var minus =
        event.target.closest(
          '.ag-qty-minus'
        );


      if (plus) {

        var plusInput =
          plus
            .closest('.ag-quantity-box')
            .querySelector('.ag-qty-input');


        plusInput.value =
          (parseInt(
            plusInput.value,
            10
          ) || 1) + 1;


        plusInput.dispatchEvent(
          new Event(
            'change',
            {
              bubbles: true
            }
          )
        );

      }


      if (minus) {

        var minusInput =
          minus
            .closest('.ag-quantity-box')
            .querySelector('.ag-qty-input');


        var value =
          parseInt(
            minusInput.value,
            10
          ) || 1;


        if (value > 1) {

          minusInput.value =
            value - 1;


          minusInput.dispatchEvent(
            new Event(
              'change',
              {
                bubbles: true
              }
            )
          );

        }

      }

    }
  );


  /* VALIDATE QUANTITY */

  document.addEventListener(
    'change',
    function (event) {

      if (
        event.target.classList.contains(
          'ag-qty-input'
        )
      ) {

        var value =
          parseInt(
            event.target.value,
            10
          ) || 1;


        if (value < 1) {
          value = 1;
        }


        event.target.value = value;

      }

    }
  );

})();

</script>


{% schema %}

{
  "name": "Premium Product",
  "settings": [],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}

{% endschema %}
