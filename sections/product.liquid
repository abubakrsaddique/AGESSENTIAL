<section class="modern-product">

<div class="product-container">


<!-- PRODUCT GALLERY -->

<div class="product-gallery" id="ProductGallery-{{ section.id }}">


<div class="main-slider">


{% for image in product.images %}

<div 
class="slide {% if forloop.first %}active{% endif %}"
data-index="{{ forloop.index0 }}"
>

<img 
src="{{ image | image_url: width:800 }}"
alt="{{ product.title }}"
loading="lazy">

</div>

{% endfor %}



{% if product.images.size > 1 %}

<button 
type="button"
class="slider-arrow prev-slide"
aria-label="Previous Image"
>

❮

</button>


<button 
type="button"
class="slider-arrow next-slide"
aria-label="Next Image"
>

❯

</button>

{% endif %}


</div>



<!-- THUMBNAILS -->

{% if product.images.size > 1 %}

<div class="product-thumbnails">


{% for image in product.images %}

<button
type="button"
class="thumbnail {% if forloop.first %}active{% endif %}"
data-index="{{ forloop.index0 }}"
>

<img
src="{{ image | image_url: width:200 }}"
alt="{{ product.title }}"
loading="lazy">

</button>

{% endfor %}


</div>

{% endif %}


</div>





<!-- PRODUCT DETAILS -->

<div class="product-details">



<h1 class="product-title">
{{ product.title }}
</h1>




<div class="product-price">

{{ product.price | money }}

</div>





{% if product.available %}

<div class="stock-badge">
✓ In Stock
</div>

{% else %}

<div class="out-stock">
Out of Stock
</div>

{% endif %}







<div class="product-description">

{{ product.description }}

</div>







{% form 'product', product %}


{% assign current_variant = product.selected_or_first_available_variant %}




{% unless product.has_only_default_variant %}

<div class="variant-box">

<label>
Select Option
</label>


<select name="id" class="variant-select">

{% for variant in product.variants %}

<option 
value="{{ variant.id }}"
{% if variant == current_variant %}
selected
{% endif %}
>

{{ variant.title }} - {{ variant.price | money }}

</option>


{% endfor %}

</select>


</div>


{% else %}


<input 
type="hidden" 
name="id" 
value="{{ current_variant.id }}">


{% endunless %}








<div class="quantity-area">


<label>
Quantity
</label>


<div class="quantity-box">


<button 
type="button"
class="qty-minus">
−
</button>



<input 
type="number"
name="quantity"
value="1"
min="1"
class="qty-input">



<button 
type="button"
class="qty-plus">
+
</button>


</div>


</div>











<button 
type="submit"
class="add-cart-btn"
{% unless product.available %}
disabled
{% endunless %}
>

Add To Cart

</button>





{{ form | payment_button }}



{% endform %}





</div>


</div>


</section>





<style>

*{
box-sizing:border-box;
}


.modern-product{

width:100%;
background:#f5f9ff;
padding:60px 0;

}



.product-container{

max-width:1200px;
margin:auto;
padding:0 20px;

display:grid;
grid-template-columns:1.2fr 1fr;
gap:45px;
align-items:start;

}



/* ========================= */
/* IMAGE SLIDER */
/* ========================= */


.product-gallery{

width:100%;

}



.main-slider{

width:100%;
height:600px;

background:#fff;

border-radius:25px;

padding:40px;

display:flex;
align-items:center;
justify-content:center;

box-shadow:0 10px 35px rgba(0,0,0,.10);

overflow:hidden;

position:relative;

}



.slide{

width:100%;
height:100%;

display:none;

align-items:center;
justify-content:center;

}



.slide.active{

display:flex;

}



.slide img{

width:100%;
height:100%;

max-width:550px;

object-fit:contain;

}



/* SLIDER ARROWS */


.slider-arrow{

position:absolute;

top:50%;

transform:translateY(-50%);

width:48px;
height:48px;

border:none;

border-radius:50%;

background:#1256a0;

color:white;

font-size:28px;

font-weight:bold;

cursor:pointer;

z-index:10;

display:flex;

align-items:center;
justify-content:center;

transition:.3s;

}



.slider-arrow:hover{

background:#0b3c72;

}



.prev-slide{

left:20px;

}



.next-slide{

right:20px;

}



/* THUMBNAILS */


.product-thumbnails{

display:flex;

gap:12px;

margin-top:20px;

overflow-x:auto;

padding-bottom:8px;

}



.thumbnail{

width:100px;

height:100px;

min-width:100px;

background:#fff;

border:2px solid transparent;

border-radius:15px;

padding:8px;

cursor:pointer;

box-shadow:0 5px 18px rgba(0,0,0,.08);

transition:.3s;

}



.thumbnail:hover{

transform:translateY(-2px);

}



.thumbnail.active{

border:2px solid #1256a0;

}



.thumbnail img{

width:100%;

height:100%;

object-fit:contain;

}





/* PRODUCT DETAILS */


.product-details{

background:#fff;

padding:40px;

border-radius:25px;

box-shadow:0 10px 35px rgba(0,0,0,.10);

}





.product-title{

font-size:40px;

line-height:1.2;

font-weight:800;

color:#13205c;

margin:0 0 20px;

}





.product-price{

font-size:32px;

font-weight:800;

color:#e63946;

margin-bottom:20px;

}





.stock-badge{

display:inline-block;

background:#dcfce7;

color:#15803d;

padding:9px 20px;

border-radius:30px;

font-size:15px;

font-weight:700;

margin-bottom:25px;

}




.out-stock{

display:inline-block;

background:#fee2e2;

color:#dc2626;

padding:9px 20px;

border-radius:30px;

font-weight:700;

margin-bottom:25px;

}







.product-description{

font-size:17px;

line-height:1.8;

color:#555;

margin-bottom:30px;

}





/* VARIANT */


.variant-box label,
.quantity-area label{

display:block;

font-size:16px;

font-weight:700;

color:#13205c;

margin-bottom:10px;

}



.variant-select{

width:100%;

height:50px;

padding:0 15px;

border:1px solid #ddd;

border-radius:12px;

font-size:16px;

background:white;

margin-bottom:25px;

}








/* QUANTITY */


.quantity-box{

display:flex;

align-items:center;

gap:12px;

margin-bottom:30px;

}



.quantity-box button{

width:48px;

height:48px;

border:none;

border-radius:12px;

background:#1256a0;

color:white;

font-size:28px;

font-weight:bold;

cursor:pointer;

}



.quantity-box button:hover{

background:#0b3c72;

}




.qty-input{

width:80px;

height:48px;

border:1px solid #ddd;

border-radius:12px;

text-align:center;

font-size:20px;

}






/* ADD CART */


.add-cart-btn{

width:100%;

height:58px;

background:#1256a0;

color:white;

border:none;

border-radius:14px;

font-size:20px;

font-weight:700;

cursor:pointer;

transition:.3s;

margin-bottom:15px;

}



.add-cart-btn:hover{

background:#0b3c72;

}






.shopify-payment-button button{

width:100%!important;

height:58px!important;

border-radius:14px!important;

font-size:18px!important;

}






/* TABLET */


@media(max-width:900px){


.product-container{

grid-template-columns:1fr;

}



.main-slider{

height:500px;

}



.product-title{

font-size:34px;

}


}








/* MOBILE */


@media(max-width:600px){


.modern-product{

padding:30px 0;

}



.product-container{

padding:0 15px;

gap:25px;

}



.main-slider{

height:380px;

padding:25px;

border-radius:18px;

}



.slide img{

max-width:330px;

}



.slider-arrow{

width:40px;

height:40px;

font-size:22px;

}



.prev-slide{

left:10px;

}



.next-slide{

right:10px;

}



.thumbnail{

width:70px;

height:70px;

min-width:70px;

padding:5px;

}



.product-details{

padding:25px;

border-radius:18px;

}



.product-title{

font-size:28px;

}



.product-price{

font-size:26px;

}



.product-description{

font-size:15px;

}



.quantity-box button{

width:42px;

height:42px;

}



.qty-input{

width:65px;

height:42px;

}



.add-cart-btn{

height:52px;

font-size:17px;

}


}



</style>





<script>

(function(){

function initProductSlider(){

var gallery = document.getElementById(
"ProductGallery-{{ section.id }}"
);


if(!gallery){
return;
}


var slides = gallery.querySelectorAll(".slide");

var thumbnails = gallery.querySelectorAll(".thumbnail");

var nextBtn = gallery.querySelector(".next-slide");

var prevBtn = gallery.querySelector(".prev-slide");


if(slides.length === 0){
return;
}


var currentSlide = 0;



function showSlide(index){


if(index >= slides.length){

index = 0;

}


if(index < 0){

index = slides.length - 1;

}



/* REMOVE ACTIVE FROM ALL SLIDES */


for(var i = 0; i < slides.length; i++){

slides[i].classList.remove("active");

slides[i].style.display = "none";

}



/* SHOW SELECTED SLIDE */


slides[index].classList.add("active");

slides[index].style.display = "flex";



/* REMOVE ACTIVE FROM ALL THUMBNAILS */


for(var j = 0; j < thumbnails.length; j++){

thumbnails[j].classList.remove("active");

}



/* ACTIVE CURRENT THUMBNAIL */


if(thumbnails[index]){

thumbnails[index].classList.add("active");

}



currentSlide = index;

}



/* NEXT BUTTON */


if(nextBtn){

nextBtn.addEventListener("click", function(e){

e.preventDefault();

e.stopPropagation();

showSlide(currentSlide + 1);

});

}



/* PREVIOUS BUTTON */


if(prevBtn){

prevBtn.addEventListener("click", function(e){

e.preventDefault();

e.stopPropagation();

showSlide(currentSlide - 1);

});

}



/* THUMBNAIL CLICK */


for(var k = 0; k < thumbnails.length; k++){


thumbnails[k].addEventListener("click", function(e){

e.preventDefault();

e.stopPropagation();


var index = parseInt(
this.getAttribute("data-index")
);


showSlide(index);


});


}



/* SHOW FIRST IMAGE */


showSlide(0);


}



/* INITIALIZE */


if(document.readyState === "loading"){

document.addEventListener(
"DOMContentLoaded",
initProductSlider
);

}

else{

initProductSlider();

}



/* SHOPIFY CUSTOMIZER SUPPORT */


document.addEventListener(
"shopify:section:load",
function(){

initProductSlider();

}
);


})();





/* QUANTITY PLUS / MINUS */


document.addEventListener("click", function(e){


if(e.target.classList.contains("qty-plus")){


var input = e.target
.closest(".quantity-box")
.querySelector(".qty-input");


input.value = Number(input.value) + 1;


}





if(e.target.classList.contains("qty-minus")){


var input = e.target
.closest(".quantity-box")
.querySelector(".qty-input");


if(Number(input.value) > 1){

input.value = Number(input.value) - 1;

}


}


});

</script>





{% schema %}
{
  "name": "Modern Product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}