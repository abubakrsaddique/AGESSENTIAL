<header class="premium-header" data-mobile-header>

  <div class="header-main">

    <!-- =========================================
         LOGO
    ========================================== -->

    <div class="header__logo">

      <a href="{{ routes.root_url }}">

        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
        >

      </a>

    </div>


    <!-- =========================================
         DESKTOP MENU
    ========================================== -->

    <nav class="desktop-menu" aria-label="Main navigation">

      <ul>

        <li>
          <a href="{{ routes.root_url }}">
            Home
          </a>
        </li>

        <li>
          <a href="{{ routes.all_products_collection_url }}">
            Collections
          </a>
        </li>

        <li>
          <a href="/pages/babies">
            Babies
          </a>
        </li>

        <li>
          <a href="/pages/girls">
            Girls
          </a>
        </li>

        <li>
          <a href="/pages/boys">
            Boys
          </a>
        </li>

        <li>
          <a href="/pages/about-us">
            About Us
          </a>
        </li>

        <li>
          <a href="/pages/contact-us">
            Contact Us
          </a>
        </li>

      </ul>

    </nav>


    <!-- =========================================
         DESKTOP ICONS
    ========================================== -->

    <div class="header__icons">

      {% if shop.customer_accounts_enabled %}

        <a
          class="header-action"
          href="{{ routes.account_url }}"
        >

          <span class="header-icon">

            {{ 'icon-account.svg' | inline_asset_content }}

          </span>

          <span class="action-text">
            Login
          </span>

        </a>

      {% endif %}


      <a
        class="header-action cart-action"
        href="{{ routes.cart_url }}"
      >

        <span class="header-icon">

          {{ 'icon-cart.svg' | inline_asset_content }}

        </span>

        <span class="action-text">
          Cart
        </span>

        {% if cart.item_count > 0 %}

          <sup>
            {{ cart.item_count }}
          </sup>

        {% endif %}

      </a>

    </div>


    <!-- =========================================
         MOBILE MENU BUTTON
    ========================================== -->

    <button
      type="button"
      class="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >

      <span></span>
      <span></span>
      <span></span>

    </button>

  </div>


  <!-- =========================================
       MOBILE MENU OVERLAY
  ========================================== -->

  <div
    class="mobile-menu-overlay"
    data-mobile-overlay
  ></div>


  <!-- =========================================
       MOBILE MENU
  ========================================== -->

  <nav
    id="mobile-navigation"
    class="mobile-menu"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >

    <div class="mobile-menu-inner">


      <!-- MOBILE MENU HEADER -->

      <div class="mobile-menu-top">

        <span>
          Menu
        </span>

        <button
          type="button"
          class="mobile-close"
          aria-label="Close menu"
        >

          <span></span>
          <span></span>

        </button>

      </div>


      <!-- MOBILE LINKS -->

      <ul>

        <li>

          <a href="{{ routes.root_url }}">

            <span>
              Home
            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>


        <li>

          <a href="{{ routes.all_products_collection_url }}">

            <span>
              Collections
            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>


        <li>

          <a href="/pages/babies">

            <span>
              Babies
            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>


        <li>

          <a href="/pages/girls">

            <span>
              Girls
            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>


        <li>

          <a href="/pages/boys">

            <span>
              Boys
            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>


        <li>

          <a href="/pages/about-us">

            <span>
              About Us
            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>


        <li>

          <a href="/pages/contact-us">

            <span>
              Contact Us
            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>


        {% if shop.customer_accounts_enabled %}

          <li>

            <a href="{{ routes.account_url }}">

              <span>
                Login
              </span>

              <span class="menu-arrow">
                →
              </span>

            </a>

          </li>

        {% endif %}


        <li>

          <a href="{{ routes.cart_url }}">

            <span>

              Shopping Cart

              {% if cart.item_count > 0 %}

                <small>
                  ({{ cart.item_count }})
                </small>

              {% endif %}

            </span>

            <span class="menu-arrow">
              →
            </span>

          </a>

        </li>

      </ul>

    </div>

  </nav>

</header>


<!-- =========================================
     JAVASCRIPT
========================================== -->

<script>

(function () {

  function initializeMobileHeader() {

    const headers = document.querySelectorAll('[data-mobile-header]');

    if (!headers.length) {
      return;
    }


    headers.forEach(function (header) {

      /* -----------------------------------------
         ELEMENTS
      ----------------------------------------- */

      const menu =
        header.querySelector('.mobile-menu');

      const toggle =
        header.querySelector('.menu-toggle');

      const closeButton =
        header.querySelector('.mobile-close');

      const overlay =
        header.querySelector('.mobile-menu-overlay');

      const menuLinks =
        header.querySelectorAll('.mobile-menu a');


      if (!menu || !toggle) {
        return;
      }


      /* -----------------------------------------
         OPEN MENU
      ----------------------------------------- */

      function openMenu() {

        menu.classList.add('is-open');

        toggle.classList.add('is-active');

        if (overlay) {
          overlay.classList.add('is-visible');
        }

        toggle.setAttribute(
          'aria-expanded',
          'true'
        );

        toggle.setAttribute(
          'aria-label',
          'Close menu'
        );

        menu.setAttribute(
          'aria-hidden',
          'false'
        );

        document.body.classList.add(
          'mobile-menu-open'
        );

      }


      /* -----------------------------------------
         CLOSE MENU
      ----------------------------------------- */

      function closeMenu() {

        menu.classList.remove('is-open');

        toggle.classList.remove('is-active');

        if (overlay) {
          overlay.classList.remove('is-visible');
        }

        toggle.setAttribute(
          'aria-expanded',
          'false'
        );

        toggle.setAttribute(
          'aria-label',
          'Open menu'
        );

        menu.setAttribute(
          'aria-hidden',
          'true'
        );

        document.body.classList.remove(
          'mobile-menu-open'
        );

      }


      /* -----------------------------------------
         TOGGLE MENU
      ----------------------------------------- */

      function toggleMenu(event) {

        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }

        if (menu.classList.contains('is-open')) {

          closeMenu();

        } else {

          openMenu();

        }

      }


      /* -----------------------------------------
         HAMBURGER CLICK
      ----------------------------------------- */

      toggle.addEventListener(
        'click',
        toggleMenu
      );


      /* -----------------------------------------
         CLOSE BUTTON
      ----------------------------------------- */

      if (closeButton) {

        closeButton.addEventListener(
          'click',
          function (event) {

            event.preventDefault();
            event.stopPropagation();

            closeMenu();

          }
        );

      }


      /* -----------------------------------------
         OVERLAY CLICK
      ----------------------------------------- */

      if (overlay) {

        overlay.addEventListener(
          'click',
          function () {

            closeMenu();

          }
        );

      }


      /* -----------------------------------------
         MOBILE LINK CLICK
      ----------------------------------------- */

      menuLinks.forEach(function (link) {

        link.addEventListener(
          'click',
          function () {

            closeMenu();

          }
        );

      });


      /* -----------------------------------------
         ESCAPE KEY
      ----------------------------------------- */

      document.addEventListener(
        'keydown',
        function (event) {

          if (
            event.key === 'Escape' &&
            menu.classList.contains('is-open')
          ) {

            closeMenu();

          }

        }
      );


      /* -----------------------------------------
         WINDOW RESIZE
      ----------------------------------------- */

      window.addEventListener(
        'resize',
        function () {

          if (window.innerWidth > 768) {

            closeMenu();

          }

        }
      );

    });

  }


  /* =========================================
     INITIALIZE
  ========================================== */

  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initializeMobileHeader
    );

  } else {

    initializeMobileHeader();

  }


  /* =========================================
     SHOPIFY THEME EDITOR
  ========================================== */

  document.addEventListener(
    'shopify:section:load',
    function () {

      initializeMobileHeader();

    }
  );

})();

</script>


{% stylesheet %}


/* =====================================================
   PREMIUM IVORY HEADER
===================================================== */

.premium-header {

  position: relative;

  z-index: 9999;

}


/* =====================================================
   MAIN HEADER
===================================================== */

.header-main {

  height: 82px;

  background: #fff8ed;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 55px;

  width: 99.4vw;

  position: relative;

  left: 50%;

  margin-left: -50vw;

  box-sizing: border-box;

  border-bottom:
    1px solid rgba(80, 60, 30, 0.10);

  box-shadow:
    0 5px 25px rgba(80, 60, 30, 0.055);

}


/* =====================================================
   LOGO
===================================================== */

.header__logo {

  display: flex;

  align-items: center;

  flex-shrink: 0;

}


.header__logo a {

  display: block;

}


.header__logo img {

  width: 205px;

  height: auto;

  display: block;

  transition:
    transform 0.3s ease;

}


.header__logo img:hover {

  transform: scale(1.02);

}


/* =====================================================
   DESKTOP MENU
===================================================== */

.desktop-menu {

  margin-left: auto;

  margin-right: 55px;

}


.desktop-menu ul {

  display: flex;

  align-items: center;

  gap: 28px;

  list-style: none;

  margin: 0;

  padding: 0;

}


.desktop-menu li {

  margin: 0;

  padding: 0;

}


.desktop-menu a {

  position: relative;

  display: inline-block;

  text-decoration: none;

  color: #202020;

  font-size: 13px;

  font-weight: 600;

  letter-spacing: 0.4px;

  padding: 8px 0;

  transition:
    color 0.3s ease,
    transform 0.3s ease;

}


.desktop-menu a:hover {

  color: #a57b36;

  transform:
    translateY(-1px);

}


.desktop-menu a::after {

  content: "";

  position: absolute;

  left: 50%;

  bottom: 0;

  width: 0;

  height: 2px;

  border-radius: 20px;

  background:
    linear-gradient(
      90deg,
      #b58a45,
      #e1c17a
    );

  transform:
    translateX(-50%);

  transition:
    width 0.3s ease;

}


.desktop-menu a:hover::after {

  width: 100%;

}


/* =====================================================
   DESKTOP ICONS
===================================================== */

.header__icons {

  display: flex;

  align-items: center;

  gap: 12px;

}


.header-action {

  position: relative;

  min-width: 82px;

  height: 42px;

  padding: 0 13px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  color: #202020;

  text-decoration: none;

  border:
    1px solid rgba(80, 60, 30, 0.12);

  border-radius: 50px;

  background: #fffdf8;

  box-shadow:
    0 3px 12px rgba(80, 60, 30, 0.045);

  transition:
    all 0.3s ease;

}


.header-icon {

  width: 20px;

  height: 20px;

  display: flex;

  align-items: center;

  justify-content: center;

}


.header-action svg {

  width: 19px;

  height: 19px;

  transition:
    transform 0.3s ease;

}


.action-text {

  font-size: 12px;

  font-weight: 600;

  letter-spacing: 0.3px;

}


.header-action:hover {

  color: #ffffff;

  background: #202020;

  border-color: #202020;

  transform:
    translateY(-2px);

  box-shadow:
    0 8px 20px rgba(0,0,0,0.12);

}


.header-action:hover svg {

  transform: scale(1.08);

}


/* =====================================================
   CART COUNT
===================================================== */

.header-action sup {

  position: absolute;

  top: -5px;

  right: -3px;

  min-width: 18px;

  height: 18px;

  padding: 0 5px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #b58a45;

  color: #ffffff;

  border-radius: 50px;

  font-size: 9px;

  font-weight: 700;

  border:
    2px solid #fff8ed;

  line-height: 1;

}


/* =====================================================
   MOBILE TOGGLE
===================================================== */

.menu-toggle {

  display: none;

  width: 43px;

  height: 43px;

  padding: 0;

  border:
    1px solid rgba(80, 60, 30, 0.12);

  border-radius: 50%;

  background: #fffdf8;

  cursor: pointer;

  align-items: center;

  justify-content: center;

  flex-direction: column;

  gap: 5px;

  box-shadow:
    0 4px 15px rgba(80, 60, 30, 0.06);

  transition:
    all 0.3s ease;

  position: relative;

  z-index: 100002;

}


.menu-toggle span {

  display: block;

  width: 17px;

  height: 2px;

  background: #202020;

  border-radius: 10px;

  transition:
    all 0.3s ease;

}


/* ACTIVE HAMBURGER */

.menu-toggle.is-active {

  background: #202020;

  border-color: #202020;

}


.menu-toggle.is-active span {

  background: #ffffff;

}


.menu-toggle.is-active span:nth-child(1) {

  transform:
    translateY(7px)
    rotate(45deg);

}


.menu-toggle.is-active span:nth-child(2) {

  opacity: 0;

}


.menu-toggle.is-active span:nth-child(3) {

  transform:
    translateY(-7px)
    rotate(-45deg);

}


/* =====================================================
   MOBILE OVERLAY
===================================================== */

.mobile-menu-overlay {

  position: fixed;

  inset: 0;

  background:
    rgba(0, 0, 0, 0.25);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity 0.3s ease,
    visibility 0.3s ease;

  z-index: 99990;

}


.mobile-menu-overlay.is-visible {

  opacity: 1;

  visibility: visible;

  pointer-events: auto;

}


/* =====================================================
   MOBILE MENU
===================================================== */

.mobile-menu {

  position: absolute;

  top: 82px;

  left: 0;

  width: 100%;

  background: #fff8ed;

  border-bottom:
    1px solid rgba(80, 60, 30, 0.10);

  box-shadow:
    0 20px 40px rgba(80, 60, 30, 0.10);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transform:
    translateY(-15px);

  transition:
    opacity 0.3s ease,
    transform 0.3s ease,
    visibility 0.3s ease;

  z-index: 100000;

}


.mobile-menu.is-open {

  opacity: 1;

  visibility: visible;

  pointer-events: auto;

  transform:
    translateY(0);

}


/* =====================================================
   MOBILE MENU INNER
===================================================== */

.mobile-menu-inner {

  padding:
    22px 20px 25px;

}


/* =====================================================
   MOBILE MENU TOP
===================================================== */

.mobile-menu-top {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 12px;

  padding-bottom: 15px;

  border-bottom:
    1px solid rgba(80, 60, 30, 0.10);

}


.mobile-menu-top > span {

  font-size: 12px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  color: #8b7b67;

}


/* =====================================================
   MOBILE CLOSE BUTTON
===================================================== */

.mobile-close {

  width: 38px;

  height: 38px;

  border: 0;

  background: #fffdf8;

  border-radius: 50%;

  cursor: pointer;

  display: flex;

  align-items: center;

  justify-content: center;

  position: relative;

  box-shadow:
    0 3px 12px rgba(80, 60, 30, 0.06);

}


.mobile-close span {

  position: absolute;

  width: 16px;

  height: 2px;

  background: #202020;

  border-radius: 10px;

}


.mobile-close span:first-child {

  transform: rotate(45deg);

}


.mobile-close span:last-child {

  transform: rotate(-45deg);

}


/* =====================================================
   MOBILE LIST
===================================================== */

.mobile-menu ul {

  list-style: none;

  margin: 0;

  padding: 0;

}


.mobile-menu li {

  margin: 0;

  border-bottom:
    1px solid rgba(80, 60, 30, 0.08);

}


.mobile-menu li:last-child {

  border-bottom: none;

}


.mobile-menu a {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 17px 2px;

  color: #202020;

  text-decoration: none;

  font-size: 15px;

  font-weight: 600;

  letter-spacing: 0.2px;

  transition:
    color 0.25s ease,
    padding 0.25s ease;

}


.mobile-menu a:hover {

  color: #a57b36;

  padding-left: 7px;

}


.menu-arrow {

  color: #a58b67;

  font-size: 18px;

  transition:
    transform 0.25s ease,
    color 0.25s ease;

}


.mobile-menu a:hover .menu-arrow {

  color: #a57b36;

  transform:
    translateX(5px);

}


.mobile-menu small {

  color: #a57b36;

  font-size: 11px;

}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1100px) {

  .header-main {

    padding: 0 30px;

  }


  .desktop-menu {

    margin-right: 25px;

  }


  .desktop-menu ul {

    gap: 18px;

  }


  .desktop-menu a {

    font-size: 12px;

  }


  .header__logo img {

    width: 180px;

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 768px) {

  .premium-header {

    width: 100vw;

    position: relative;

    left: 50%;

    margin-left: -50vw;

    z-index: 9999;

  }


  .header-main {

    width: 100%;

    max-width: 100%;

    height: 70px;

    padding: 0 18px;

    box-sizing: border-box;

    position: relative;

    left: 0;

    margin: 0;

  }


  .header__logo {

    min-width: 0;

    flex-shrink: 1;

  }


  .header__logo img {

    display: block;

    width: 150px;

    max-width: 100%;

    height: auto;

  }


  .desktop-menu,

  .header__icons {

    display: none !important;

  }


  .menu-toggle {

    display: flex !important;

    flex-shrink: 0;

  }


  .mobile-menu {

    top: 70px;

    left: 0;

    width: 100%;

    max-width: 100%;

    box-sizing: border-box;

  }


  .mobile-menu-inner {

    width: 100%;

    max-width: 100%;

    box-sizing: border-box;

  }


  .mobile-menu-overlay {

    display: block;

  }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media screen and (max-width: 380px) {

  .header-main {

    padding: 0 14px;

  }


  .header__logo img {

    width: 135px;

  }


  .menu-toggle {

    width: 40px;

    height: 40px;

  }

}


/* =====================================================
   PREVENT BODY SCROLL WHEN MENU OPEN
===================================================== */

body.mobile-menu-open {

  overflow: hidden;

}

{% endstylesheet %}


