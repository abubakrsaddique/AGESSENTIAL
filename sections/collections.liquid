<section class="collections-page">

  <div class="page-width">

    <h1 class="collections-heading">All Collections</h1>

    <div class="collections-grid">

      {% paginate collections by 50 %}

        {% for collection in collections %}

          <div class="collection-card">

            <a href="{{ collection.url }}">

              {% if collection.featured_image %}
                <img 
                  src="{{ collection.featured_image | image_url: width: 500 }}"
                  alt="{{ collection.title }}">
              {% endif %}

              <h3>{{ collection.title }}</h3>

              {% if collection.description != blank %}
                <p>
                  {{ collection.description | strip_html | truncatewords: 15 }}
                </p>
              {% endif %}

            </a>

          </div>

        {% endfor %}

        {{ paginate | default_pagination }}

      {% endpaginate %}

    </div>

  </div>

</section>


<style>

.collections-page{
  padding:60px 0;
}

.collections-heading{
  text-align:center;
  font-size:42px;
  margin-bottom:40px;
  color:#13205c;
}


.collections-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:25px;
}


.collection-card{
  background:#fff;
  border-radius:15px;
  overflow:hidden;
  box-shadow:0 5px 15px rgba(0,0,0,.1);
}


.collection-card a{
  text-decoration:none;
  color:#000;
}


.collection-card img{
  width:100%;
  height:250px;
  object-fit:cover;
}


.collection-card h3{
  font-size:22px;
  padding:15px;
  margin:0;
}


.collection-card p{
  padding:0 15px 20px;
}


@media(max-width:991px){

.collections-grid{
grid-template-columns:repeat(2,1fr);
}

}


@media(max-width:600px){

.collections-grid{
grid-template-columns:1fr;
}

.collections-heading{
font-size:30px;
}

}

</style>


{% schema %}
{
"name":"Collections Grid",
"settings":[],
"presets":[
{
"name":"Collections Grid"
}
]
}
{% endschema %}