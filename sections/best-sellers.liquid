<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section class="best-seller-section">

<div class="page-width">

<h2 class="best-seller-heading">
{{ section.settings.heading }}
</h2>

<div class="swiper bestSellerSlider">

<div class="swiper-wrapper">

{% assign names = "Teddy Bear|Car|Book|Pencil|Barbie Doll|Water Bottle" | split: "|" %}
{% assign prices = "500 PKR|700 PKR|900 PKR|100 PKR|2500 PKR|1200 PKR" | split: "|" %}


{% for i in (1..6) %}

<div class="swiper-slide">

<div class="best-card">

<a href="#" class="product-image">

<img 
src="{{ 'product-' | append:i | append: '.jpg' | asset_url }}"
alt="{{ names[forloop.index0] }}"
>

</a>


<div class="product-info">

<h3>
{{ names[forloop.index0] }}
</h3>

<div class="price">
{{ prices[forloop.index0] }}
</div>


<a href="#" class="details-btn">
More Details
</a>


</div>

</div>

</div>

{% endfor %}


</div>


<div class="swiper-button-prev"></div>
<div class="swiper-button-next"></div>

<div class="swiper-pagination"></div>


</div>

</div>

</section>



<style>


html,body{
overflow-x:hidden;
}



/* Main Section */

.best-seller-section{

 width: 99.4vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;

padding:30px 0;

background:linear-gradient(
180deg,
#eafcff,
#eafcff
);

overflow:hidden;

}



/* Container */

.best-seller-section .page-width{

max-width:1200px;

margin:0 auto;

padding-left:20px;

padding-right:20px;

}



/* Heading */

.best-seller-heading{

text-align:center;

font-size:42px;

margin-bottom:40px;

color:#13205c;

font-weight:700;

}



/* Slider */

.bestSellerSlider{

width:100%;

background:#d6f3f7;

padding:30px;

border-radius:24px;

overflow:hidden;

}



/* Card */

.best-card{

border:1px solid #4305ef;

border-radius:16px;

overflow:hidden;

text-align:center;

background:white;

height:100%;

}



/* Image */

.product-image{

display:flex;

justify-content:center;

align-items:center;

height:260px;

padding:20px;

}


.product-image img{

max-width:100%;

max-height:220px;

object-fit:contain;

}



/* Info */

.product-info{

padding:20px;

}


.product-info h3{

font-size:20px;

margin:0 0 10px;

color:#111;

}



/* Price */

.price{

font-size:28px;

color:red;

font-weight:700;

margin-bottom:20px;

}



/* Button */

.details-btn{

display:inline-block;

background:#2f8d23;

color:#fff;

padding:12px 30px;

text-decoration:none;

border-radius:8px;

font-weight:600;

}



/* Arrows */

.swiper-button-next,
.swiper-button-prev{

color:#fff;

background:#4f82d8;

width:50px;

height:50px;

border-radius:50%;

}


.swiper-button-next:after,
.swiper-button-prev:after{

font-size:20px;

}



/* Mobile */

@media(max-width:768px){

.best-seller-heading{

font-size:30px;

}


.bestSellerSlider{

padding:15px;

}


.product-image{

height:220px;

}

}


</style>



<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>


<script>

document.addEventListener('DOMContentLoaded',function(){

new Swiper('.bestSellerSlider',{

loop:true,

autoplay:{

delay:3000,

disableOnInteraction:false

},

spaceBetween:25,


navigation:{

nextEl:'.swiper-button-next',

prevEl:'.swiper-button-prev'

},


pagination:{

el:'.swiper-pagination',

clickable:true

},


breakpoints:{

0:{

slidesPerView:1

},

480:{

slidesPerView:2

},

768:{

slidesPerView:3

},

1200:{

slidesPerView:4

}

}


});


});

</script>



{% schema %}
{
"name":"Best Sellers Manual",
"settings":[
{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Best Sellers"
}
],
"presets":[
{
"name":"Best Sellers Manual"
}
]
}
{% endschema %}