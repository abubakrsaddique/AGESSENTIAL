<section class="why-parents-love-section">

  <div class="page-width">

    <div class="why-header">

      <h2>
        Why Parents Love Us ✨
      </h2>

      <p>
        Making every child's playtime safe, fun and magical
      </p>

    </div>


    <div class="why-grid">


      <div class="why-card">

        <div class="why-icon">
          🧸
        </div>

        <h3>
          Safe & Certified Toys
        </h3>

        <p>
          Quality checked toys made for your little ones.
        </p>

      </div>



      <div class="why-card">

        <div class="why-icon">
          🚚
        </div>

        <h3>
          Fast Delivery
        </h3>

        <p>
          Quick and reliable delivery across the country.
        </p>

      </div>




      <div class="why-card">

        <div class="why-icon">
          💳
        </div>

        <h3>
          Secure Payment
        </h3>

        <p>
          Safe and secure checkout experience.
        </p>

      </div>




      <div class="why-card">

        <div class="why-icon">
          🎁
        </div>

        <h3>
          Gift Wrapping
        </h3>

        <p>
          Perfect gifts for birthdays and special moments.
        </p>

      </div>


    </div>


  </div>

</section>



<style>


.why-parents-love-section{
    width: 99.4vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;

    padding:30px 20px;

    background:#EAF8FF;

}



.why-header{

    text-align:center;

    max-width:700px;

    margin:0 auto 45px;

}



.why-header h2{

    font-size:40px;

    line-height:1.2;

    font-weight:700;

    color:#14245C;

    margin:0 0 12px;

}



.why-header p{

    font-size:17px;

    color:#555;

    margin:0;

}




.why-grid{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:25px;

}



.why-card{

    background:#ffffff;

    border-radius:24px;

    padding:35px 25px;

    text-align:center;

    box-shadow:0 8px 25px rgba(20,36,92,0.08);

    transition:all .3s ease;

}



.why-card:hover{

    transform:translateY(-8px);

    box-shadow:0 15px 35px rgba(20,36,92,0.15);

}




.why-icon{

    width:80px;

    height:80px;

    margin:0 auto 20px;

    border-radius:50%;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:40px;

    background:#FFF1F7;

}




.why-card h3{

    font-size:21px;

    line-height:1.3;

    font-weight:700;

    color:#14245C;

    margin:0 0 12px;

}



.why-card p{

    font-size:15px;

    line-height:1.6;

    color:#666;

    margin:0;

}





/* Large Tablet */

@media(max-width:1200px){


    .why-grid{

        grid-template-columns:repeat(2,1fr);

        gap:25px;

    }


}




/* Tablet */

@media(max-width:768px){


    .why-parents-love-section{

        padding:55px 15px;

    }



    .why-header h2{

        font-size:32px;

    }



    .why-header p{

        font-size:15px;

    }



    .why-card{

        padding:30px 20px;

    }


}





/* Mobile */

@media(max-width:480px){


    .why-parents-love-section{

        padding:45px 12px;

    }



    .why-grid{

        grid-template-columns:1fr;

        gap:18px;

    }



    .why-header{

        margin-bottom:30px;

    }



    .why-header h2{

        font-size:28px;

    }



    .why-icon{

        width:70px;

        height:70px;

        font-size:34px;

    }



    .why-card h3{

        font-size:19px;

    }



    .why-card p{

        font-size:14px;

    }


}


</style>



{% schema %}
{
  "name": "Why Parents Love Us",
  "settings": [],
  "presets": [
    {
      "name": "Why Parents Love Us"
    }
  ]
}
{% endschema %}