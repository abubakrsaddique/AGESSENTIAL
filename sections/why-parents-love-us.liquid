<section class="ag-why-love">

  <div class="ag-why-love__container">

    <!-- HEADER -->

    <div class="ag-why-love__header">

      <span class="ag-why-love__eyebrow">
        MADE FOR HAPPY FAMILIES
      </span>

      <h2>
        Why Parents Love Us ✨
      </h2>

      <p>
        Making every child's playtime safe, fun and magical.
      </p>

    </div>


    <!-- BENEFIT CARDS -->

    <div class="ag-why-love__grid">


      <!-- SAFE TOYS -->

      <div class="ag-why-card ag-why-card--pink">

        <div class="ag-why-card__top">

          <div class="ag-why-card__icon">
            🧸
          </div>

        </div>

        <div class="ag-why-card__content">

          <h3>
            Safe & Certified Toys
          </h3>

          <p>
            Quality checked toys made with your little one's safety and happiness in mind.
          </p>

        </div>

        <div class="ag-why-card__line"></div>

      </div>



      <!-- DELIVERY -->

      <div class="ag-why-card ag-why-card--blue">

        <div class="ag-why-card__top">

          <div class="ag-why-card__icon">
            🚚
          </div>

        </div>

        <div class="ag-why-card__content">

          <h3>
            Fast Delivery
          </h3>

          <p>
            Quick and reliable delivery, so your little one's new favorite toy arrives sooner.
          </p>

        </div>

        <div class="ag-why-card__line"></div>

      </div>



      <!-- PAYMENT -->

      <div class="ag-why-card ag-why-card--yellow">

        <div class="ag-why-card__top">

          <div class="ag-why-card__icon">
            💳
          </div>

        </div>

        <div class="ag-why-card__content">

          <h3>
            Secure Payment
          </h3>

          <p>
            A simple and secure checkout experience designed for worry-free shopping.
          </p>

        </div>

        <div class="ag-why-card__line"></div>

      </div>



      <!-- GIFT WRAPPING -->

      <div class="ag-why-card ag-why-card--purple">

        <div class="ag-why-card__top">

          <div class="ag-why-card__icon">
            🎁
          </div>

        </div>

        <div class="ag-why-card__content">

          <h3>
            Gift Wrapping
          </h3>

          <p>
            Beautiful gifts for birthdays, celebrations and every special little moment.
          </p>

        </div>

        <div class="ag-why-card__line"></div>

      </div>


    </div>


    <!-- TRUST MESSAGE -->

    <div class="ag-why-love__trust">

      <span class="ag-why-love__trust-icon">
        ♥
      </span>

      <span>
        Loved by parents. Made for little smiles.
      </span>

    </div>

  </div>

</section>


{% stylesheet %}


/* =====================================================
   MAIN SECTION
===================================================== */

.ag-why-love {

  width: 99.4vw;

  position: relative;

  left: 50%;

  margin-left: -50vw;

  background: #FFF9F1;

  overflow: hidden;

}


.ag-why-love__container {

  width: 100%;

  max-width: 1380px;

  margin: 0 auto;

  padding: 0px 35px 80px;

  box-sizing: border-box;

}


/* =====================================================
   HEADER
===================================================== */

.ag-why-love__header {

  max-width: 720px;

  margin: 0 auto 45px;

  text-align: center;

}


.ag-why-love__eyebrow {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 8px 15px;

  border-radius: 50px;

  background: #ffffff;

  border: 1px solid #eee5d9;

  color: #8b735b;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.6px;

}


.ag-why-love__eyebrow::before {

  content: "";

  width: 7px;

  height: 7px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #ff4c91;

  box-shadow:
    0 0 0 4px rgba(255,76,145,.12);

}


.ag-why-love__header h2 {

  margin: 15px 0 10px;

  color: #222222;

  font-size: clamp(38px, 4vw, 54px);

  line-height: 1.05;

  letter-spacing: -1.8px;

  font-weight: 800;

}


.ag-why-love__header p {

  margin: 0;

  color: #6f6a63;

  font-size: 16px;

  line-height: 1.6;

}


/* =====================================================
   CARD GRID
===================================================== */

.ag-why-love__grid {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 20px;

}


/* =====================================================
   BASE CARD
===================================================== */

.ag-why-card {

  position: relative;

  min-height: 315px;

  padding: 28px 24px;

  border-radius: 28px;

  overflow: hidden;

  text-align: center;

  border: 1px solid rgba(255,255,255,.7);

  box-shadow:
    0 10px 30px rgba(40,35,30,.07);

  transition:
    transform .35s ease,
    box-shadow .35s ease;

}


.ag-why-card:hover {

  transform: translateY(-8px);

  box-shadow:
    0 22px 48px rgba(40,35,30,.14);

}


/* =====================================================
   CARD COLORS
===================================================== */

.ag-why-card--pink {

  background:
    linear-gradient(
      145deg,
      #fff1f7 0%,
      #ffddea 100%
    );

}


.ag-why-card--blue {

  background:
    linear-gradient(
      145deg,
      #eaf8ff 0%,
      #d5efff 100%
    );

}


.ag-why-card--yellow {

  background:
    linear-gradient(
      145deg,
      #fff9df 0%,
      #ffedb2 100%
    );

}


.ag-why-card--purple {

  background:
    linear-gradient(
      145deg,
      #f5efff 0%,
      #e8dcff 100%
    );

}


/* =====================================================
   DECORATIVE BACKGROUND CIRCLE
===================================================== */

.ag-why-card::before {

  content: "";

  position: absolute;

  width: 150px;

  height: 150px;

  top: -65px;

  right: -55px;

  border-radius: 50%;

  background: rgba(255,255,255,.38);

  transition:
    transform .4s ease;

}


.ag-why-card:hover::before {

  transform: scale(1.25);

}


/* =====================================================
   TOP AREA
===================================================== */

.ag-why-card__top {

  position: relative;

  z-index: 2;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 25px;

}


/* =====================================================
   ICON
===================================================== */

.ag-why-card__icon {

  width: 82px;

  height: 82px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 26px;

  background: rgba(255,255,255,.85);

  border: 1px solid rgba(255,255,255,.8);

  box-shadow:
    0 8px 22px rgba(0,0,0,.08);

  font-size: 40px;

  transition:
    transform .35s ease,
    box-shadow .35s ease;

}


.ag-why-card:hover .ag-why-card__icon {

  transform:
    translateY(-5px)
    rotate(-5deg)
    scale(1.06);

  box-shadow:
    0 13px 28px rgba(0,0,0,.11);

}


/* =====================================================
   CONTENT
===================================================== */

.ag-why-card__content {

  position: relative;

  z-index: 2;

}


.ag-why-card__content h3 {

  margin: 0 0 10px;

  color: #172052;

  font-size: 21px;

  line-height: 1.25;

  font-weight: 800;

}


.ag-why-card__content p {

  max-width: 260px;

  margin: 0 auto;

  color: #62697c;

  font-size: 13px;

  line-height: 1.65;

}


/* =====================================================
   COLORFUL BOTTOM LINE
===================================================== */

.ag-why-card__line {

  position: absolute;

  z-index: 3;

  left: 0;

  right: 0;

  bottom: 0;

  height: 5px;

  border-radius: 10px 10px 0 0;

  transform: scaleX(.35);

  transform-origin: center;

  transition:
    transform .35s ease;

}


.ag-why-card:hover .ag-why-card__line {

  transform: scaleX(1);

}


.ag-why-card--pink .ag-why-card__line {

  background: #ff4c91;

}


.ag-why-card--blue .ag-why-card__line {

  background: #1684ff;

}


.ag-why-card--yellow .ag-why-card__line {

  background: #f3b62f;

}


.ag-why-card--purple .ag-why-card__line {

  background: #8b62e8;

}


/* =====================================================
   TRUST MESSAGE
===================================================== */

.ag-why-love__trust {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 9px;

  margin-top: 35px;

  color: #777067;

  font-size: 12px;

  font-weight: 600;

}


.ag-why-love__trust-icon {

  width: 25px;

  height: 25px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #fff0f5;

  color: #ff4c91;

  font-size: 12px;

}


/* =====================================================
   TABLET
===================================================== */

@media screen and (max-width: 1050px) {

  .ag-why-love__grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  .ag-why-love__container {

    padding: 58px 16px 60px;

  }


  .ag-why-love__header {

    margin-bottom: 30px;

  }


  .ag-why-love__header h2 {

    font-size: 34px;

    letter-spacing: -1px;

  }


  .ag-why-love__header p {

    font-size: 14px;

  }


  .ag-why-love__grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 13px;

  }


  .ag-why-card {

    min-height: 275px;

    padding: 21px 15px;

    border-radius: 22px;

  }


  .ag-why-card__top {

    margin-bottom: 20px;

  }


  .ag-why-card__icon {

    width: 64px;

    height: 64px;

    border-radius: 20px;

    font-size: 31px;

  }


  .ag-why-card__content h3 {

    font-size: 16px;

    line-height: 1.3;

  }


  .ag-why-card__content p {

    font-size: 11px;

    line-height: 1.55;

  }


  .ag-why-card__line {

    height: 4px;

  }


  .ag-why-love__trust {

    margin-top: 25px;

    text-align: center;

    font-size: 11px;

  }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media screen and (max-width: 420px) {

  .ag-why-love__container {

    padding-left: 12px;

    padding-right: 12px;

  }


  .ag-why-love__grid {

    gap: 10px;

  }


  .ag-why-card {

    min-height: 260px;

    padding: 18px 13px;

  }


  .ag-why-card__icon {

    width: 56px;

    height: 56px;

    border-radius: 18px;

    font-size: 27px;

  }


  .ag-why-card__content h3 {

    font-size: 15px;

  }


  .ag-why-card__content p {

    font-size: 10.5px;

  }

}

{% endstylesheet %}


