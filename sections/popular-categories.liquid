<section class="popular-categories-section">

  <div class="page-width">

    <h2 class="pc-heading">
      Popular Categories
    </h2>


    <p class="pc-subheading">
      Explore our amazing toy collections
    </p>



    <div class="pc-slider-wrapper">


      <button class="pc-arrow pc-prev">
        ❮
      </button>



      <div class="swiper popularSwiper">

        <div class="swiper-wrapper">



          <!-- Dolls -->

          <div class="swiper-slide">

            <a href="/collections/dolls" class="category-card">

              <img src="{{ 'doll.png' | asset_url }}">

              <h3>
                Dolls
              </h3>

              <p>
                Cute dolls collection
              </p>

            </a>

          </div>




          <!-- Baby Toys -->

          <div class="swiper-slide">

            <a href="/collections/baby-toys" class="category-card">

              <img src="{{ 'baby-toys.png' | asset_url }}">

              <h3>
                Baby Toys
              </h3>

              <p>
                Safe toys for babies
              </p>

            </a>

          </div>




          <!-- Vehicles -->

          <div class="swiper-slide">

            <a href="/collections/vehicles" class="category-card">

              <img src="{{ 'vehicles.png' | asset_url }}">

              <h3>
                Vehicles
              </h3>

              <p>
                Cars and vehicles toys
              </p>

            </a>

          </div>




          <!-- Stationary -->

          <div class="swiper-slide">

            <a href="/collections/stationary" class="category-card">


              <img src="{{ 'flying-toys.png' | asset_url }}">


              <h3>
                Stationary
              </h3>


              <p>
                Creative learning supplies
              </p>


            </a>

          </div>





          <!-- Learning Toys -->

          <div class="swiper-slide">


            <a href="/collections/learning-toys" class="category-card">


              <img src="{{ 'learning.png' | asset_url }}">


              <h3>
                Learning Toys
              </h3>


              <p>
                Learn while playing
              </p>


            </a>


          </div>





          <!-- Art -->

          <div class="swiper-slide">


            <a href="/collections/bags" class="category-card">


              <img src="{{ 'art.png' | asset_url }}">


              <h3>
                Bags
              </h3>


              <p>
                Color outside the Lines
              </p>


            </a>


          </div>





          <!-- Teddy Bear -->

          <div class="swiper-slide">


            <a href="/collections/teddy-bear" class="category-card">


              <img src="{{ 'teddy-bear.jpg' | asset_url }}">


              <h3>
                Teddy Bear
              </h3>


              <p>
                Soft teddy collection
              </p>


            </a>


          </div>




        </div>

      </div>



      <button class="pc-arrow pc-next">
        ❯
      </button>


    </div>


  </div>


</section>






<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">


<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>




<script>


document.addEventListener("DOMContentLoaded",function(){


new Swiper(".popularSwiper",{


slidesPerView:7,

spaceBetween:25,

loop:true,


navigation:{


nextEl:".pc-next",

prevEl:".pc-prev"


},



breakpoints:{


1600:{

slidesPerView:7

},


1200:{

slidesPerView:6

},


992:{

slidesPerView:4

},


768:{

slidesPerView:3

},


480:{

slidesPerView:2

},


0:{

slidesPerView:1.2

}


}


});


});


</script>






{% stylesheet %}


/* ==============================
POPULAR CATEGORIES SECTION
============================== */


.popular-categories-section{
  width: 99.4vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;

padding:50px 0;

background:linear-gradient(
180deg,
#eafcff,
#eafcff
);

overflow:hidden;

}





/* ==============================
HEADING
============================== */


.pc-heading{

text-align:center;

font-size:50px;

font-weight:800;

line-height:1.2;

color:#13205c;

margin:0 0 12px;

}



.pc-subheading{

text-align:center;

font-size:20px;

color:#555;

margin:0 0 50px;

}





/* ==============================
SLIDER
============================== */


.pc-slider-wrapper{

position:relative;
    padding: 0px 25px 0px 25px;

}



.popularSwiper{

overflow:hidden;

padding:15px 10px 40px;

}



.swiper-slide{

height:auto;

}





/* ==============================
CARDS
============================== */


.category-card{

display:block;

height:100%;

min-height:360px;

padding:25px;

border-radius:30px;

text-align:center;

text-decoration:none;

box-shadow:
0 12px 30px rgba(0,0,0,.12);

transition:.35s;

overflow:hidden;

}





.category-card:hover{

transform:translateY(-10px);

box-shadow:
0 20px 40px rgba(0,0,0,.18);

}





/* ==============================
CARD BACKGROUND COLORS
============================== */


.swiper-slide:nth-child(1) .category-card{

background:#FFE4E8;

}


.swiper-slide:nth-child(2) .category-card{

background:#DDF7FF;

}


.swiper-slide:nth-child(3) .category-card{

background:#FFF3C7;

}


.swiper-slide:nth-child(4) .category-card{

background:#E8DFFF;

}


.swiper-slide:nth-child(5) .category-card{

background:#DFFFD8;

}


.swiper-slide:nth-child(6) .category-card{

background:#FFE5C2;

}


.swiper-slide:nth-child(7) .category-card{

background:#FFDDF5;

}





/* ==============================
IMAGE
============================== */


.category-card img{

width:100%;

height:180px;

object-fit:contain;

margin-bottom:20px;

transition:.3s;

}



.category-card:hover img{

transform:scale(1.05);

}





/* ==============================
TEXT
============================== */


.category-card h3{

font-size:26px;

font-weight:800;

color:#1d1d33;

margin:0 0 10px;

}



.category-card p{

font-size:15px;

line-height:1.5;

color:#555;

margin:0;

}





/* ==============================
ARROWS
============================== */


.pc-arrow{

position:absolute;

top:50%;

transform:translateY(-50%);

z-index:10;

width:55px;

height:55px;

border-radius:50%;

border:none;

background:white;

color:#13205c;

font-size:25px;

cursor:pointer;

display:flex;

align-items:center;

justify-content:center;

box-shadow:

0 8px 25px rgba(0,0,0,.15);

transition:.3s;

}



.pc-arrow:hover{

transform:translateY(-50%) scale(1.1);

background:#13205c;

color:white;

}





.pc-prev{

left:0px;

}



.pc-next{

right:0px;

}





/* ==============================
TABLET
============================== */


@media(max-width:992px){


.pc-heading{

font-size:42px;

}



.category-card{

min-height:330px;

}



.category-card img{

height:160px;

}



.pc-arrow{

width:45px;

height:45px;

font-size:20px;

}



}





/* ==============================
MOBILE
============================== */


@media(max-width:768px){


.popular-categories-section{

padding:50px 0;

}



.pc-heading{

font-size:34px;

}



.pc-subheading{

font-size:16px;

margin-bottom:30px;

}



.popularSwiper{

padding:10px 5px 30px;

}



.category-card{

min-height:300px;

padding:20px;

}



.category-card img{

height:140px;

}



.category-card h3{

font-size:22px;

}



.pc-prev{

left:5px;

}



.pc-next{

right:5px;

}



.pc-arrow{

width:38px;

height:38px;

font-size:18px;

}



}





/* ==============================
SMALL MOBILE
============================== */


@media(max-width:480px){


.category-card{

border-radius:22px;

}



.category-card img{

height:120px;

}



.category-card h3{

font-size:20px;

}



.category-card p{

font-size:14px;

}



}



{% endstylesheet %}