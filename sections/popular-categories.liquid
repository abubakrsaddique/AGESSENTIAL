{% javascript %}

document.addEventListener("DOMContentLoaded", function() {

  const section = document.querySelector(".ag-popular-categories");

  if (!section) return;

  const track = section.querySelector(".ag-pc-track");

  const next = section.querySelector(".ag-pc-next");

  const prev = section.querySelector(".ag-pc-prev");


  function moveSlider(direction) {

    const card = track.querySelector(".ag-pc-card");

    if (!card) return;

    const gap = 22;

    const amount = card.offsetWidth + gap;

    track.scrollBy({

      left: amount * direction,

      behavior: "smooth"

    });

  }


  next.addEventListener("click", function() {

    moveSlider(1);

  });


  prev.addEventListener("click", function() {

    moveSlider(-1);

  });

});

{% endjavascript %}


{% stylesheet %}


/* =========================================
   MAIN SECTION
========================================= */

.ag-popular-categories {

  width: 99.4vw;

  position: relative;

  left: 50%;

  margin-left: -50vw;

background: #FFF9F1

  overflow: hidden;

}


.ag-pc-container {

  max-width: 1380px;

  margin: auto;

  padding: 0px 35px 80px;

}


/* =========================================
   HEADER
========================================= */

.ag-pc-header {

  text-align: center;

  max-width: 720px;

  margin: 0 auto 42px;

}


.ag-pc-eyebrow {

  display: inline-flex;

  align-items: center;

  padding: 8px 15px;

  border-radius: 50px;

  background: #ffffff;

  color: #1684ff;

  border: 1px solid rgba(22,132,255,.12);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.7px;

}


.ag-pc-eyebrow:before {

  content: "";

  width: 7px;

  height: 7px;

  margin-right: 8px;

  border-radius: 50%;

  background: #ff4c91;

  box-shadow: 0 0 0 4px rgba(255,76,145,.12);

}


.ag-pc-header h2 {

  margin: 15px 0 10px;

  color: #13205c;

  font-size: clamp(38px, 4vw, 54px);

  line-height: 1.05;

  letter-spacing: -1.8px;

  font-weight: 800;

}


.ag-pc-header p {

  margin: 0 auto;

  color: #52607c;

  font-size: 16px;

  line-height: 1.6;

}


/* =========================================
   SLIDER
========================================= */

.ag-pc-slider {

  position: relative;

}


.ag-pc-track {

  display: flex;

  gap: 22px;

  overflow-x: auto;

  padding: 8px 4px 28px;

  scroll-behavior: smooth;

  scrollbar-width: none;

  scroll-snap-type: x mandatory;

}


.ag-pc-track::-webkit-scrollbar {

  display: none;

}


/* =========================================
   CARD
========================================= */

.ag-pc-card {

  flex: 0 0 calc((100% - 66px) / 4);

  min-width: 0;

  text-decoration: none;

  scroll-snap-align: start;

}


.ag-pc-card-image {

  position: relative;

  height: 410px;

  overflow: hidden;

  border-radius: 30px;

  background: #ffffff;

  box-shadow:

    0 12px 30px rgba(19,32,92,.09);

  transition:

    transform .35s ease,

    box-shadow .35s ease;

}


.ag-pc-card:hover .ag-pc-card-image {

  transform: translateY(-7px);

  box-shadow:

    0 22px 45px rgba(19,32,92,.16);

}


/* =========================================
   IMAGE
========================================= */

.ag-pc-card-image img {

  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  transition:

    transform .65s cubic-bezier(.2,.7,.2,1);

}


.ag-pc-card:hover
.ag-pc-card-image img {

  transform: scale(1.07);

}


/* =========================================
   GRADIENT
========================================= */

.ag-pc-gradient {

  position: absolute;

  inset: 0;

  background:

    linear-gradient(

      180deg,

      rgba(0,0,0,0) 35%,

      rgba(0,0,0,.05) 50%,

      rgba(0,0,0,.68) 100%

    );

}


/* =========================================
   NUMBER
========================================= */

.ag-pc-index {

  position: absolute;

  top: 15px;

  left: 15px;

  width: 42px;

  height: 30px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50px;

  background: rgba(255,255,255,.94);

  color: #13205c;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1px;

}


/* =========================================
   TOP ARROW
========================================= */

.ag-pc-arrow-icon {

  position: absolute;

  top: 15px;

  right: 15px;

  width: 43px;

  height: 43px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.95);

  color: #13205c;

  font-size: 20px;

  transition: .3s ease;

}


.ag-pc-card:hover .ag-pc-arrow-icon {

  background: #13205c;

  color: #fff;

  transform: rotate(45deg);

}


/* =========================================
   CARD CONTENT
========================================= */

.ag-pc-card-content {

  position: absolute;

  left: 15px;

  right: 15px;

  bottom: 15px;

  padding: 18px;

  border-radius: 21px;

  background: rgba(255,255,255,.96);

  backdrop-filter: blur(12px);

}


.ag-pc-card-content h3 {

  margin: 0;

  color: #18204d;

  font-size: 23px;

  line-height: 1.15;

  font-weight: 800;

}


.ag-pc-card-content p {

  margin: 5px 0 13px;

  color: #68728a;

  font-size: 12px;

  line-height: 1.4;

}


.ag-pc-explore {

  display: flex;

  align-items: center;

  justify-content: space-between;

  color: #1684ff;

  font-size: 11px;

  font-weight: 800;

}


.ag-pc-explore b {

  font-size: 17px;

  transition: transform .25s ease;

}


.ag-pc-card:hover
.ag-pc-explore b {

  transform: translateX(5px);

}


/* =========================================
   NAVIGATION
========================================= */

.ag-pc-arrow {

  position: absolute;

  top: 50%;

  z-index: 5;

  width: 52px;

  height: 52px;

  display: flex;

  align-items: center;

  justify-content: center;

  border: 0;

  border-radius: 50%;

  background: #ffffff;

  color: #13205c;

  box-shadow:

    0 8px 25px rgba(0,0,0,.14);

  cursor: pointer;

  transform: translateY(-50%);

  transition: .25s ease;

}


.ag-pc-arrow:hover {

  background: #13205c;

  color: #ffffff;

  transform: translateY(-50%) scale(1.08);

}


.ag-pc-arrow svg {

  width: 20px;

  height: 20px;

}


.ag-pc-arrow path {

  fill: none;

  stroke: currentColor;

  stroke-width: 2;

  stroke-linecap: round;

  stroke-linejoin: round;

}


.ag-pc-prev {

  left: -20px;

}


.ag-pc-next {

  right: -20px;

}


/* =========================================
   MOBILE HINT
========================================= */

.ag-pc-mobile-hint {

  display: none;

}


/* =========================================
   TABLET
========================================= */

@media(max-width:1100px) {

  .ag-pc-card {

    flex-basis: calc((100% - 44px) / 3);

  }

}


@media(max-width:800px) {

  .ag-pc-card {

    flex-basis: calc((100% - 22px) / 2);

  }

  .ag-pc-arrow {

    width: 44px;

    height: 44px;

  }

}


/* =========================================
   MOBILE
========================================= */

@media(max-width:749px) {

  .ag-pc-container {

    padding: 55px 15px 60px;

  }


  .ag-pc-header {

    margin-bottom: 28px;

  }


  .ag-pc-header h2 {

    font-size: 34px;

    letter-spacing: -1px;

  }


  .ag-pc-header p {

    font-size: 14px;

  }


  .ag-pc-track {

    gap: 15px;

    margin-right: -15px;

    padding-right: 15px;

  }


  .ag-pc-card {

    flex: 0 0 80%;

  }


  .ag-pc-card-image {

    height: 360px;

    border-radius: 25px;

  }


  .ag-pc-card-content {

    left: 12px;

    right: 12px;

    bottom: 12px;

    padding: 15px;

    border-radius: 18px;

  }


  .ag-pc-card-content h3 {

    font-size: 20px;

  }


  .ag-pc-card-content p {

    font-size: 11px;

    margin-bottom: 10px;

  }


  .ag-pc-arrow {

    display: none;

  }


  .ag-pc-mobile-hint {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    color: #7d879c;

    font-size: 10px;

  }


  .ag-pc-mobile-hint span {

    width: 20px;

    height: 1px;

    background: #cbd3df;

  }

}


@media(max-width:420px) {

  .ag-pc-card {

    flex-basis: 86%;

  }

}

{% endstylesheet %}


