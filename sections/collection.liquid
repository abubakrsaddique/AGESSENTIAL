{% comment %}
  Modern Collection Grid - 30 Products Per Page
{% endcomment %}

<section class="collection-page">

  <div class="collection-header">
    <h1>{{ collection.title }}</h1>

    {% if collection.description != blank %}
      <div class="collection-description">
        {{ collection.description }}
      </div>
    {% endif %}

    <p class="collection-count">
      {{ collection.products_count }} Products
    </p>
  </div>

  {% paginate collection.products by 30 %}

    <div class="collection-grid">

      {% for product in collection.products %}

        <article class="product-card">

          <a href="{{ product.url }}" class="product-card__image">

            {% if product.compare_at_price > product.price %}
              <span class="badge">Sale</span>
            {% endif %}

            {% if product.featured_image %}
              {% render 'image',
                image: product.featured_image,
                width: 700,
                height: 700,
                crop: 'center',
                class: 'product-image'
              %}
            {% endif %}

          </a>

          <div class="product-card__content">

            <h3>
              <a href="{{ product.url }}">
                {{ product.title | escape }}
              </a>
            </h3>

            <div class="price">

              {% if product.compare_at_price > product.price %}

                <span class="price-sale">
                  {{ product.price | money }}
                </span>

                <span class="price-compare">
                  {{ product.compare_at_price | money }}
                </span>

              {% else %}

                <span class="price-regular">
                  {{ product.price | money }}
                </span>

              {% endif %}

            </div>

            {% if product.available %}
              <a href="{{ product.url }}" class="btn">
                View Product
              </a>
            {% else %}
              <span class="sold-out">
                Sold Out
              </span>
            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

    {% if paginate.pages > 1 %}

      <nav class="pagination">

        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination-btn">
            ← Previous
          </a>
        {% endif %}

        <div class="pagination-pages">

          {% for part in paginate.parts %}

            {% if part.is_link %}

              <a href="{{ part.url }}" class="page-number">
                {{ part.title }}
              </a>

            {% else %}

              {% if part.title == paginate.current_page %}

                <span class="page-number active">
                  {{ part.title }}
                </span>

              {% else %}

                <span class="page-number dots">
                  {{ part.title }}
                </span>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination-btn">
            Next →
          </a>
        {% endif %}

      </nav>

    {% endif %}

  {% endpaginate %}

</section>

{% stylesheet %}

.collection-page{
    max-width:1400px;
    margin:auto;
    padding:50px 20px;
}

.collection-header{
    text-align:center;
    margin-bottom:40px;
}

.collection-header h1{
    font-size:42px;
    margin-bottom:10px;
}

.collection-description{
    color:#666;
    max-width:700px;
    margin:0 auto 10px;
}

.collection-count{
    color:#999;
}

/* GRID */

.collection-grid{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:24px;
}

/* CARD */

.product-card{
    background:#fff;
    border:1px solid #eee;
    border-radius:14px;
    overflow:hidden;
    transition:.35s ease;
}

.product-card:hover{
    transform:translateY(-6px);
    box-shadow:0 15px 35px rgba(0,0,0,.08);
}

.product-card__image{
    display:block;
    position:relative;
    aspect-ratio:1;
    overflow:hidden;
}

.product-image{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.4s;
}

.product-card:hover .product-image{
    transform:scale(1.08);
}

/* Badge */

.badge{
    position:absolute;
    top:12px;
    left:12px;
    background:#ff3b30;
    color:#fff;
    padding:6px 12px;
    border-radius:20px;
    font-size:12px;
    font-weight:600;
    z-index:5;
}

/* Content */

.product-card__content{
    padding:18px;
}

.product-card h3{
    font-size:16px;
    margin-bottom:12px;
    line-height:1.4;
}

.product-card h3 a{
    color:#111;
    text-decoration:none;
}

.price{
    display:flex;
    gap:10px;
    align-items:center;
    margin-bottom:18px;
}

.price-sale{
    color:#e60023;
    font-weight:700;
}

.price-compare{
    text-decoration:line-through;
    color:#999;
}

.price-regular{
    font-weight:700;
}

/* Button */

.btn{
    display:block;
    width:100%;
    padding:12px;
    text-align:center;
    text-decoration:none;
    background:#111;
    color:#fff;
    border-radius:8px;
    transition:.3s;
}

.btn:hover{
    background:#333;
}

.sold-out{
    display:block;
    text-align:center;
    padding:12px;
    background:#efefef;
    color:#777;
    border-radius:8px;
}

/* Pagination */

.pagination{
    margin-top:60px;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:14px;
    flex-wrap:wrap;
}

.pagination-pages{
    display:flex;
    gap:8px;
}

.page-number,
.pagination-btn{
    min-width:44px;
    height:44px;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:0 14px;
    border:1px solid #ddd;
    border-radius:8px;
    text-decoration:none;
    color:#111;
    transition:.3s;
}

.page-number:hover,
.pagination-btn:hover{
    background:#111;
    color:#fff;
}

.page-number.active{
    background:#111;
    color:#fff;
    border-color:#111;
}

.dots{
    border:none;
}

/* Responsive */

@media(max-width:1200px){

.collection-grid{
    grid-template-columns:repeat(4,1fr);
}

}

@media(max-width:992px){

.collection-grid{
    grid-template-columns:repeat(3,1fr);
}

}

@media(max-width:768px){

.collection-page{
    padding:30px 15px;
}

.collection-header h1{
    font-size:32px;
}

.collection-grid{
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

}

@media(max-width:480px){

.collection-grid{
    grid-template-columns:1fr;
}

.product-card__content{
    padding:14px;
}

}

{% endstylesheet %}

{% schema %}
{
  "name": "Modern Collection",
  "settings": []
}
{% endschema %}