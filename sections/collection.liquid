<section class="luxury-products-page">

  <div class="luxury-products-container">

    <a href="/collections" class="luxury-products-back">
      ← <span>All Collections</span>
    </a>

    <header class="luxury-products-header">

      <div class="luxury-products-badge">
        <span></span>
        EXPLORE COLLECTION
        <span></span>
      </div>

      <h1>
        {{ collection.title }}
      </h1>

      {% if collection.description != blank %}
        <div class="luxury-products-description">
          {{ collection.description }}
        </div>
      {% endif %}

      <div class="luxury-products-divider">
        <i></i>
        <span>✦</span>
        <i></i>
      </div>

    </header>


    {% paginate collection.products by 30 %}

      {% if collection.products_count > 0 %}

        <div class="luxury-products-grid">

          {% for product in collection.products %}

            {% assign current_variant = product.selected_or_first_available_variant %}

            <article class="luxury-product-card">

              <a
                href="{{ product.url }}"
                class="luxury-product-image-link"
              >

                <div class="luxury-product-image">

                  {% if product.compare_at_price > product.price %}
                    <span class="luxury-sale-badge">
                      SALE
                    </span>
                  {% endif %}

                  {% if product.featured_image %}

                    <img
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      srcset="
                        {{ product.featured_image | image_url: width: 400 }} 400w,
                        {{ product.featured_image | image_url: width: 600 }} 600w,
                        {{ product.featured_image | image_url: width: 800 }} 800w
                      "
                      sizes="
                        (max-width:600px) 92vw,
                        (max-width:850px) 45vw,
                        (max-width:1100px) 30vw,
                        23vw
                      "
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                    >

                  {% else %}

                    <div class="luxury-product-placeholder">
                      ♡
                    </div>

                  {% endif %}

                  <div class="luxury-product-view">
                    VIEW PRODUCT →
                  </div>

                </div>

              </a>


              <div class="luxury-product-info">

                <h2>
                  <a href="{{ product.url }}">
                    {{ product.title | escape }}
                  </a>
                </h2>

                <div class="luxury-product-meta">

                  <div class="luxury-product-price">

                    {% if product.compare_at_price > product.price %}

                      <span class="luxury-sale-price">
                        {{ product.price | money }}
                      </span>

                      <span class="luxury-compare-price">
                        {{ product.compare_at_price | money }}
                      </span>

                    {% else %}

                      {{ product.price | money }}

                    {% endif %}

                  </div>

                  {% if current_variant.available %}

                    <span class="luxury-stock">
                      <i></i>
                      In Stock
                    </span>

                  {% endif %}

                </div>


                <div class="luxury-product-actions">

                  <a
                    href="{{ product.url }}"
                    class="luxury-details-btn"
                  >
                    Explore Product ↗
                  </a>


                  <form
                    method="post"
                    action="{{ routes.cart_add_url }}"
                    class="luxury-cart-form"
                  >

                    <input
                      type="hidden"
                      name="id"
                      value="{{ current_variant.id }}"
                    >

                    <input
                      type="hidden"
                      name="quantity"
                      value="1"
                    >

                    <button
                      type="submit"
                      class="luxury-cart-btn"
                      {% unless current_variant.available %}
                        disabled
                      {% endunless %}
                    >

                      {% if current_variant.available %}
                        + Add To Cart
                      {% else %}
                        Sold Out
                      {% endif %}

                    </button>

                  </form>

                </div>

              </div>

            </article>

          {% endfor %}

        </div>


        {% if paginate.pages > 1 %}

          <nav class="luxury-product-pagination">

            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">
                ← Previous
              </a>
            {% endif %}

            {% for part in paginate.parts %}

              {% if part.is_link %}

                <a href="{{ part.url }}">
                  {{ part.title }}
                </a>

              {% elsif part.title == paginate.current_page %}

                <span class="active">
                  {{ part.title }}
                </span>

              {% else %}

                <span>
                  {{ part.title }}
                </span>

              {% endif %}

            {% endfor %}

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">
                Next →
              </a>
            {% endif %}

          </nav>

        {% endif %}


      {% else %}

        <div class="luxury-products-empty">
          <div>♡</div>

          <h2>
            No Products Found
          </h2>

          <p>
            There are currently no products in this collection.
          </p>

          <a href="/collections">
            Back To Collections
          </a>
        </div>

      {% endif %}

    {% endpaginate %}

  </div>

</section>


<style>

.luxury-products-page{
  width:100vw;
  position:relative;
  left:50%;
  margin-left:-50vw;
  padding:50px 0 100px;
  background:
    radial-gradient(circle at 5% 5%,rgba(205,164,116,.13),transparent 28%),
    linear-gradient(135deg,#fcfaf7,#f7f2eb,#fbf9f6);
  color:#173b5f;
}

.luxury-products-container{
  max-width:1380px;
  margin:auto;
  padding:0 35px;
}

.luxury-products-back{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:12px 18px;
  border:1px solid #ded5ca;
  border-radius:40px;
  color:#173b5f;
  background:#fff;
  text-decoration:none;
  font-size:12px;
  font-weight:700;
  margin-bottom:45px;
  transition:.3s;
}

.luxury-products-back:hover{
  background:#173b5f;
  color:#fff;
}

.luxury-products-header{
  text-align:center;
  max-width:780px;
  margin:0 auto 60px;
}

.luxury-products-badge{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:12px;
  margin-bottom:15px;
  color:#ad8157;
  font-size:9px;
  font-weight:800;
  letter-spacing:3px;
}

.luxury-products-badge span{
  width:24px;
  height:1px;
  background:#cba47d;
}

.luxury-products-header h1{
  margin:0;
  color:#173b5f;
  font-family:Georgia,"Times New Roman",serif;
  font-size:clamp(42px,5.5vw,70px);
  line-height:1;
  font-weight:500;
}

.luxury-products-description{
  max-width:600px;
  margin:20px auto;
  color:#817a72;
  font-size:14px;
  line-height:1.8;
}

.luxury-products-description p{
  margin:0;
}

.luxury-products-divider{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:12px;
}

.luxury-products-divider i{
  width:42px;
  height:1px;
  background:#d4b28f;
}

.luxury-products-divider span{
  color:#b98555;
}

.luxury-products-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:25px;
}

.luxury-product-card{
  overflow:hidden;
  background:#fff;
  border:1px solid #e6ded4;
  border-radius:20px;
  box-shadow:0 8px 30px rgba(49,37,24,.055);
  transition:.45s ease;
}

.luxury-product-card:hover{
  transform:translateY(-8px);
  box-shadow:0 22px 50px rgba(49,37,24,.13);
}

.luxury-product-image-link{
  display:block;
}

.luxury-product-image{
  position:relative;
  height:315px;
  overflow:hidden;
  background:linear-gradient(145deg,#faf7f2,#f1ebe2);
}

.luxury-product-image img{
  width:100%;
  height:100%;
  object-fit:contain;
  display:block;
  transition:.7s ease;
}

.luxury-product-card:hover img{
  transform:scale(1.065);
}

.luxury-product-placeholder{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#b98555;
  font-size:40px;
}

.luxury-sale-badge{
  position:absolute;
  top:14px;
  left:14px;
  z-index:5;
  padding:7px 12px;
  border-radius:30px;
  background:#a9683d;
  color:#fff;
  font-size:9px;
  font-weight:800;
  letter-spacing:1px;
}

.luxury-product-view{
  position:absolute;
  left:50%;
  bottom:17px;
  transform:translate(-50%,15px);
  padding:11px 17px;
  border-radius:50px;
  background:rgba(255,255,255,.95);
  color:#173b5f;
  font-size:8px;
  font-weight:800;
  letter-spacing:1.5px;
  opacity:0;
  transition:.4s;
  white-space:nowrap;
}

.luxury-product-card:hover .luxury-product-view{
  opacity:1;
  transform:translate(-50%,0);
}

.luxury-product-info{
  padding:20px;
}

.luxury-product-info h2{
  min-height:46px;
  margin:0 0 12px;
  font-size:17px;
  line-height:1.4;
}

.luxury-product-info h2 a{
  color:#202b36;
  text-decoration:none;
}

.luxury-product-meta{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
  margin-bottom:17px;
}

.luxury-product-price{
  color:#a9683d;
  font-size:19px;
  font-weight:800;
}

.luxury-sale-price{
  color:#a9683d;
}

.luxury-compare-price{
  margin-left:5px;
  color:#aaa;
  font-size:11px;
  text-decoration:line-through;
}

.luxury-stock{
  display:flex;
  align-items:center;
  gap:5px;
  color:#719073;
  font-size:8px;
  font-weight:800;
  text-transform:uppercase;
}

.luxury-stock i{
  width:6px;
  height:6px;
  border-radius:50%;
  background:#7baa7b;
}

.luxury-product-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.luxury-details-btn,
.luxury-cart-btn{
  min-height:45px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:9px;
  font-size:9px;
  font-weight:800;
  text-decoration:none;
  transition:.3s;
}

.luxury-details-btn{
  background:#173b5f;
  color:#fff;
}

.luxury-details-btn:hover{
  background:#0e2d49;
  color:#fff;
}

.luxury-cart-form{
  margin:0;
}

.luxury-cart-btn{
  width:100%;
  border:1px solid #d9c4af;
  background:#fff;
  color:#9a6946;
  cursor:pointer;
}

.luxury-cart-btn:hover{
  background:#f8efe6;
}

.luxury-cart-btn:disabled{
  background:#eee;
  color:#999;
  cursor:not-allowed;
}

.luxury-product-pagination{
  display:flex;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  gap:8px;
  margin-top:55px;
}

.luxury-product-pagination a,
.luxury-product-pagination span{
  min-width:43px;
  height:43px;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0 13px;
  border:1px solid #ddd2c5;
  border-radius:9px;
  background:#fff;
  color:#173b5f;
  text-decoration:none;
  font-size:11px;
}

.luxury-product-pagination .active{
  background:#173b5f;
  color:#fff;
}

.luxury-products-empty{
  max-width:600px;
  margin:auto;
  padding:60px 25px;
  text-align:center;
  background:#fff;
  border:1px solid #e6ded4;
  border-radius:20px;
}

.luxury-products-empty div{
  font-size:45px;
  color:#b98555;
}

.luxury-products-empty h2{
  font-family:Georgia,serif;
  font-weight:500;
  color:#173b5f;
}

.luxury-products-empty p{
  color:#817a72;
}

.luxury-products-empty a{
  display:inline-flex;
  padding:13px 22px;
  border-radius:9px;
  background:#173b5f;
  color:#fff;
  text-decoration:none;
}

@media(max-width:1100px){
  .luxury-products-grid{
    grid-template-columns:repeat(3,1fr);
  }
}

@media(max-width:850px){
  .luxury-products-container{
    padding:0 25px;
  }

  .luxury-products-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:600px){
  .luxury-products-page{
    padding:30px 0 60px;
  }

  .luxury-products-container{
    padding:0 14px;
  }

  .luxury-products-grid{
    grid-template-columns:1fr;
    gap:18px;
  }

  .luxury-product-image{
    height:285px;
  }

  .luxury-product-actions{
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:380px){
  .luxury-product-actions{
    grid-template-columns:1fr;
  }
}

</style>


{% schema %}
{
  "name": "Modern Collection",
  "settings": []
}
{% endschema %}